      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">ba43c426-c623-41ed-a5f1-029e25d80f36</Single>
        <Single Name="ParentGuid" Type="System.Guid">85da821b-f6f8-4de1-a2e9-cef73602c539</Single>
        <Single Name="Name" Type="string">PLC_PRG</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639217203829406702</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(*
	The original warehouse sensor is normally true while its beam is clear.
	A product is present when the pallet interrupts that beam.
*)
FIO.xProductAtLoad := NOT FIO.xLoadBeamClear;

// Convert physical panel inputs into safe plant-level commands
fbOperatorControl(
    xAutoModeSelected := FIO.xAutoModeSelected,
    xEmergencyStopHealthy := FIO.xEmergencyStopHealthy,
	xFactoryIORunning := FIO.xFactoryIORunning,
    xPlantFaulted := FIO.xPlantFaulted,
	xPlantRunning := FIO.xPlantRunning,
    xResetPB := FIO.xResetPB,
    xStartPB := FIO.xStartPB,
    xStopCircuitHealthy := FIO.xStopCircuitHealthy
);

// Publish operator-control commands and diagnostics
FIO.xAutoRun := fbOperatorControl.xAutoRun;
FIO.xEmergencyActive := fbOperatorControl.xEmergencyActive;
FIO.xPlantEnable := fbOperatorControl.xEnable;
FIO.xPlantReset := fbOperatorControl.xReset;
FIO.xResetLightCmd := fbOperatorControl.xResetLightCmd;
FIO.xResetRequired := fbOperatorControl.xResetRequired;
FIO.xStartLightCmd := fbOperatorControl.xStartLightCmd;
FIO.xStopLightCmd := fbOperatorControl.xStopLightCmd;

(*
	Factory I/O starts the numerical crane at its known rest position.
	Position 55 is the commanded rest position; stopped movement and
	centred forks are used as the available home confirmation.
*)
FIO.xCraneAtHome :=
    (FIO.wTargetPositionCmd = 55)
    AND FIO.xForkAtMiddle
    AND NOT FIO.xMovingX
    AND NOT FIO.xMovingZ;

(*
	The v1 system permits only one product in material handling.
	The transfer path is available when storage is idle and its
	loading position does not already contain a product.
*)
FIO.xTransferPathClear :=
    fbStorage.xReady
    AND NOT FIO.xProductAtLoad;

(*
	The coordinator reads module status from the previous PLC scan
	and generates this scan's transaction commands
*)
fbPlantCoordinator(
    xAutoRun := FIO.xAutoRun,
	xEmergencyActive := FIO.xEmergencyActive,
    xEnable := FIO.xPlantEnable,
    xReset := FIO.xPlantReset,

    xContainerAtFill := FIO.xContainerAtFill,
    xTransferPathClear := FIO.xTransferPathClear,

    xRackCommitAck := fbRackManager.xCommitAck,
    xRackFaulted := fbRackManager.xFaulted,
    xRackFull := fbRackManager.xRackFull,
    xRackReservationValid := fbRackManager.xReservationValid,
    xRackReserveAck := fbRackManager.xReserveAck,

    xStorageDepositComplete := fbStorage.xDepositComplete,
    xStorageFaulted := fbStorage.xFaulted,
    xStorageReady := fbStorage.xReady,
    xStorageStoreComplete := fbStorage.xStoreComplete,

    xTankBatchReady := fbTank.xBatchReady,
    xTankDischargeComplete := fbTank.xDischargeComplete,
    xTankFaulted := fbTank.xFaulted,
    xTankReady := fbTank.xReady
);

// Rack inventory and reservation transactions
fbRackManager(
    xCommitRequest := fbPlantCoordinator.xRackCommitRequest,
    xEnable := fbPlantCoordinator.xModuleEnable,
	 xReservationMayBeOccupied :=
        fbPlantCoordinator.xReservationMayBeOccupied,
    xReserveRequest := fbPlantCoordinator.xRackReserveRequest,
    xReset := fbPlantCoordinator.xModuleReset
);

// Convert the Factory I/O 0–10 V level signal into 0–100%
FIO.rTankLevelPct := FIO.rTankLevelV * 10.0;

// Tank production module
fbTank(
    xEnable := fbPlantCoordinator.xModuleEnable,
    xDischargePermit := fbPlantCoordinator.xTankDischargePermit,
    xReset := fbPlantCoordinator.xModuleReset,
    xStartBatchReq := fbPlantCoordinator.xTankStartBatchReq,

    rLevelPct := FIO.rTankLevelPct,
    xLevelHighHigh := FIO.xTankLevelHighHigh,

    rEmptySetpointPct := 5.0,
    rFillSetpointPct := 80.0,
    tDischargeTimeout := T#2M,
    tFillTimeout := T#2M
);

// Automated storage module
fbStorage(
    xEnable := fbPlantCoordinator.xModuleEnable,
    xReset := fbPlantCoordinator.xModuleReset,
    xStoreRequest := fbPlantCoordinator.xStorageStoreRequest,

    xCraneAtHome := FIO.xCraneAtHome,
    xForkAtLeft := FIO.xForkAtLeft,
    xForkAtMiddle := FIO.xForkAtMiddle,
    xForkAtRight := FIO.xForkAtRight,
    xMovingX := FIO.xMovingX,
    xMovingZ := FIO.xMovingZ,
    xProductAtLoad := FIO.xProductAtLoad,

    wHomePosition := 55,
    xReservationValid := fbRackManager.xReservationValid,
    wReservedPosition := fbRackManager.wReservedPosition,

    tLiftTime := T#1500MS,
    tLowerTime := T#1500MS,
    tStepTimeout := T#2M
);

// Publish physical actuator commands through the external I/O boundary
FIO.xDischargeValveCmd := fbTank.xDischargeValveCmd;
FIO.xFillValveCmd := fbTank.xFillValveCmd;

// Convert the tank's Boolean valve commands into Factory I/O 0–10 V signals
IF fbTank.xDischargeValveCmd THEN
    FIO.rDischargeValveCmdV := 10.0;
ELSE
    FIO.rDischargeValveCmdV := 0.0;
END_IF;

IF fbTank.xFillValveCmd THEN
    FIO.rFillValveCmdV := 10.0;
ELSE
    FIO.rFillValveCmdV := 0.0;
END_IF;

// Request one empty container when the batch is ready for packaging
FIO.xContainerEmitterCmd := fbPlantCoordinator.xWaitingForContainer;

(*
    The transfer route has two valid movement requests:
    1. Bring an empty container to the filling position.
    2. Transfer the filled product towards storage.

    All four roller sections follow the same logical command.
	The loop distributes that command across the repeated equipment.
*)
xTransferConveyorCmd :=
    fbPlantCoordinator.xWaitingForContainer
    OR fbStorage.xEntryConveyorCmd;

FIO.xEntryConveyorCmd := xTransferConveyorCmd;

FOR iRollerConveyorIndex := 0 TO 3 DO
    FIO.axRollerConveyorCmd[iRollerConveyorIndex] :=
        xTransferConveyorCmd;
END_FOR;
FIO.xForksLeftCmd := fbStorage.xForksLeftCmd;
FIO.xForksRightCmd := fbStorage.xForksRightCmd;
FIO.xLiftCmd := fbStorage.xLiftCmd;
FIO.xLoadConveyorCmd := fbStorage.xLoadConveyorCmd;
FIO.wTargetPositionCmd := fbStorage.wTargetPositionCmd;

(*
    Stack-light priority:
    Red    = emergency, plant fault or interrupted recovery.
    Yellow = stopped, reset required or rack capacity unavailable.
    Green  = automatic production running normally.

    The conditions are mutually exclusive so only one colour
    is illuminated at a time.
*)
xStackRedCmd :=
    fbOperatorControl.xEmergencyActive
    OR fbPlantCoordinator.xFaulted
    OR fbPlantCoordinator.xRecoveryRequired;

xStackYellowCmd :=
    NOT xStackRedCmd
    AND (
        fbOperatorControl.xResetRequired
        OR fbRackManager.xRackFull
        OR NOT fbPlantCoordinator.xRunning
    );

xStackGreenCmd :=
    fbPlantCoordinator.xRunning
    AND NOT xStackRedCmd
    AND NOT xStackYellowCmd;

FOR iStackLightIndex := 0 TO 3 DO
    FIO.axStackGreenCmd[iStackLightIndex] := xStackGreenCmd;
    FIO.axStackRedCmd[iStackLightIndex] := xStackRedCmd;
    FIO.axStackYellowCmd[iStackLightIndex] := xStackYellowCmd;
END_FOR;

(*
	Final external-output interlock for the Factory I/O simulation.
	Numerical target zero stops the crane at its current position.
*)
IF fbOperatorControl.xEmergencyActive
    OR fbOperatorControl.xResetRequired
    OR fbPlantCoordinator.xFaulted
    OR fbPlantCoordinator.xRecoveryRequired
THEN
    FIO.rDischargeValveCmdV := 0.0;
    FIO.rFillValveCmdV := 0.0;
    FIO.wTargetPositionCmd := 0;

    FIO.xContainerEmitterCmd := FALSE;
    FIO.xDischargeValveCmd := FALSE;
    FIO.xEntryConveyorCmd := FALSE;
    FIO.xFillValveCmd := FALSE;
    FIO.xForksLeftCmd := FALSE;
    FIO.xForksRightCmd := FALSE;
    FIO.xLiftCmd := FALSE;
    FIO.xLoadConveyorCmd := FALSE;
	// Utilise the loop to control the multiple conveyors
    FOR iRollerConveyorIndex := 0 TO 3 DO
    FIO.axRollerConveyorCmd[iRollerConveyorIndex] := FALSE;
	END_FOR;
END_IF;

// Publish plant status and diagnostics
FIO.ePlantState := fbPlantCoordinator.eState;
FIO.eStorageState := fbStorage.eState;
FIO.eTankState := fbTank.eState;

FIO.uiFreeCount := fbRackManager.uiFreeCount;
FIO.uiOccupiedCount := fbRackManager.uiOccupiedCount;
FIO.uiReservedCount := fbRackManager.uiReservedCount;
FIO.uiUnknownCount := fbRackManager.uiUnknownCount;
FIO.wReservedPosition := fbRackManager.wReservedPosition;

FIO.xDischargeTimeoutFault := fbTank.xDischargeTimeoutFault;
FIO.xFillTimeoutFault := fbTank.xFillTimeoutFault;
FIO.xHighHighFault := fbTank.xHighHighFault;
FIO.xPlantFaulted := fbPlantCoordinator.xFaulted;
FIO.xPlantRunning := fbPlantCoordinator.xRunning;
FIO.xRackFaulted := fbRackManager.xFaulted;
FIO.xRackFull := fbRackManager.xRackFull;
FIO.xRecoveryRequired := fbPlantCoordinator.xRecoveryRequired;
FIO.xSequenceFault := fbPlantCoordinator.xSequenceFault;
FIO.xStepTimeoutFault := fbStorage.xStepTimeoutFault;
FIO.xStorageFaulted := fbStorage.xFaulted;
FIO.xStorageReady := fbStorage.xReady;
FIO.xTankBatchReady := fbTank.xBatchReady;
FIO.xTankFaulted := fbTank.xFaulted;
FIO.xWaitingForContainer := fbPlantCoordinator.xWaitingForContainer;
FIO.xWaitingForStorage := fbPlantCoordinator.xWaitingForStorage;</Single>
