            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PLC_PRG
VAR
	//Comments retained for learning and reference points early on during learning

    // Plant control modules
	fbOperatorControl: FB_OperatorControl;
    fbPlantCoordinator: FB_PlantCoordinator;
    fbRackManager: FB_RackManager;
    fbStorage: FB_Storage;
    fbTank: FB_Tank;
	
	// Internal conveyor control
	iRollerConveyorIndex: INT;
	xTransferConveyorCmd: BOOL;
	
	//  Stack light warning devices display
	iStackLightIndex: INT;
	xStackGreenCmd: BOOL;
	xStackRedCmd: BOOL;
	xStackYellowCmd: BOOL;
END_VAR</Single>
