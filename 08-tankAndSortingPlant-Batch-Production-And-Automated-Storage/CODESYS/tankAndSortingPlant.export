          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639217046759953733</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Start is accepted only on a new button press
fbStartEdge(CLK := xStartPB);

(*
	Stopping OR resetting Factory I/O invalidates the current
	simulated transaction and requires operator acknowledgement. 
*)
IF NOT xFactoryIORunning THEN
    xResetRequired := TRUE;
    xRunLatched := FALSE;
END_IF;

// Emergency stop immediately removes the run request and requires reset
IF NOT xEmergencyStopHealthy THEN
    xResetRequired := TRUE;
    xRunLatched := FALSE;
END_IF;

// Normal stop conditions remove the run latch but do not create a fault
IF NOT xAutoModeSelected
    OR NOT xStopCircuitHealthy
    OR xPlantFaulted
THEN
    xRunLatched := FALSE;
END_IF;

// Reset is accepted only with healthy stop circuits and no run request
xReset :=
    xResetPB
    AND xEmergencyStopHealthy
	AND xFactoryIORunning
    AND xStopCircuitHealthy
    AND NOT xRunLatched;

// Reset and Start cannot be accepted during the same PLC scan
IF xReset THEN
    xResetRequired := FALSE;

ELSIF fbStartEdge.Q
    AND xAutoModeSelected
    AND xEmergencyStopHealthy
	AND xFactoryIORunning
    AND xStopCircuitHealthy
    AND NOT xPlantFaulted
    AND NOT xResetRequired
THEN
    xRunLatched := TRUE;
END_IF;

// Public operator-control outputs
xEmergencyActive := NOT xEmergencyStopHealthy;

xEnable :=
    xEmergencyStopHealthy
	AND xFactoryIORunning
    AND NOT xResetRequired;

xAutoRun :=
    xEnable
    AND xAutoModeSelected
    AND xRunLatched;
	
// Reset indication identifies a condition requiring operator acknowledgement
xResetLightCmd :=
    xResetRequired
    OR xPlantFaulted;

// Start indication reports actual plant activity
xStartLightCmd :=
    xEnable
    AND xPlantRunning
    AND NOT xPlantFaulted;

// Stop indication reports a healthy but stationary plant
xStopLightCmd :=
    xEnable
    AND NOT xPlantRunning
    AND NOT xPlantFaulted;</Single>
            <Single Name="LineInfoPersistence" Type="string">347d8d0c-a506-4b31-b492-e17ebb9afc3b_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_OperatorControl
VAR_INPUT
	//Comments retained for learning and reference points early on during learning
	
    // Physical operator controls
    xAutoModeSelected: BOOL;
    xEmergencyStopHealthy: BOOL;
	xFactoryIORunning: BOOL;
    xPlantFaulted: BOOL;
	xPlantRunning: BOOL;
    xResetPB: BOOL;
    xStartPB: BOOL;
    xStopCircuitHealthy: BOOL;
END_VAR

VAR_OUTPUT
    // Commands and safety status supplied to the plant
    xAutoRun: BOOL;
    xEmergencyActive: BOOL;
    xEnable: BOOL;
    xReset: BOOL;
	xResetLightCmd: BOOL;
    xResetRequired: BOOL := TRUE;
	xStartLightCmd: BOOL;
    xStopLightCmd: BOOL;
END_VAR

VAR
    fbStartEdge: R_TRIG;
    xRunLatched: BOOL;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">347d8d0c-a506-4b31-b492-e17ebb9afc3b_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">128</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">85da821b-f6f8-4de1-a2e9-cef73602c539</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">7736811d-fa45-4f1c-80ac-761e0b00d34a</Single>
        <Single Name="ParentGuid" Type="System.Guid">85da821b-f6f8-4de1-a2e9-cef73602c539</Single>
        <Single Name="Name" Type="string">FB_PlantCoordinator</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639217136752173661</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(*
	Capture the transaction phase before fault handling can overwrite eState.
	From discharge onward, physical product may exist somewhere in the cell.
*)
xMaterialMayExistState :=
    (eState = E_PlantState.CommittingInventory) OR
    (eState = E_PlantState.DischargingBatch) OR
    (eState = E_PlantState.StoringProduct);

(*
    An emergency or loss of the Factory I/O lifecycle during an
    active transaction requires reservation recovery.
*)
IF (xEmergencyActive OR NOT xEnable)
    AND (eState &lt;&gt; E_PlantState.Stopped)
    AND (eState &lt;&gt; E_PlantState.Faulted)
THEN
    xRecoveryRequired := TRUE;
END_IF;

// Combine faults reported by the coordinator and plant modules
xFaulted :=
    xRackFaulted OR
	xRecoveryRequired OR
    xSequenceFault OR
    xStorageFaulted OR
    xTankFaulted;

// Reset is accepted only after automatic production has been stopped
IF xReset AND NOT xAutoRun THEN
	xRecoveryRequired := FALSE;
    xSequenceFault := FALSE;
    eState := E_PlantState.Stopped;
END_IF;

// Recalculate after a possible reset
xFaulted :=
    xRackFaulted OR
	xRecoveryRequired OR
    xSequenceFault OR
    xStorageFaulted OR
    xTankFaulted;

IF xFaulted THEN
    eState := E_PlantState.Faulted;
END_IF;

(* 
	Modules remain enabled while completing a controlled-stop transaction.
	In Stopped, a new AutoRun request is required before they are enabled,
	preventing Reset by itself from causing physical movement.
*)
xModuleEnable :=
    xEnable
    AND NOT xFaulted
    AND (
        xAutoRun
        OR (
            (eState &lt;&gt; E_PlantState.Faulted)
            AND (eState &lt;&gt; E_PlantState.Stopped)
        )
    );

xModuleReset := xReset AND NOT xAutoRun;

// Safe transaction-command defaults
xRackCommitRequest := FALSE;
xRackReserveRequest := FALSE;
xStorageStoreRequest := FALSE;
xTankDischargePermit := FALSE;
xTankStartBatchReq := FALSE;

// Default status values
xTankPrefillAllowed := FALSE;
xWaitingForContainer := FALSE;
xWaitingForStorage := FALSE;

IF xModuleEnable THEN

    CASE eState OF

        E_PlantState.Stopped:
            // AutoRun begins a new production transaction
            IF xAutoRun THEN
                eState := E_PlantState.Idle;
            END_IF;

        E_PlantState.Idle:
            // Do not begin another transaction after a controlled stop
            IF NOT xAutoRun THEN
                eState := E_PlantState.Stopped;

            // An unexpected existing reservation requires reconciliation
            ELSIF xRackReservationValid THEN
                xSequenceFault := TRUE;

            // RackFull blocks production but is not an equipment fault
            ELSIF NOT xRackFull THEN
                eState := E_PlantState.ReservingSlot;
            END_IF;

        E_PlantState.ReservingSlot:
            // Hold the request until the rack manager acknowledges it
            xRackReserveRequest := TRUE;

            IF xRackReserveAck THEN

                IF xRackReservationValid THEN
                    eState := E_PlantState.WaitingForBatch;

                ELSIF xRackFull THEN
                    eState := E_PlantState.Idle;

                ELSE
					(*
                    	An acknowledgement without a reservation or full rack
                    	indicates inconsistent transaction feedback
					*)
                    xSequenceFault := TRUE;
                END_IF;

            END_IF;

        E_PlantState.WaitingForBatch:
            IF NOT xRackReservationValid THEN
                xSequenceFault := TRUE;

            ELSIF xTankBatchReady THEN
                xWaitingForContainer := NOT xContainerAtFill;

                xWaitingForStorage :=
                    NOT xTransferPathClear OR
                    NOT xStorageReady;

                IF xContainerAtFill
                    AND xTransferPathClear
                    AND xStorageReady
                THEN
                    eState := E_PlantState.DischargingBatch;
                END_IF;
            END_IF;

        E_PlantState.DischargingBatch:
            // Permission remains active until the tank acknowledges completion
            xTankDischargePermit := TRUE;

            IF NOT xRackReservationValid THEN
                xSequenceFault := TRUE;

            ELSIF xTankDischargeComplete THEN
                eState := E_PlantState.StoringProduct;
            END_IF;

        E_PlantState.StoringProduct:
            // Storage owns the conveyor and crane sequence from this point
            xStorageStoreRequest := TRUE;

            IF NOT xRackReservationValid THEN
                xSequenceFault := TRUE;

            ELSIF xStorageDepositComplete THEN
                eState := E_PlantState.CommittingInventory;
            END_IF;

        E_PlantState.CommittingInventory:
            // The storage request remains active while inventory is committed
            xStorageStoreRequest := TRUE;
            xRackCommitRequest := TRUE;

            IF NOT xRackReservationValid
                AND NOT xRackCommitAck
            THEN
                xSequenceFault := TRUE;

            ELSIF xRackCommitAck THEN

                IF NOT xRackReservationValid THEN
                    eState :=
                        E_PlantState.WaitingForStorageComplete;
                ELSE
                    xSequenceFault := TRUE;
                END_IF;

            END_IF;

        E_PlantState.WaitingForStorageComplete:
            // The slot is occupied, but the crane must still return home
            xStorageStoreRequest := TRUE;

            IF xStorageStoreComplete THEN

                IF xAutoRun THEN
                    eState := E_PlantState.Idle;
                ELSE
                    eState := E_PlantState.Stopped;
                END_IF;

            END_IF;

        E_PlantState.Faulted:
            // Transaction commands remain at their safe defaults

    END_CASE;

END_IF;

// Start the batch allocated to the current transaction
xTankPrefillAllowed :=
    xModuleEnable
    AND xTankReady
    AND (eState = E_PlantState.WaitingForBatch);
(*
	While the crane handles the current case, prepare the next batch only
	when automatic production remains requested and another slot is free
*)
xTankPrefillAllowed :=
    xTankPrefillAllowed
    OR (
        xModuleEnable
        AND xAutoRun
        AND xTankReady
        AND NOT xRackFull
        AND (
            (eState = E_PlantState.StoringProduct) OR
            (eState = E_PlantState.CommittingInventory) OR
            (eState = E_PlantState.WaitingForStorageComplete)
        )
    );

xTankStartBatchReq := xTankPrefillAllowed;

xRunning :=
    xModuleEnable
    AND (eState &lt;&gt; E_PlantState.Stopped)
    AND (eState &lt;&gt; E_PlantState.Faulted);

// Recalculate after evaluating the sequence
xFaulted :=
    xRackFaulted OR
	xRecoveryRequired OR
    xSequenceFault OR
    xStorageFaulted OR
    xTankFaulted;
	
(* 
	Preserve whether the interrupted reservation might now represent
	physical material. RackManager uses this during Reset. 
*)
IF xFaulted
    AND xRackReservationValid
    AND xMaterialMayExistState
THEN
    xReservationMayBeOccupied := TRUE;
END_IF;
(*
	Clear the classification only after Reset has ended
	and reservation reconciliation has completed.
*)
IF NOT xReset
    AND (eState = E_PlantState.Stopped)
    AND NOT xRackReservationValid
THEN
    xReservationMayBeOccupied := FALSE;
END_IF;

// A newly detected fault removes every permission during this same scan
IF xFaulted THEN
    eState := E_PlantState.Faulted;
    xModuleEnable := FALSE;
    xRackCommitRequest := FALSE;
    xRackReserveRequest := FALSE;
    xStorageStoreRequest := FALSE;
    xTankDischargePermit := FALSE;
    xTankPrefillAllowed := FALSE;
    xTankStartBatchReq := FALSE;
    xWaitingForContainer := FALSE;
    xWaitingForStorage := FALSE;
    xRunning := FALSE;
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">7736811d-fa45-4f1c-80ac-761e0b00d34a_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_PlantCoordinator
VAR_INPUT
	//Comments retained for learning and reference points early on during learning

    // Operator commands
    xAutoRun: BOOL;
	xEmergencyActive: BOOL;
    xEnable: BOOL;
    xReset: BOOL;

    // Filling and transfer sensors
    xContainerAtFill: BOOL;
    xTransferPathClear: BOOL;

    // Rack manager status
    xRackCommitAck: BOOL;
    xRackFaulted: BOOL;
    xRackFull: BOOL;
    xRackReservationValid: BOOL;
    xRackReserveAck: BOOL;

    // Storage module status
    xStorageDepositComplete: BOOL;
    xStorageFaulted: BOOL;
    xStorageReady: BOOL;
    xStorageStoreComplete: BOOL;

    // Tank module status
    xTankBatchReady: BOOL;
    xTankDischargeComplete: BOOL;
    xTankFaulted: BOOL;
    xTankReady: BOOL;
END_VAR

VAR_OUTPUT
    // Shared module control
    xModuleEnable: BOOL;
    xModuleReset: BOOL;

    // Rack manager commands
    xRackCommitRequest: BOOL;
    xRackReserveRequest: BOOL;

    // Storage module command
    xStorageStoreRequest: BOOL;

    // Tank module commands
    xTankDischargePermit: BOOL;
    xTankStartBatchReq: BOOL;

    // Plant status and diagnostics
    xFaulted: BOOL;
	xRecoveryRequired: BOOL;
    xRunning: BOOL;
    xSequenceFault: BOOL;
    xWaitingForContainer: BOOL;
    xWaitingForStorage: BOOL;
    eState: E_PlantState := E_PlantState.Stopped;
	
	// Rack recovery classification
    xReservationMayBeOccupied: BOOL;
END_VAR

VAR
    // Internal production-permission calculation
	xMaterialMayExistState: BOOL;
    xTankPrefillAllowed: BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">7736811d-fa45-4f1c-80ac-761e0b00d34a_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">386</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">85da821b-f6f8-4de1-a2e9-cef73602c539</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">99484d56-0d09-4fd4-9852-fe6942556da1</Single>
        <Single Name="ParentGuid" Type="System.Guid">85da821b-f6f8-4de1-a2e9-cef73602c539</Single>
        <Single Name="Name" Type="string">FB_RackManager</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639217144490510273</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Acknowledgements remain high until their request returns low
IF NOT xCommitRequest THEN
    xCommitAck := FALSE;
END_IF;

IF NOT xReserveRequest THEN
    xReserveAck := FALSE;
END_IF;

(*
    Reset clears control faults only after all transaction requests
    have been removed.

    An unused pre-production reservation returns to Free.
    A reservation associated with possible physical material is
    quarantined as Unknown.
*)
IF xReset
    AND NOT xCommitRequest
    AND NOT xReserveRequest
THEN
    xInvalidOperationFault := FALSE;

    IF xReservationValid THEN

        IF (wReservedPosition &gt;= 1)
            AND (wReservedPosition &lt;= 54)
            AND (
                aSlotState[WORD_TO_INT(wReservedPosition)]
                = E_RackSlotState.Reserved
            )
        THEN

            IF xReservationMayBeOccupied THEN
                aSlotState[WORD_TO_INT(wReservedPosition)] :=
                    E_RackSlotState.Unknown;
            ELSE
                aSlotState[WORD_TO_INT(wReservedPosition)] :=
                    E_RackSlotState.Free;
            END_IF;

            wReservedPosition := 0;
            xReservationValid := FALSE;

        ELSE
            (*
                Retain the reservation information if its internal
                state is inconsistent, allowing investigation.
            *)
            xInvalidOperationFault := TRUE;
        END_IF;

    END_IF;

END_IF;

// Simultaneous transaction commands are invalid
IF xCommitRequest AND xReserveRequest THEN
    xInvalidOperationFault := TRUE;
END_IF;

xFaulted := xInvalidOperationFault;

IF xEnable AND NOT xFaulted THEN

    // Commit the currently reserved position as occupied
    IF xCommitRequest AND NOT xCommitAck THEN

        IF xReservationValid
            AND (wReservedPosition &gt;= 1)
            AND (wReservedPosition &lt;= 54)
            AND (
                aSlotState[WORD_TO_INT(wReservedPosition)]
                = E_RackSlotState.Reserved
            )
        THEN
            aSlotState[WORD_TO_INT(wReservedPosition)] :=
                E_RackSlotState.Occupied;

            xReservationValid := FALSE;
            wReservedPosition := 0;
            xCommitAck := TRUE;
        ELSE
            xInvalidOperationFault := TRUE;
        END_IF;

    // Select the first available rack position
    ELSIF xReserveRequest AND NOT xReserveAck THEN

        IF xReservationValid THEN
            // This v1 manager supports one active reservation
            xInvalidOperationFault := TRUE;
        ELSE
            wCandidatePosition := 0;
            wReservedPosition := 0;

            FOR iSlot := 1 TO 54 DO

                IF (wCandidatePosition = 0)
                    AND (
                        aSlotState[iSlot]
                        = E_RackSlotState.Free
                    )
                THEN
                    wCandidatePosition := INT_TO_WORD(iSlot);
                END_IF;

            END_FOR;

            IF wCandidatePosition &lt;&gt; 0 THEN
                aSlotState[WORD_TO_INT(wCandidatePosition)] :=
                    E_RackSlotState.Reserved;

                wReservedPosition := wCandidatePosition;
                xReservationValid := TRUE;
            END_IF;

            // Acknowledge even when full; validity reports the outcome
            xReserveAck := TRUE;
        END_IF;

    END_IF;

END_IF;

// Recalculate inventory totals every scan
uiFreeCount := 0;
uiOccupiedCount := 0;
uiReservedCount := 0;
uiUnknownCount := 0;

FOR iSlot := 1 TO 54 DO

    CASE aSlotState[iSlot] OF

        E_RackSlotState.Free:
            uiFreeCount := uiFreeCount + 1;

        E_RackSlotState.Occupied:
            uiOccupiedCount := uiOccupiedCount + 1;

        E_RackSlotState.Reserved:
            uiReservedCount := uiReservedCount + 1;

        E_RackSlotState.Unknown:
            uiUnknownCount := uiUnknownCount + 1;

    END_CASE;

END_FOR;

xRackFull := uiFreeCount = 0;
xFaulted := xInvalidOperationFault;</Single>
            <Single Name="LineInfoPersistence" Type="string">99484d56-0d09-4fd4-9852-fe6942556da1_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_RackManager
VAR_INPUT
	//Comments retained for learning and reference points early on during learning

    // Commands from the plant coordinator
    xCommitRequest: BOOL;
    xEnable: BOOL;
	xReservationMayBeOccupied: BOOL;
    xReserveRequest: BOOL;
    xReset: BOOL;
END_VAR

VAR_OUTPUT
    // Rack inventory and calculated totals
    aSlotState: ARRAY[1..54] OF E_RackSlotState;
    uiFreeCount: UINT;
    uiOccupiedCount: UINT;
    uiReservedCount: UINT;
    uiUnknownCount: UINT;

    // Current reserved destination
    wReservedPosition: WORD;
    xReservationValid: BOOL;

    // Transaction acknowledgements
    xCommitAck: BOOL;
    xReserveAck: BOOL;

    // Module status and diagnostics
    xFaulted: BOOL;
    xRackFull: BOOL;
END_VAR

VAR
    // Internal control and slot-search variables
    iSlot: INT;
    wCandidatePosition: WORD;
	xInvalidOperationFault: BOOL;
END_VAR</Single>
