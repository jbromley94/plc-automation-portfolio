      <Single Name="Object" Type="{ffbfa93a-b94d-45fc-a329-229860183b1d}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only'}
VAR_GLOBAL
    // Operator-control commands and recovery status generated by the PLC
	xAutoRun: BOOL;
	xPlantEnable: BOOL;
	xPlantReset: BOOL;
	xRecoveryRequired: BOOL;
	
	// Factory I/O operator controls
	xAutoModeSelected: BOOL;
	
	// Factory I/O lifecycle feedback used for transaction recovery
	xFactoryIORunning: BOOL;
	
	// Released and healthy
	xEmergencyStopHealthy: BOOL;
	xResetPB: BOOL;
	xStartPB: BOOL;
	
	// Stop button not pressed
	xStopCircuitHealthy: BOOL;
	
	// Operator indication commands generated by the PLC
	xResetLightCmd: BOOL;
	xStartLightCmd: BOOL;
	xStopLightCmd: BOOL;

    // Tank and transfer feedback received from Factory I/O through Kepware
    rTankLevelV: REAL;
    xContainerAtFill: BOOL;
    xTankLevelHighHigh: BOOL;
	
	// Analog tank commands sent to Factory I/O
	rDischargeValveCmdV: REAL;
	rFillValveCmdV: REAL;
	
	// Boolean tank commands retained for diagnostics
	xDischargeValveCmd: BOOL;
	xFillValveCmd: BOOL;
	
	// Container supply command generated by the PLC
	xContainerEmitterCmd: BOOL;

    // Storage feedback received from Factory I/O
    xForkAtLeft: BOOL;
    xForkAtMiddle: BOOL;
    xForkAtRight: BOOL;
	xLoadBeamClear: BOOL;
    xMovingX: BOOL;
    xMovingZ: BOOL;

    // Storage actuator commands generated by the PLC
    wTargetPositionCmd: WORD := 55;
    xEntryConveyorCmd: BOOL;
    xForksLeftCmd: BOOL;
    xForksRightCmd: BOOL;
    xLiftCmd: BOOL;
    xLoadConveyorCmd: BOOL;
	
	(* 
		Commands for the four identical roller-conveyor sections
		Of Note (Learning) - 'ax' means an array of Bools 
	*)
	axRollerConveyorCmd: ARRAY[0..3] OF BOOL;

    // Public plant status and diagnostics
    ePlantState: E_PlantState := E_PlantState.Stopped;
    eStorageState: E_StorageState := E_StorageState.Stopped;
    eTankState: E_TankState := E_TankState.Stopped;
	xEmergencyActive: BOOL;
	xResetRequired: BOOL;
	
	// PLC-derived plant conditions
	xCraneAtHome: BOOL;
	xProductAtLoad: BOOL;
	xTransferPathClear: BOOL;
	
	(*
		Stack-light locations:
		[0] = infeed/emitter
		[1] = tank/filling position
		[2] = control panel
		[3] = outfeed/remover
	*)
	axStackGreenCmd: ARRAY[0..3] OF BOOL;
	axStackRedCmd: ARRAY[0..3] OF BOOL;
	axStackYellowCmd: ARRAY[0..3] OF BOOL;
	
	// Scaled tank measurement for control and diagnostics
	rTankLevelPct: REAL;

    uiFreeCount: UINT;
    uiOccupiedCount: UINT;
    uiReservedCount: UINT;
	uiUnknownCount: UINT;
	

    wReservedPosition: WORD;

    xDischargeTimeoutFault: BOOL;
    xFillTimeoutFault: BOOL;
    xHighHighFault: BOOL;
    xPlantFaulted: BOOL;
    xPlantRunning: BOOL;
    xRackFaulted: BOOL;
    xRackFull: BOOL;
    xSequenceFault: BOOL;
    xStepTimeoutFault: BOOL;
    xStorageFaulted: BOOL;
    xStorageReady: BOOL;
    xTankBatchReady: BOOL;
    xTankFaulted: BOOL;
    xWaitingForContainer: BOOL;
    xWaitingForStorage: BOOL;
END_VAR</Single>
