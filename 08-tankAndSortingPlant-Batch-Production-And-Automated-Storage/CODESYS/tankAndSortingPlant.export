                <Single Name="VarName" Type="string">eStorageState</Single>
              </Single>
              <Single Type="{d8f96a30-175d-4274-9fd9-f7db39255531}" Method="IArchivable">
                <Single Name="VarAccess" Type="int">3</Single>
