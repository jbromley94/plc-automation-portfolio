      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">e2ba4e25-e914-46d0-a79d-96d3330584e2</Single>
        <Single Name="ParentGuid" Type="System.Guid">85da821b-f6f8-4de1-a2e9-cef73602c539</Single>
        <Single Name="Name" Type="string">FB_Storage</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639217145501419110</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Timers used for vertical movements without direct position feedback
fbLiftTimer(
    IN := xEnable AND (eState = E_StorageState.LiftingProduct),
    PT := tLiftTime
);

fbLowerTimer(
    IN := xEnable AND (eState = E_StorageState.LoweringProduct),
    PT := tLowerTime
);

// Establish current fault status
xFaulted :=
    xReservationFault OR
    xStepTimeoutFault;
	
(*
	Reset clears control faults and returns the sequence
	to a non-moving baseline.
	Rack inventory is owned separately by FB_RackManager.
*)
IF xReset THEN
    eState := E_StorageState.Stopped;
    wActivePosition := 0;
    wTargetPositionCmd := 0;

    xDepositComplete := FALSE;
    xMotionStarted := FALSE;
    xReservationFault := FALSE;
    xStepTimeoutFault := FALSE;
END_IF;

// Recalculate after a possible reset
xFaulted :=
    xReservationFault OR
    xStepTimeoutFault;

IF xFaulted THEN
    eState := E_StorageState.Faulted;
END_IF;

// A request must return low before another transaction is accepted
IF xReset OR xFaulted THEN
    xCommandArmed := FALSE;
ELSIF NOT xStoreRequest THEN
    xCommandArmed := TRUE;
END_IF;

// Safe Boolean output defaults
xEntryConveyorCmd := FALSE;
xLoadConveyorCmd := FALSE;
xForksLeftCmd := FALSE;
xForksRightCmd := FALSE;
xLiftCmd := FALSE;
xReady := FALSE;
xStoreComplete := FALSE;

IF xEnable
		AND NOT xFaulted
		AND NOT xReset
	THEN

    CASE eState OF

        E_StorageState.Stopped:
            IF xCraneAtHome AND xForkAtMiddle THEN
                eState := E_StorageState.Idle;
            ELSE
                wTargetPositionCmd := wHomePosition;
                xMotionStarted := FALSE;
                eState := E_StorageState.ReturningHome;
            END_IF;

        E_StorageState.Idle:
            wTargetPositionCmd := wHomePosition;

            IF xStoreRequest AND xCommandArmed THEN

                IF xReservationValid
                    AND (wReservedPosition &gt;= 1)
                    AND (wReservedPosition &lt;= 54)
                THEN
                    wActivePosition := wReservedPosition;
                    xDepositComplete := FALSE;
                    xCommandArmed := FALSE;
                    eState := E_StorageState.ReceivingProduct;
                ELSE
                    xReservationFault := TRUE;
                END_IF;

            END_IF;

        E_StorageState.ReceivingProduct:
            IF xProductAtLoad THEN
                eState := E_StorageState.ExtendingToLoad;
            ELSE
                xEntryConveyorCmd := TRUE;
                xLoadConveyorCmd := TRUE;
            END_IF;

        E_StorageState.ExtendingToLoad:
            xForksLeftCmd := TRUE;

            IF xForkAtLeft THEN
                eState := E_StorageState.LiftingProduct;
            END_IF;

        E_StorageState.LiftingProduct:
            xForksLeftCmd := TRUE;
            xLiftCmd := TRUE;

            IF fbLiftTimer.Q THEN
                eState := E_StorageState.RetractingWithProduct;
            END_IF;

        E_StorageState.RetractingWithProduct:
            xLiftCmd := TRUE;

            IF xForkAtMiddle THEN
                xMotionStarted := FALSE;
                eState := E_StorageState.MovingToRack;
            END_IF;

        E_StorageState.MovingToRack:
            xLiftCmd := TRUE;
            wTargetPositionCmd := wActivePosition;

            IF xMovingX OR xMovingZ THEN
                xMotionStarted := TRUE;
            END_IF;

            IF xMotionStarted
                AND NOT xMovingX
                AND NOT xMovingZ
            THEN
                xMotionStarted := FALSE;
                eState := E_StorageState.ExtendingToRack;
            END_IF;

        E_StorageState.ExtendingToRack:
            xLiftCmd := TRUE;
            xForksRightCmd := TRUE;
            wTargetPositionCmd := wActivePosition;

            IF xForkAtRight THEN
                eState := E_StorageState.LoweringProduct;
            END_IF;

        E_StorageState.LoweringProduct:
            xForksRightCmd := TRUE;
            wTargetPositionCmd := wActivePosition;

            IF fbLowerTimer.Q THEN
                eState := E_StorageState.RetractingAfterDeposit;
            END_IF;

        E_StorageState.RetractingAfterDeposit:
            wTargetPositionCmd := wActivePosition;

            IF xForkAtMiddle THEN
                // Inventory may now be committed by the rack manager
                xDepositComplete := TRUE;
                xMotionStarted := FALSE;
                eState := E_StorageState.ReturningHome;
            END_IF;

        E_StorageState.ReturningHome:
            wTargetPositionCmd := wHomePosition;

            IF xMovingX OR xMovingZ THEN
                xMotionStarted := TRUE;
            END_IF;

            IF xForkAtMiddle
                AND (
                    xCraneAtHome
                    OR (
                        xMotionStarted
                        AND NOT xMovingX
                        AND NOT xMovingZ
                    )
                )
            THEN
                xMotionStarted := FALSE;

                IF xDepositComplete THEN
                    eState := E_StorageState.Complete;
                ELSE
                    // Startup or fault-recovery homing
                    eState := E_StorageState.Idle;
                END_IF;
            END_IF;

        E_StorageState.Complete:
            wTargetPositionCmd := wHomePosition;
            xStoreComplete := TRUE;

            // Hold completion until the coordinator removes its request
            IF NOT xStoreRequest THEN
                xDepositComplete := FALSE;
                xStoreComplete := FALSE;
                wActivePosition := 0;
                eState := E_StorageState.Idle;
            END_IF;

        E_StorageState.Faulted:
            // Boolean commands remain at their safe defaults

    END_CASE;

END_IF;

// States which must make progress within the configured timeout
xTimedStep :=
    (eState = E_StorageState.ReceivingProduct) OR
    (eState = E_StorageState.ExtendingToLoad) OR
    (eState = E_StorageState.LiftingProduct) OR
    (eState = E_StorageState.RetractingWithProduct) OR
    (eState = E_StorageState.MovingToRack) OR
    (eState = E_StorageState.ExtendingToRack) OR
    (eState = E_StorageState.LoweringProduct) OR
    (eState = E_StorageState.RetractingAfterDeposit) OR
    (eState = E_StorageState.ReturningHome);

// Reset the common timer for one scan whenever the state changes
xStateChanged := eState &lt;&gt; ePreviousState;

fbStepTimeout(
    IN := xEnable AND xTimedStep AND NOT xStateChanged,
    PT := tStepTimeout
);

ePreviousState := eState;

IF fbStepTimeout.Q THEN
    xStepTimeoutFault := TRUE;
END_IF;

// Recalculate after timeout evaluation
xFaulted :=
    xReservationFault OR
    xStepTimeoutFault;

// A newly detected fault stops all movement commands immediately
IF xFaulted THEN
    eState := E_StorageState.Faulted;
	wTargetPositionCmd := 0;
    xEntryConveyorCmd := FALSE;
    xLoadConveyorCmd := FALSE;
    xForksLeftCmd := FALSE;
    xForksRightCmd := FALSE;
    xLiftCmd := FALSE;
    xCommandArmed := FALSE;
END_IF;

// Public module status
xReady :=
    xEnable
    AND NOT xFaulted
    AND (eState = E_StorageState.Idle);</Single>
            <Single Name="LineInfoPersistence" Type="string">e2ba4e25-e914-46d0-a79d-96d3330584e2_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Storage
VAR_INPUT
	//Comments retained for learning and reference points early on during learning

    // Commands from the plant coordinator
    xEnable: BOOL;
	xReset: BOOL;
    xStoreRequest: BOOL;
    
    // Product and crane feedback
	xCraneAtHome: BOOL;
    xForkAtLeft: BOOL;
    xForkAtMiddle: BOOL;
    xForkAtRight: BOOL;
    xMovingX: BOOL;
    xMovingZ: BOOL;
	xProductAtLoad: BOOL;

    // Reserved destination supplied by the rack manager
	wHomePosition: WORD := 55;
    xReservationValid: BOOL;
    wReservedPosition: WORD;
	

    // Adjustable timing limits
	tLiftTime: TIME := T#2S;
    tLowerTime: TIME := T#2s;
    tStepTimeout: TIME := T#30s;
END_VAR

VAR_OUTPUT
    // Crane and conveyor commands
    xEntryConveyorCmd: BOOL;
    xLoadConveyorCmd: BOOL;
    xForksLeftCmd: BOOL;
    xForksRightCmd: BOOL;
    xLiftCmd: BOOL;
    wTargetPositionCmd: WORD := 55;

    // Module status
	xDepositComplete: BOOL;
	xFaulted: BOOL;
	xReady: BOOL;
    xStoreComplete: BOOL;
    xStepTimeoutFault: BOOL;
    eState: E_StorageState := E_StorageState.Stopped;
END_VAR

VAR
    ePreviousState: E_StorageState := E_StorageState.Stopped;
    fbLiftTimer: TON;
    fbLowerTimer: TON;
    fbStepTimeout: TON;
	wActivePosition: WORD;
    xCommandArmed: BOOL;
    xMotionStarted: BOOL;
	xReservationFault: BOOL;
    xStateChanged: BOOL;
    xTimedStep: BOOL;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">e2ba4e25-e914-46d0-a79d-96d3330584e2_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">683</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">85da821b-f6f8-4de1-a2e9-cef73602c539</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">532e8410-e1e8-4ec5-8aa0-794ae5f3e62c</Single>
        <Single Name="ParentGuid" Type="System.Guid">85da821b-f6f8-4de1-a2e9-cef73602c539</Single>
        <Single Name="Name" Type="string">FB_Tank</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639217151597972487</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Convert the analog reading into a reusable tank status
xTankEmpty := rLevelPct &lt;= rEmptySetpointPct;

// High-high is a trip: even a brief sensor signal remains latched
IF xLevelHighHigh THEN
    xHighHighFault := TRUE;
END_IF;

// Establish the current combined fault status
xFaulted :=
    xHighHighFault OR
    xFillTimeoutFault OR
    xDischargeTimeoutFault;

(*
	Reset returns both faulted and interrupted tank sequences
	to a known non-moving baseline.
	A live high-high condition prevents fault clearance.
*)
IF xReset AND NOT xLevelHighHigh THEN
    eState := E_TankState.Stopped;

    xHighHighFault := FALSE;
    xFillTimeoutFault := FALSE;
    xDischargeTimeoutFault := FALSE;
END_IF;

// Recalculate after a possible reset
xFaulted :=
    xHighHighFault OR
    xFillTimeoutFault OR
    xDischargeTimeoutFault;

IF xFaulted THEN
    eState := E_TankState.Faulted;
END_IF;

// Requests must return low after startup, reset or fault
IF xReset OR xFaulted THEN
    xCommandArmed := FALSE;
ELSIF NOT xStartBatchReq AND NOT xDischargePermit THEN
    xCommandArmed := TRUE;
END_IF;

// Hold completion until the coordinator removes its discharge permit
IF xReset OR xFaulted OR NOT xDischargePermit THEN
    xDischargeComplete := FALSE;
END_IF;

// Safe actuator defaults for every scan
xFillValveCmd := FALSE;
xDischargeValveCmd := FALSE;

IF xEnable
		AND NOT xFaulted
		AND NOT xReset
	THEN

    CASE eState OF

        E_TankState.Stopped:
			// Determine a safe starting state from the physical level
			IF rLevelPct &gt;= rFillSetpointPct THEN
				eState := E_TankState.BatchReady;
			ELSE
				eState := E_TankState.Idle;
			END_IF;

        E_TankState.Idle:
            IF xStartBatchReq AND xCommandArmed THEN
                eState := E_TankState.Filling;
                xCommandArmed := FALSE;
            END_IF;

        E_TankState.Filling:
            IF rLevelPct &gt;= rFillSetpointPct THEN
                eState := E_TankState.BatchReady;
            ELSE
                xFillValveCmd := TRUE;
            END_IF;

        E_TankState.BatchReady:
            IF xDischargePermit AND xCommandArmed THEN
                eState := E_TankState.Discharging;
                xCommandArmed := FALSE;
            END_IF;

        E_TankState.Discharging:
			IF xTankEmpty THEN
				xDischargeComplete := TRUE;
				eState := E_TankState.Idle;
		
			ELSIF xDischargePermit THEN
				xDischargeValveCmd := TRUE;
			END_IF;

        E_TankState.Faulted:
			xFillValveCmd := FALSE;
			xDischargeValveCmd := FALSE;

    END_CASE;

END_IF;

// Time spent in each active process state
fbFillTimeout(
    IN := xEnable AND (eState = E_TankState.Filling),
    PT := tFillTimeout
);

fbDischargeTimeout(
    IN := xEnable AND (eState = E_TankState.Discharging),
    PT := tDischargeTimeout
);

// Latch timeout faults
IF fbFillTimeout.Q THEN
    xFillTimeoutFault := TRUE;
END_IF;

IF fbDischargeTimeout.Q THEN
    xDischargeTimeoutFault := TRUE;
END_IF;

// Recalculate after evaluating the timers
xFaulted :=
    xHighHighFault OR
    xFillTimeoutFault OR
    xDischargeTimeoutFault;

// A newly detected fault closes both valves during this same scan
IF xFaulted THEN
    eState := E_TankState.Faulted;
    xFillValveCmd := FALSE;
    xDischargeValveCmd := FALSE;
    xCommandArmed := FALSE;
	xDischargeComplete := FALSE;
END_IF;

// Final defensive interlock: filling and discharge can never coexist
IF xFillValveCmd AND xDischargeValveCmd THEN
    xFillValveCmd := FALSE;
    xDischargeValveCmd := FALSE;
END_IF;

// Externally visible state information
xBatchReady := eState = E_TankState.BatchReady;
xReady :=
    xEnable
    AND NOT xFaulted
    AND xCommandArmed
    AND (eState = E_TankState.Idle);</Single>
            <Single Name="LineInfoPersistence" Type="string">532e8410-e1e8-4ec5-8aa0-794ae5f3e62c_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Tank
VAR_INPUT
	//Comments retained for learning and reference points early on during learning	

    // Commands and permissions from the plant coordinator
    xEnable: BOOL;
	xDischargePermit: BOOL;
    xReset: BOOL;
    xStartBatchReq: BOOL;

    // Physical tank measurements
    rLevelPct: REAL;
    xLevelHighHigh: BOOL;

    // Adjustable process settings
	rEmptySetpointPct:REAL := 5.0;
    rFillSetpointPct: REAL := 80.0;
	tDischargeTimeout: TIME := T#20S;
    tFillTimeout: TIME := T#30S;
END_VAR

VAR_OUTPUT
    // Commands sent towards physical actuators
	xDischargeValveCmd: BOOL;
    xFillValveCmd: BOOL;

    // Status reported to the plant coordinator
    xBatchReady: BOOL;
	xDischargeComplete: BOOL;
	xFaulted: BOOL;
	xReady: BOOL;

    // Individual fault diagnostics
	xDischargeTimeoutFault: BOOL;
	xFillTimeoutFault: BOOL;
    xHighHighFault: BOOL;
    

    // Current state for diagnostics and visualization
    eState: E_TankState := E_TankState.Stopped;
END_VAR

VAR
    // Private timer instances
	fbDischargeTimeout: TON;
    fbFillTimeout: TON;
	xCommandArmed: BOOL;
	xTankEmpty: BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">532e8410-e1e8-4ec5-8aa0-794ae5f3e62c_Decl_LineIds</Single>
