            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_OperatorControl
VAR_INPUT
    xAutoModeSelected   : BOOL;
    xEmergencyStop      : BOOL;
    xFactoryIOPaused    : BOOL;
    xFactoryIORunning   : BOOL;
    xManualModeSelected : BOOL;
    xPlantFaulted       : BOOL;
    xResetPB            : BOOL;
	xSafeToStop 		: BOOL;
    xStartPB            : BOOL;
    xStopPB             : BOOL;
END_VAR

VAR_OUTPUT
    xEnableAutomatic : BOOL;
    xResetPulse      : BOOL;
    xResetRequired   : BOOL;
    xRunLatched      : BOOL;
	xStopPending 	 : BOOL;
END_VAR

VAR
    rtReset        : R_TRIG;
    rtStart        : R_TRIG;
    rtStop         : R_TRIG;
    xAutoModeValid : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">cfdc7eb5-fe54-45da-ab56-b52350dbca90_Decl_LineIds</Single>
