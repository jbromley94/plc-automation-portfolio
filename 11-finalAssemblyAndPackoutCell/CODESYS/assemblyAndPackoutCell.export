    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">13402619-098e-4bb9-b3ca-6298314c18dc</Single>
        <Single Name="ParentGuid" Type="System.Guid">bff20d56-5146-47eb-9d1f-9e1e4c6e1a1e</Single>
        <Single Name="Name" Type="string">FB_AssemblerCell</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639221236870445961</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// DEFAULT COMMANDS
//
// Every command must be deliberately enabled by the active state.
// =============================================================

xBaseClampCmd := FALSE;
xBasesConveyorCmd := FALSE;
xBasesPositionerRaiseCmd := FALSE;
xGrabCmd := FALSE;
xLidClampCmd := FALSE;
xLidsConveyorCmd := FALSE;
xMoveXCmd := FALSE;
xMoveZCmd := FALSE;
xProductCompletePulse := FALSE;

// =============================================================
// EDGE AND STATE-ENTRY DETECTION
// =============================================================

rtPartLeaving(CLK := xPartLeaving);

xStateChanged :=
    eState &lt;&gt; ePreviousState;

IF xStateChanged THEN
    ePreviousState := eState;
    xMotionObserved := FALSE;
END_IF;

// =============================================================
// STATE TIMERS
// =============================================================

fbClampTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (
            (eState = E_AssemblerState.ClampingParts)
            OR
            (eState = E_AssemblerState.ReleasingLidClamp)
        ),
    PT := tClampTimeout
);

fbFeedTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (eState = E_AssemblerState.WaitingForParts),
    PT := tFeedTimeout
);

fbGrabSettle(
    IN :=
        xEnable
        AND (eState = E_AssemblerState.GrippingLid)
        AND xItemDetected,
    PT := tGrabSettle
);

fbGrabTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (eState = E_AssemblerState.GrippingLid),
    PT := tMotionTimeout
);

fbHomeSettle(
    IN :=
        xEnable
        AND (eState = E_AssemblerState.Homing)
        AND NOT xMovingX
        AND NOT xMovingZ,
    PT := tHomeSettle
);

fbMotionTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (
            (eState = E_AssemblerState.Homing)
            OR
            (eState = E_AssemblerState.LoweringToLid)
            OR
            (eState = E_AssemblerState.LoweringToBase)
            OR
            (eState = E_AssemblerState.MovingToBase)
            OR
            (eState = E_AssemblerState.RaisingFromBase)
            OR
            (eState = E_AssemblerState.RaisingLid)
            OR
            (eState = E_AssemblerState.ReturningHome)
			OR
			(eState = E_AssemblerState.ReleasingProduct)
        ),
    PT := tMotionTimeout
);	

fbProductExitTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (eState = E_AssemblerState.WaitingForProductExit),
    PT := tProductExitTimeout
);

fbReleaseSettle(
    IN :=
        xEnable
        AND (eState = E_AssemblerState.ReleasingLid),
    PT := tReleaseSettle
);

// =============================================================
// RESET AND DISABLED CONDITIONS
// =============================================================

IF xReset THEN

    diProductsCompleted := 0;
    eState := E_AssemblerState.Stopped;
    uiFaultCode := 0;
    xMotionObserved := FALSE;

ELSIF NOT xEnable THEN

    // Fault state remains latched until Reset.
    IF eState &lt;&gt; E_AssemblerState.Faulted THEN
        eState := E_AssemblerState.Stopped;
    END_IF;

// =============================================================
// AUTOMATIC ASSEMBLY SEQUENCE
// =============================================================

ELSE

    CASE eState OF

        // -----------------------------------------------------
        // Begin every enabled run by returning the arm to its
        // default raised position above the lid.
        // -----------------------------------------------------

        E_AssemblerState.Stopped:

            eState := E_AssemblerState.Homing;

        // -----------------------------------------------------
        // Move X = FALSE: above the lid.
        // Move Z = FALSE: raised.
        //
        // The settle timer also handles the case where the arm
        // was already home and therefore produces no movement.
        // -----------------------------------------------------

        E_AssemblerState.Homing:

            IF fbHomeSettle.Q THEN
                eState := E_AssemblerState.WaitingForParts;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 201;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Keeps both positioners lowered while feeding material.
        // Each conveyor stops independently when its part
        // reaches the assembly position.
        // -----------------------------------------------------

		E_AssemblerState.WaitingForParts:
		
			// Keep both positioning assemblies lowered.
			// Feed each conveyor independently until its part arrives.
		
			xBasesConveyorCmd := NOT xBaseAtPlace;
			xLidsConveyorCmd := NOT xLidAtPlace;
		
			IF xBaseAtPlace
			AND xLidAtPlace THEN
		
				eState := E_AssemblerState.ClampingParts;
		
			ELSIF fbFeedTimeout.Q THEN
				uiFaultCode := 101;
				eState := E_AssemblerState.Faulted;
			END_IF;

        // -----------------------------------------------------
        // Secure both parts before the picker moves.
        // -----------------------------------------------------

        E_AssemblerState.ClampingParts:

			// Continue conveying each detected part into its clamp.
			// Stop each conveyor independently once clamped.
		
			xBaseClampCmd := TRUE;
			xBasesConveyorCmd := NOT xBaseClamped;
			xLidClampCmd := TRUE;
			xLidsConveyorCmd := NOT xLidClamped;
		
			IF xBaseClamped
			AND xLidClamped THEN
		
				eState := E_AssemblerState.LoweringToLid;
		
			ELSIF fbClampTimeout.Q THEN
				uiFaultCode := 102;
				eState := E_AssemblerState.Faulted;
			END_IF;

        // -----------------------------------------------------
        // Lower the picker onto the clamped lid.
        // -----------------------------------------------------

        E_AssemblerState.LoweringToLid:

            xBaseClampCmd := TRUE;
            
            xLidClampCmd := TRUE;
            
            xMoveZCmd := TRUE;

            IF xMovingZ THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingZ THEN
                eState := E_AssemblerState.GrippingLid;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 202;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Energise the suction cup and confirm the lid.
        // -----------------------------------------------------

        E_AssemblerState.GrippingLid:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            xLidClampCmd := TRUE;
            
            xMoveZCmd := TRUE;

            IF fbGrabSettle.Q THEN
                eState := E_AssemblerState.ReleasingLidClamp;

            ELSIF fbGrabTimeout.Q THEN
                uiFaultCode := 203;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Release the lid clamp while suction retains the lid.
        // -----------------------------------------------------

        E_AssemblerState.ReleasingLidClamp:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            
            xMoveZCmd := TRUE;

            IF NOT xLidClamped THEN
                eState := E_AssemblerState.RaisingLid;

            ELSIF fbClampTimeout.Q THEN
                uiFaultCode := 204;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Raise the collected lid.
        // -----------------------------------------------------

        E_AssemblerState.RaisingLid:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            

            IF xMovingZ THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingZ THEN
                eState := E_AssemblerState.MovingToBase;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 205;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Transfer from the home position above the lid to the
        // assembly position above the base.
        // -----------------------------------------------------

        E_AssemblerState.MovingToBase:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            
            xMoveXCmd := TRUE;

            IF xMovingX THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingX THEN
                eState := E_AssemblerState.LoweringToBase;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 206;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Lower the lid onto the clamped base.
        // -----------------------------------------------------

        E_AssemblerState.LoweringToBase:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            
            xMoveXCmd := TRUE;
            xMoveZCmd := TRUE;

            IF xMovingZ THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingZ THEN
                eState := E_AssemblerState.ReleasingLid;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 207;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Release suction. Correct physical alignment causes
        // Factory I/O to join the lid and base automatically.
        // -----------------------------------------------------

        E_AssemblerState.ReleasingLid:

            xBaseClampCmd := TRUE;
            
            
            xMoveXCmd := TRUE;
            xMoveZCmd := TRUE;

            IF fbReleaseSettle.Q THEN
                eState := E_AssemblerState.RaisingFromBase;
            END_IF;

        // -----------------------------------------------------
        // Raise clear of the assembled product.
        // -----------------------------------------------------

        E_AssemblerState.RaisingFromBase:

            xBaseClampCmd := TRUE;
            
            
            xMoveXCmd := TRUE;

            IF xMovingZ THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingZ THEN
                eState := E_AssemblerState.ReturningHome;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 208;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Return to the default position above the lid.
        // -----------------------------------------------------

        E_AssemblerState.ReturningHome:

            xBaseClampCmd := TRUE;
            
            

            IF xMovingX THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingX THEN
                eState := E_AssemblerState.ReleasingProduct;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 209;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Release the base clamp and raise the base positioner.
        // The finished product exits along the base conveyor.
        // -----------------------------------------------------

        E_AssemblerState.ReleasingProduct:

			// Release the base clamp through its default FALSE command
			// and raise the positioning assembly clear of the product.
		
			xBasesPositionerRaiseCmd := TRUE;
		
			IF xBasesPositionerAtLimit THEN
				eState := E_AssemblerState.WaitingForProductExit;
		
			ELSIF fbMotionTimeout.Q THEN
				uiFaultCode := 210; // Base positioner failed to raise.
				eState := E_AssemblerState.Faulted;
			END_IF;

        // -----------------------------------------------------
        // Wait for the downstream sensor. Its rising edge gives
        // exactly one count for each completed product.
        // -----------------------------------------------------

        E_AssemblerState.WaitingForProductExit:

			// Once clearance has been confirmed, keep the conveyors
			// running without continuously depending on the limit signal.
		
			xBasesConveyorCmd := TRUE;
			xBasesPositionerRaiseCmd := TRUE;
			xLidsConveyorCmd := NOT xLidAtPlace;
		
			IF rtPartLeaving.Q THEN
		
				diProductsCompleted :=
					diProductsCompleted + 1;
		
				xProductCompletePulse := TRUE;
				eState := E_AssemblerState.WaitingForParts;
		
			ELSIF fbMotionTimeout.Q THEN
				uiFaultCode := 301;
				eState := E_AssemblerState.Faulted;
			END_IF;

        // -----------------------------------------------------
        // Latched safe state.
        // -----------------------------------------------------

        E_AssemblerState.Faulted:

        // -----------------------------------------------------
        // Corrupted or unexpected enumeration value.
        // -----------------------------------------------------

        ELSE

            uiFaultCode := 999;
            eState := E_AssemblerState.Faulted;

    END_CASE;

END_IF;

// =============================================================
// STATUS OUTPUTS
// =============================================================

xFaulted :=
    eState = E_AssemblerState.Faulted;

xReady :=
    xEnable
    AND (eState = E_AssemblerState.WaitingForParts);

xBusy :=
    xEnable
    AND (eState &lt;&gt; E_AssemblerState.Stopped)
    AND (eState &lt;&gt; E_AssemblerState.WaitingForParts)
    AND (eState &lt;&gt; E_AssemblerState.Faulted);

// Ensure every physical command is de-energised after a fault.
IF xFaulted THEN
    xBaseClampCmd := FALSE;
    xBasesConveyorCmd := FALSE;
    xBasesPositionerRaiseCmd := FALSE;
    xGrabCmd := FALSE;
    xLidClampCmd := FALSE;
    xLidsConveyorCmd := FALSE;
    xMoveXCmd := FALSE;
    xMoveZCmd := FALSE;
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">13402619-098e-4bb9-b3ca-6298314c18dc_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_AssemblerCell
VAR_INPUT
    tClampTimeout       : TIME;
    tFeedTimeout        : TIME;
    tGrabSettle         : TIME;
    tHomeSettle         : TIME;
    tMotionTimeout      : TIME;
    tProductExitTimeout : TIME;
    tReleaseSettle      : TIME;

    xBaseAtPlace            : BOOL;
    xBaseClamped            : BOOL;
    xBasesPositionerAtLimit : BOOL;
    xEnable                 : BOOL;
    xItemDetected           : BOOL;
    xLidAtPlace             : BOOL;
    xLidClamped             : BOOL;
    xMovingX                : BOOL;
    xMovingZ                : BOOL;
    xPartLeaving            : BOOL;
    xReset                  : BOOL;
END_VAR

VAR_OUTPUT
    diProductsCompleted : DINT;
    eState              : E_AssemblerState;
    uiFaultCode         : UINT;

    xBaseClampCmd            : BOOL;
    xBasesConveyorCmd        : BOOL;
    xBasesPositionerRaiseCmd : BOOL;
    xBusy                    : BOOL;
    xFaulted                 : BOOL;
    xGrabCmd                 : BOOL;
    xLidClampCmd             : BOOL;
    xLidsConveyorCmd         : BOOL;
    xMoveXCmd                : BOOL;
    xMoveZCmd                : BOOL;
    xProductCompletePulse    : BOOL;
    xReady                   : BOOL;
END_VAR

VAR
    ePreviousState : E_AssemblerState :=
        E_AssemblerState.Stopped;

    fbClampTimeout       : TON;
    fbFeedTimeout        : TON;
    fbGrabSettle         : TON;
    fbGrabTimeout        : TON;
    fbHomeSettle         : TON;
    fbMotionTimeout      : TON;
    fbProductExitTimeout : TON;
    fbReleaseSettle      : TON;

    rtPartLeaving : R_TRIG;

    xMotionObserved : BOOL;
    xStateChanged   : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">13402619-098e-4bb9-b3ca-6298314c18dc_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">712</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">bff20d56-5146-47eb-9d1f-9e1e4c6e1a1e</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">cfdc7eb5-fe54-45da-ab56-b52350dbca90</Single>
        <Single Name="ParentGuid" Type="System.Guid">bff20d56-5146-47eb-9d1f-9e1e4c6e1a1e</Single>
        <Single Name="Name" Type="string">FB_OperatorControl</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639221278868101765</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// EDGE DETECTION
// =============================================================

rtReset(CLK := xResetPB);
rtStart(CLK := xStartPB);
rtStop(CLK := xStopPB);

// =============================================================
// OPERATING-MODE VALIDATION
//
// Exactly one selector position must be active.
// =============================================================

xAutoModeValid :=
    xAutoModeSelected
    AND NOT xManualModeSelected;

// Reset is a one-scan event.
xResetPulse := FALSE;

// =============================================================
// OPERATOR COMMAND PRIORITIES
// =============================================================

IF xEmergencyStop THEN

    // Reset cannot bypass an active emergency stop.
    xResetRequired := TRUE;
    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF rtReset.Q THEN

    // Reset clears latched faults but does not restart the plant.
    xResetPulse := TRUE;
    xResetRequired := FALSE;
    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF xPlantFaulted THEN

    xResetRequired := TRUE;
    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF NOT xAutoModeValid THEN

    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF rtStop.Q THEN

    // Request a controlled stop. Automatic operation remains
	// enabled until the current product reaches the safe boundary.
	// A subsequent Start may resume without Reset.
    IF xSafeToStop THEN
        xRunLatched := FALSE;
        xStopPending := FALSE;
    ELSE
        xStopPending := TRUE;
    END_IF;

ELSIF xStopPending AND xSafeToStop THEN

    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF rtStart.Q
AND xFactoryIORunning
AND NOT xFactoryIOPaused
AND NOT xResetRequired THEN

    xRunLatched := TRUE;
    xStopPending := FALSE;

END_IF;

// =============================================================
// FINAL AUTOMATIC-SEQUENCE PERMISSION
// =============================================================

xEnableAutomatic :=
    xRunLatched
    AND xAutoModeValid
    AND xFactoryIORunning
    AND NOT xEmergencyStop
    AND NOT xFactoryIOPaused
    AND NOT xPlantFaulted
    AND NOT xResetRequired;</Single>
