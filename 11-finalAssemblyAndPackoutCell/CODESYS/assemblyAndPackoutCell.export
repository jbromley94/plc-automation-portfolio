VAR
    diProductsCompleted : DINT;

    eAssemblerState : E_AssemblerState;

    fbAssemblerCell : FB_AssemblerCell;
    fbOperator      : FB_OperatorControl;

    uiAssemblerFaultCode : UINT;

    xAssemblerBusy             : BOOL;
    xAssemblerFaulted          : BOOL;
    xAssemblerReady            : BOOL;
    xBaseClampCmd              : BOOL;
    xBasesConveyorCmd          : BOOL;
    xBasesPositionerRaiseCmd   : BOOL;
    xEnableAutomatic           : BOOL;
    xGrabCmd                   : BOOL;
    xLidClampCmd               : BOOL;
    xLidsConveyorCmd           : BOOL;
    xMoveXCmd                  : BOOL;
    xMoveZCmd                  : BOOL;
    xPlantFaulted              : BOOL;
    xProductCompletePulse      : BOOL;
	xRecoveryResetRequired 	   : BOOL;
    xResetPulse                : BOOL;
    xResetRequired             : BOOL;
    xRunLatched                : BOOL;
	xStopPending 			   : BOOL;
END_VAR</Single>
