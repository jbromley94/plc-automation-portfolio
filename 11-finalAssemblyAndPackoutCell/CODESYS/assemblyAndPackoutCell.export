          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">TYPE E_AssemblerState :
(
    Stopped                := 0,
    Homing                 := 10,
    WaitingForParts        := 20,
    ClampingParts          := 30,
    LoweringToLid          := 40,
    GrippingLid            := 50,
    ReleasingLidClamp      := 60,
    RaisingLid             := 70,
    MovingToBase           := 80,
    LoweringToBase         := 90,
    ReleasingLid           := 100,
    RaisingFromBase        := 110,
    ReturningHome          := 120,
    ReleasingProduct       := 130,
    WaitingForProductExit  := 140,
    Faulted                := 900
);
END_TYPE</Single>
