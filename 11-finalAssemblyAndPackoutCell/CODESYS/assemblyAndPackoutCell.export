            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// 1. PLANT FAULT STATUS FROM THE PREVIOUS PLC SCAN
// =============================================================

xPlantFaulted :=
    xAssemblerFaulted;

// =============================================================
// 2. OPERATOR CONTROL
// Commands may originate from either CODESYS commissioning
// variables or the physical Factory I/O control panel.
// =============================================================

// Preserve the pre-reset recovery requirement for this scan.
xRecoveryResetRequired :=
xResetRequired;

fbOperator(
    xAutoModeSelected :=
        FIO.xAutoModeSelected,

    xEmergencyStop :=
        NOT FIO.xEmergencyStop,

    xFactoryIOPaused :=
        FIO.xFactoryIOPaused,

    xFactoryIORunning :=
        FIO.xFactoryIORunning,

    xManualModeSelected :=
        FIO.xManualModeSelected,

    xPlantFaulted :=
        xPlantFaulted,

    xResetPB :=
        Commands.xResetPB
        OR FIO.xFactoryIOReset
        OR FIO.xResetPB,

	xSafeToStop :=
		xProductCompletePulse,
		
    xStartPB :=
        Commands.xStartPB
        OR FIO.xStartPB,

    xStopPB :=
        Commands.xStopPB
        OR NOT FIO.xStopPB,

    xEnableAutomatic =&gt;
        xEnableAutomatic,

    xResetPulse =&gt;
        xResetPulse,

    xResetRequired =&gt;
        xResetRequired,

    xRunLatched =&gt;
        xRunLatched,
		
	xStopPending =&gt;
    	xStopPending
);

// =============================================================
// 3. ASSEMBLER CELL
// =============================================================

fbAssemblerCell(
    tClampTimeout :=
        AssemblyConstants.tAssemblerClampTimeout,

    tFeedTimeout :=
        AssemblyConstants.tAssemblerFeedTimeout,

    tGrabSettle :=
        AssemblyConstants.tAssemblerGrabSettle,

    tHomeSettle :=
        AssemblyConstants.tAssemblerHomeSettle,

    tMotionTimeout :=
        AssemblyConstants.tAssemblerMotionTimeout,

    tProductExitTimeout :=
        AssemblyConstants.tAssemblerProductExitTimeout,

    tReleaseSettle :=
        AssemblyConstants.tAssemblerReleaseSettle,

    xBaseAtPlace :=
        FIO.xBaseAtPlace,

    xBaseClamped :=
        FIO.xBaseClamped,

    xBasesPositionerAtLimit :=
        FIO.xBasesPositionerAtLimit,

    xEnable :=
        xEnableAutomatic,

    xItemDetected :=
        FIO.xItemDetected,

    xLidAtPlace :=
        FIO.xLidAtPlace,

    xLidClamped :=
        FIO.xLidClamped,

    xMovingX :=
        FIO.xMovingX,

    xMovingZ :=
        FIO.xMovingZ,

    xPartLeaving :=
        FIO.xPartLeaving,

    xReset :=
        xResetPulse,

    diProductsCompleted =&gt;
        diProductsCompleted,

    eState =&gt;
        eAssemblerState,

    uiFaultCode =&gt;
        uiAssemblerFaultCode,

    xBaseClampCmd =&gt;
        xBaseClampCmd,

    xBasesConveyorCmd =&gt;
        xBasesConveyorCmd,

    xBasesPositionerRaiseCmd =&gt;
        xBasesPositionerRaiseCmd,

    xBusy =&gt;
        xAssemblerBusy,

    xFaulted =&gt;
        xAssemblerFaulted,

    xGrabCmd =&gt;
        xGrabCmd,

    xLidClampCmd =&gt;
        xLidClampCmd,

    xLidsConveyorCmd =&gt;
        xLidsConveyorCmd,

    xMoveXCmd =&gt;
        xMoveXCmd,

    xMoveZCmd =&gt;
        xMoveZCmd,

    xProductCompletePulse =&gt;
        xProductCompletePulse,

    xReady =&gt;
        xAssemblerReady
);

// =============================================================
// 4. FACTORY I/O OUTPUT BOUNDARY
// =============================================================
// -------------------------------------------------------------
// Assembly equipment
// -------------------------------------------------------------

FIO.xBaseClampCmd :=
    xBaseClampCmd;

FIO.xBasesConveyorCmd :=
    xBasesConveyorCmd;

FIO.xBasesPositionerRaiseCmd :=
    xBasesPositionerRaiseCmd;

FIO.xGrabCmd :=
    xGrabCmd;

FIO.xLidClampCmd :=
    xLidClampCmd;

FIO.xLidsConveyorCmd :=
    xLidsConveyorCmd;

FIO.xLidsPositionerRaiseCmd :=
	FALSE;

FIO.xMoveXCmd :=
    xMoveXCmd;

FIO.xMoveZCmd :=
    xMoveZCmd;

// -------------------------------------------------------------
// Emitters and removers
// -------------------------------------------------------------

FIO.xBasesEmitterCmd :=
    xEnableAutomatic;

FIO.xFinishedProductRemoverCmd :=
    xEnableAutomatic;

FIO.xLidsEmitterCmd :=
    xEnableAutomatic;

FIO.xUnusedLidRemoverCmd :=
    xEnableAutomatic;

// -------------------------------------------------------------
// Control-panel lights
// -------------------------------------------------------------

FIO.xResetLightCmd :=
    xResetRequired
    OR xAssemblerFaulted;

FIO.xStartLightCmd :=
    xEnableAutomatic
	AND NOT xStopPending;

FIO.xStopLightCmd :=
    NOT xRunLatched
	OR xStopPending;

// -------------------------------------------------------------
// Product counter display
// -------------------------------------------------------------

FIO.diProductCounterDisplay :=
    diProductsCompleted;

// -------------------------------------------------------------
// Factory I/O simulation controls
// Run, Pause and Camera remain manually controlled.
// The physical scene resets only during abnormal recovery.
// -------------------------------------------------------------

FIO.diFactoryIOCameraPositionCmd :=
    0;

FIO.xFactoryIOPauseCmd :=
    FALSE;

FIO.xFactoryIOResetCmd :=
    xResetPulse
    AND xRecoveryResetRequired;

FIO.xFactoryIORunCmd :=
    FALSE;</Single>
