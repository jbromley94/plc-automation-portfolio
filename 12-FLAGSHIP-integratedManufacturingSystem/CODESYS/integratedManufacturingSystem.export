            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_TransferCoordinator
VAR_INPUT
    tTransferTimeout : TIME := T#20S;
    xAck             : BOOL;
    xEnable          : BOOL;
    xReady           : BOOL;
    xReq             : BOOL;
    xReset           : BOOL;
	xRun 			 : BOOL;
END_VAR
VAR
    fbTransferTimeout : TON;
    xTimeoutEnable    : BOOL;
END_VAR
VAR_OUTPUT
    eState      : E_TransferState := E_TransferState.Idle;
    uiFaultCode : UINT;
    xComplete   : BOOL;
    xFaulted    : BOOL;
    xPermit     : BOOL;
END_VAR</Single>
