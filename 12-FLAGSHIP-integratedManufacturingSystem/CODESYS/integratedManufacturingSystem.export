      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">fbLocalResetEdge(CLK := xLocalResetPB);
fbLocalStartEdge(CLK := xLocalStartPB);
fbMasterRunEdge(CLK := xMasterRun);

// Exactly one unit-panel operating mode must be selected.
xModeValid :=
    xLocalModeSelected XOR xMasterModeSelected;

xLocalModeActive :=
    xLocalModeSelected
    AND NOT xMasterModeSelected;

xMasterModeActive :=
    xMasterModeSelected
    AND NOT xLocalModeSelected;

// One-scan default.
xResetPulse := FALSE;

// Any immediate interlock loss cancels the run latch.
IF NOT xEmergencyStopHealthy
    OR NOT xLocalStopHealthy
    OR NOT xMasterEnable
    OR NOT xModeValid
THEN
    xRunLatched := FALSE;

// Local Reset and Start are accepted in Local mode.
ELSIF xLocalModeActive THEN
    IF fbLocalResetEdge.Q AND NOT xTransferActive THEN
        xResetPulse := TRUE;
        xRunLatched := FALSE;

    ELSIF fbLocalStartEdge.Q THEN
        xRunLatched := TRUE;
    END_IF

// MASTER Start initially starts the zone.
// Following a local Stop, the local Start button deliberately
// allows only this zone to rejoin the running plant.
ELSIF xMasterModeActive THEN
    xResetPulse := xMasterResetPulse;

    IF NOT xMasterRun THEN
        xRunLatched := FALSE;

    ELSIF fbMasterRunEdge.Q THEN
        xRunLatched := TRUE;

    ELSIF fbLocalStartEdge.Q THEN
        xRunLatched := TRUE;
    END_IF
END_IF

// Both the MASTER selector and the unit selector must agree.
xEnable :=
    xEmergencyStopHealthy
    AND xLocalStopHealthy
    AND xMasterEnable
    AND xModeValid
    AND (
        (xLocalModeActive AND xMasterManualModeActive)
        OR
        (xMasterModeActive AND xMasterAutoModeActive)
    );

// Select the permitted run authority.
IF xLocalModeActive THEN
    xRun := xEnable AND xRunLatched;

ELSIF xMasterModeActive THEN
    xRun :=
        xEnable
        AND xMasterRun
        AND xRunLatched;

ELSE
    xRun := FALSE;
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">ffcc4db5-4bfb-4d61-9ab4-b9139b121cdd_Impl_LineIds</Single>
