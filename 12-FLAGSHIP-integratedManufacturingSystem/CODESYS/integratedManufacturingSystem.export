            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_UnitOperatorControl
VAR_INPUT
    xEmergencyStopHealthy   : BOOL;
    xLocalModeSelected      : BOOL;
    xLocalResetPB           : BOOL;
    xLocalStartPB           : BOOL;
    xLocalStopHealthy       : BOOL;
	xMasterAutoModeActive   : BOOL;
    xMasterEnable           : BOOL;
	xMasterManualModeActive : BOOL;
    xMasterModeSelected     : BOOL;
    xMasterResetPulse       : BOOL;
    xMasterRun              : BOOL;
    xTransferActive         : BOOL;
END_VAR
VAR_OUTPUT
    xEnable           : BOOL;
    xLocalModeActive  : BOOL;
    xMasterModeActive : BOOL;
    xResetPulse       : BOOL;
    xRun              : BOOL;
END_VAR
VAR
    fbLocalResetEdge : R_TRIG;
    fbLocalStartEdge : R_TRIG;
    fbMasterRunEdge  : R_TRIG;
    xModeValid       : BOOL;
    xRunLatched      : BOOL;
END_VAR</Single>
