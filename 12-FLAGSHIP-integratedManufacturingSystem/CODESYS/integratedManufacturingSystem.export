	xPackoutCarrierFaulted       : BOOL;
	xPackoutCarrierReady         : BOOL;
	xPackoutFaulted              : BOOL;
	xPackoutLoaderBusy           : BOOL;
	xPackoutLoaderFaulted        : BOOL;
	xPackoutLoaderReady          : BOOL;
	xPackoutReady                : BOOL;

    // PLC to Ignition — process and storage
    eBatchStorageState       : E_BatchStorageState := E_BatchStorageState.Stopped;
    eStorageState            : E_StorageState := E_StorageState.Stopped;
    eTankState               : E_TankState := E_TankState.Stopped;
    rTankLevelPct            : REAL;
    uiRackFreeCount          : UINT;
    uiRackOccupiedCount      : UINT;
    uiRackReservedCount      : UINT;
    uiRackUnknownCount       : UINT;
    uiStorageFaultCode       : UINT;
    wStorageReservedPosition : WORD;
    xPackoutPalletAtLoad     : BOOL;
    xPackoutProductAtPick    : BOOL;
    xPackoutProductLoaded    : BOOL;
    xRackFull                : BOOL;
    xStorageBusy             : BOOL;
    xStorageFaulted          : BOOL;
    xStorageReady            : BOOL;
	
	// Maintained automatic-mode request from Ignition.
	{attribute 'symbol' := 'readwrite'}
	xIgnitionAutoModeReq : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">918acfde-9a06-4169-bb39-2f9ae0648c4c_Decl_LineIds</Single>
          </Single>
        </Single>
        <Null Name="NetVarProperties" />
        <Single Name="ParameterList" Type="bool">False</Single>
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">899ede2a-c92f-4f47-9d5f-dbe1a8e79ad7</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">GVLs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">710e4cb1-3649-4c22-93f4-56a28f65d501</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_AssemblerCell</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224871204938964</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// DEFAULT COMMANDS
//
// Every command must be deliberately enabled by the active state.
// =============================================================

xBaseClampCmd := FALSE;
xBasesConveyorCmd := FALSE;
xBasesPositionerRaiseCmd := FALSE;
xGrabCmd := FALSE;
xLidClampCmd := FALSE;
xLidsConveyorCmd := FALSE;
xMoveXCmd := FALSE;
xMoveZCmd := FALSE;
xProductCompletePulse := FALSE;

// =============================================================
// EDGE AND STATE-ENTRY DETECTION
// =============================================================

rtPartLeaving(CLK := xPartLeaving);

xStateChanged :=
    eState &lt;&gt; ePreviousState;

IF xStateChanged THEN
    ePreviousState := eState;
    xMotionObserved := FALSE;
END_IF;

// =============================================================
// STATE TIMERS
// =============================================================

fbClampTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (
            (eState = E_AssemblerState.ClampingParts)
            OR
            (eState = E_AssemblerState.ReleasingLidClamp)
        ),
    PT := tClampTimeout
);

fbFeedTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (eState = E_AssemblerState.WaitingForParts),
    PT := tFeedTimeout
);

fbGrabSettle(
    IN :=
        xEnable
        AND (eState = E_AssemblerState.GrippingLid)
        AND xItemDetected,
    PT := tGrabSettle
);

fbGrabTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (eState = E_AssemblerState.GrippingLid),
    PT := tMotionTimeout
);

fbHomeSettle(
    IN :=
        xEnable
        AND (eState = E_AssemblerState.Homing)
        AND NOT xMovingX
        AND NOT xMovingZ,
    PT := tHomeSettle
);

fbMotionTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (
            (eState = E_AssemblerState.Homing)
            OR
            (eState = E_AssemblerState.LoweringToLid)
            OR
            (eState = E_AssemblerState.LoweringToBase)
            OR
            (eState = E_AssemblerState.MovingToBase)
            OR
            (eState = E_AssemblerState.RaisingFromBase)
            OR
            (eState = E_AssemblerState.RaisingLid)
            OR
            (eState = E_AssemblerState.ReturningHome)
			OR
			(eState = E_AssemblerState.ReleasingProduct)
        ),
    PT := tMotionTimeout
);	

fbProductExitTimeout(
    IN :=
        xEnable
        AND NOT xStateChanged
        AND (eState = E_AssemblerState.WaitingForProductExit),
    PT := tProductExitTimeout
);

fbReleaseSettle(
    IN :=
        xEnable
        AND (eState = E_AssemblerState.ReleasingLid),
    PT := tReleaseSettle
);

// =============================================================
// RESET AND DISABLED CONDITIONS
// =============================================================

IF xReset THEN

    diProductsCompleted := 0;
    eState := E_AssemblerState.Stopped;
    uiFaultCode := 0;
    xMotionObserved := FALSE;

ELSIF NOT xEnable THEN

    // Fault state remains latched until Reset.
    IF eState &lt;&gt; E_AssemblerState.Faulted THEN
        eState := E_AssemblerState.Stopped;
    END_IF;

// =============================================================
// AUTOMATIC ASSEMBLY SEQUENCE
// =============================================================

ELSE

    CASE eState OF

        // -----------------------------------------------------
        // Begin every enabled run by returning the arm to its
        // default raised position above the lid.
        // -----------------------------------------------------

        E_AssemblerState.Stopped:

            eState := E_AssemblerState.Homing;

        // -----------------------------------------------------
        // Move X = FALSE: above the lid.
        // Move Z = FALSE: raised.
        //
        // The settle timer also handles the case where the arm
        // was already home and therefore produces no movement.
        // -----------------------------------------------------

        E_AssemblerState.Homing:

            IF fbHomeSettle.Q THEN
                eState := E_AssemblerState.WaitingForParts;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 201;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Keeps both positioners lowered while feeding material.
        // Each conveyor stops independently when its part
        // reaches the assembly position.
        // -----------------------------------------------------

		E_AssemblerState.WaitingForParts:
		
			// Keep both positioning assemblies lowered.
			// Feed each conveyor independently until its part arrives.
		
			xBasesConveyorCmd := NOT xBaseAtPlace;
			xLidsConveyorCmd := NOT xLidAtPlace;
		
			IF xBaseAtPlace
			AND xLidAtPlace THEN
		
				eState := E_AssemblerState.ClampingParts;
		
			ELSIF fbFeedTimeout.Q THEN
				uiFaultCode := 101;
				eState := E_AssemblerState.Faulted;
			END_IF;

        // -----------------------------------------------------
        // Secure both parts before the picker moves.
        // -----------------------------------------------------

        E_AssemblerState.ClampingParts:

			// Continue conveying each detected part into its clamp.
			// Stop each conveyor independently once clamped.
		
			xBaseClampCmd := TRUE;
			xBasesConveyorCmd := NOT xBaseClamped;
			xLidClampCmd := TRUE;
			xLidsConveyorCmd := NOT xLidClamped;
		
			IF xBaseClamped
			AND xLidClamped THEN
		
				eState := E_AssemblerState.LoweringToLid;
		
			ELSIF fbClampTimeout.Q THEN
				uiFaultCode := 102;
				eState := E_AssemblerState.Faulted;
			END_IF;

        // -----------------------------------------------------
        // Lower the picker onto the clamped lid.
        // -----------------------------------------------------

        E_AssemblerState.LoweringToLid:

            xBaseClampCmd := TRUE;
            
            xLidClampCmd := TRUE;
            
            xMoveZCmd := TRUE;

            IF xMovingZ THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingZ THEN
                eState := E_AssemblerState.GrippingLid;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 202;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Energise the suction cup and confirm the lid.
        // -----------------------------------------------------

        E_AssemblerState.GrippingLid:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            xLidClampCmd := TRUE;
            
            xMoveZCmd := TRUE;

            IF fbGrabSettle.Q THEN
                eState := E_AssemblerState.ReleasingLidClamp;

            ELSIF fbGrabTimeout.Q THEN
                uiFaultCode := 203;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Release the lid clamp while suction retains the lid.
        // -----------------------------------------------------

        E_AssemblerState.ReleasingLidClamp:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            
            xMoveZCmd := TRUE;

            IF NOT xLidClamped THEN
                eState := E_AssemblerState.RaisingLid;

            ELSIF fbClampTimeout.Q THEN
                uiFaultCode := 204;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Raise the collected lid.
        // -----------------------------------------------------

        E_AssemblerState.RaisingLid:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            

            IF xMovingZ THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingZ THEN
                eState := E_AssemblerState.MovingToBase;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 205;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Transfer from the home position above the lid to the
        // assembly position above the base.
        // -----------------------------------------------------

        E_AssemblerState.MovingToBase:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            
            xMoveXCmd := TRUE;

            IF xMovingX THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingX THEN
                eState := E_AssemblerState.LoweringToBase;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 206;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Lower the lid onto the clamped base.
        // -----------------------------------------------------

        E_AssemblerState.LoweringToBase:

            xBaseClampCmd := TRUE;
            
            xGrabCmd := TRUE;
            
            xMoveXCmd := TRUE;
            xMoveZCmd := TRUE;

            IF xMovingZ THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingZ THEN
                eState := E_AssemblerState.ReleasingLid;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 207;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Release suction. Correct physical alignment causes
        // Factory I/O to join the lid and base automatically.
        // -----------------------------------------------------

        E_AssemblerState.ReleasingLid:

            xBaseClampCmd := TRUE;
            
            
            xMoveXCmd := TRUE;
            xMoveZCmd := TRUE;

            IF fbReleaseSettle.Q THEN
                eState := E_AssemblerState.RaisingFromBase;
            END_IF;

        // -----------------------------------------------------
        // Raise clear of the assembled product.
        // -----------------------------------------------------

        E_AssemblerState.RaisingFromBase:

            xBaseClampCmd := TRUE;
            
            
            xMoveXCmd := TRUE;

            IF xMovingZ THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingZ THEN
                eState := E_AssemblerState.ReturningHome;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 208;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Return to the default position above the lid.
        // -----------------------------------------------------

        E_AssemblerState.ReturningHome:

            xBaseClampCmd := TRUE;
            
            

            IF xMovingX THEN
                xMotionObserved := TRUE;
            END_IF;

            IF xMotionObserved AND NOT xMovingX THEN
                eState := E_AssemblerState.ReleasingProduct;

            ELSIF fbMotionTimeout.Q THEN
                uiFaultCode := 209;
                eState := E_AssemblerState.Faulted;
            END_IF;

        // -----------------------------------------------------
        // Release the base clamp and raise the base positioner.
        // The finished product exits along the base conveyor.
        // -----------------------------------------------------

        E_AssemblerState.ReleasingProduct:

			// Release the base clamp through its default FALSE command
			// and raise the positioning assembly clear of the product.
		
			xBasesPositionerRaiseCmd := TRUE;
		
			IF xBasesPositionerAtLimit THEN
				eState := E_AssemblerState.WaitingForProductExit;
		
			ELSIF fbMotionTimeout.Q THEN
				uiFaultCode := 210; // Base positioner failed to raise.
				eState := E_AssemblerState.Faulted;
			END_IF;

        // -----------------------------------------------------
        // Wait for the downstream sensor. Its rising edge gives
        // exactly one count for each completed product.
        // -----------------------------------------------------

        E_AssemblerState.WaitingForProductExit:

			// Once clearance has been confirmed, keep the conveyors
			// running without continuously depending on the limit signal.
		
			xBasesConveyorCmd := TRUE;
			xBasesPositionerRaiseCmd := TRUE;
			xLidsConveyorCmd := NOT xLidAtPlace;
		
			IF rtPartLeaving.Q THEN
		
				diProductsCompleted :=
					diProductsCompleted + 1;
		
				xProductCompletePulse := TRUE;
				eState := E_AssemblerState.WaitingForParts;
		
			ELSIF fbMotionTimeout.Q THEN
				uiFaultCode := 301;
				eState := E_AssemblerState.Faulted;
			END_IF;

        // -----------------------------------------------------
        // Latched safe state.
        // -----------------------------------------------------

        E_AssemblerState.Faulted:

        // -----------------------------------------------------
        // Corrupted or unexpected enumeration value.
        // -----------------------------------------------------

        ELSE

            uiFaultCode := 999;
            eState := E_AssemblerState.Faulted;

    END_CASE;

END_IF;

// =============================================================
// STATUS OUTPUTS
// =============================================================

xFaulted :=
    eState = E_AssemblerState.Faulted;

xReady :=
    xEnable
    AND (eState = E_AssemblerState.WaitingForParts);

xBusy :=
    xEnable
    AND (eState &lt;&gt; E_AssemblerState.Stopped)
    AND (eState &lt;&gt; E_AssemblerState.WaitingForParts)
    AND (eState &lt;&gt; E_AssemblerState.Faulted);

// Ensure every physical command is de-energised after a fault.
IF xFaulted THEN
    xBaseClampCmd := FALSE;
    xBasesConveyorCmd := FALSE;
    xBasesPositionerRaiseCmd := FALSE;
    xGrabCmd := FALSE;
    xLidClampCmd := FALSE;
    xLidsConveyorCmd := FALSE;
    xMoveXCmd := FALSE;
    xMoveZCmd := FALSE;
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">710e4cb1-3649-4c22-93f4-56a28f65d501_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_AssemblerCell
VAR_INPUT
    tClampTimeout       : TIME;
    tFeedTimeout        : TIME;
    tGrabSettle         : TIME;
    tHomeSettle         : TIME;
    tMotionTimeout      : TIME;
    tProductExitTimeout : TIME;
    tReleaseSettle      : TIME;

    xBaseAtPlace            : BOOL;
    xBaseClamped            : BOOL;
    xBasesPositionerAtLimit : BOOL;
    xEnable                 : BOOL;
    xItemDetected           : BOOL;
    xLidAtPlace             : BOOL;
    xLidClamped             : BOOL;
    xMovingX                : BOOL;
    xMovingZ                : BOOL;
    xPartLeaving            : BOOL;
    xReset                  : BOOL;
END_VAR

VAR_OUTPUT
    diProductsCompleted : DINT;
    eState              : E_AssemblerState;
    uiFaultCode         : UINT;

    xBaseClampCmd            : BOOL;
    xBasesConveyorCmd        : BOOL;
    xBasesPositionerRaiseCmd : BOOL;
    xBusy                    : BOOL;
    xFaulted                 : BOOL;
    xGrabCmd                 : BOOL;
    xLidClampCmd             : BOOL;
    xLidsConveyorCmd         : BOOL;
    xMoveXCmd                : BOOL;
    xMoveZCmd                : BOOL;
    xProductCompletePulse    : BOOL;
    xReady                   : BOOL;
END_VAR

VAR
    ePreviousState : E_AssemblerState :=
        E_AssemblerState.Stopped;

    fbClampTimeout       : TON;
    fbFeedTimeout        : TON;
    fbGrabSettle         : TON;
    fbGrabTimeout        : TON;
    fbHomeSettle         : TON;
    fbMotionTimeout      : TON;
    fbProductExitTimeout : TON;
    fbReleaseSettle      : TON;

    rtPartLeaving : R_TRIG;

    xMotionObserved : BOOL;
    xStateChanged   : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">710e4cb1-3649-4c22-93f4-56a28f65d501_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">1203</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">POUs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">e1011072-3fb4-4575-a602-339d3f080bcf</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_AssemblyUnit</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224877679529307</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// ASSEMBLER CELL
// =============================================================

fbAssemblerCell(
    tClampTimeout := T#5S,
    tFeedTimeout := T#10M,
    tGrabSettle := T#300MS,
    tHomeSettle := T#500MS,
    tMotionTimeout := T#10S,
    tProductExitTimeout := T#30S,
    tReleaseSettle := T#300MS,

    xBaseAtPlace := xBaseAtPlace,
    xBaseClamped := xBaseClamped,
    xBasesPositionerAtLimit := xBasesPositionerAtLimit,
    xEnable := xEnable AND xRun,
    xItemDetected := xItemDetected,
    xLidAtPlace := xLidAtPlace,
    xLidClamped := xLidClamped,
    xMovingX := xMovingX,
    xMovingZ := xMovingZ,
    xPartLeaving := xProductAtOutfeed,
    xReset := xReset
);

// =============================================================
// PHYSICAL COMMAND AND STATUS BOUNDARY
// =============================================================

diProductCount :=
    fbAssemblerCell.diProductsCompleted;

eState :=
    fbAssemblerCell.eState;

uiFaultCode :=
    fbAssemblerCell.uiFaultCode;

xBaseClampCmd :=
    fbAssemblerCell.xBaseClampCmd;

xBasesConveyorCmd :=
    fbAssemblerCell.xBasesConveyorCmd;

xBasesPositionerRaiseCmd :=
    fbAssemblerCell.xBasesPositionerRaiseCmd;

xFaulted :=
    fbAssemblerCell.xFaulted;

xGrabCmd :=
    fbAssemblerCell.xGrabCmd;

xLidClampCmd :=
    fbAssemblerCell.xLidClampCmd;

xLidsConveyorCmd :=
    fbAssemblerCell.xLidsConveyorCmd;

xMoveXCmd :=
    fbAssemblerCell.xMoveXCmd;

xMoveZCmd :=
    fbAssemblerCell.xMoveZCmd;

// =============================================================
// UNIT-TO-UNIT HANDSHAKES
// =============================================================

xPairAck := FALSE;
xPairReady := FALSE;
xProductReq := FALSE;
xReady := FALSE;

// Reset clears only the wrapper transaction memory.
// The child cell receives the same reset above.
IF xReset THEN
    xProductPending := FALSE;
    xWaitForOutfeedClear := FALSE;

// A complete disable abandons the pending transaction.
ELSIF NOT xEnable THEN
    xProductPending := FALSE;
    xWaitForOutfeedClear := FALSE;

ELSIF xRun THEN
    // Both physical arrival proofs acknowledge the P10-to-P11
    // pair transfer.
    xPairAck :=
        xBaseAtPlace
        AND xLidAtPlace;

    // Assembly can accept a new pair only while the proven cell
    // is waiting and both assembly positions are empty.
    xPairReady :=
        fbAssemblerCell.xReady
        AND NOT xBaseAtPlace
        AND NOT xLidAtPlace
        AND NOT xProductPending
        AND NOT xWaitForOutfeedClear;

    // Latch one completed product transaction at the outfeed.
    IF NOT xProductPending
        AND NOT xWaitForOutfeedClear
        AND xProductAtOutfeed
    THEN
        xProductPending := TRUE;
    END_IF;

    // Packout acknowledgement completes the transaction.
    IF xProductPending
        AND xProductTransferAck
    THEN
        xProductPending := FALSE;
        xWaitForOutfeedClear := TRUE;
    END_IF;

    // Require the outfeed proof to clear before accepting another
    // completed product.
    IF xWaitForOutfeedClear
        AND NOT xProductAtOutfeed
    THEN
        xWaitForOutfeedClear := FALSE;
    END_IF;

    xProductReq := xProductPending;
    xReady := xPairReady;
END_IF;

// Include both physical activity and the downstream transaction.
xBusy :=
    fbAssemblerCell.xBusy
    OR xProductPending
    OR xWaitForOutfeedClear;

// A fault removes every unit-boundary permission.
IF xFaulted THEN
    xPairAck := FALSE;
    xPairReady := FALSE;
    xProductReq := FALSE;
    xReady := FALSE;
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">e1011072-3fb4-4575-a602-339d3f080bcf_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_AssemblyUnit
VAR_INPUT
    xBaseAtPlace             : BOOL;
    xBaseClamped             : BOOL;
    xBasesPositionerAtLimit  : BOOL;
    xEnable                  : BOOL;
    xItemDetected            : BOOL;
    xLidAtPlace              : BOOL;
    xLidClamped              : BOOL;
    xMovingX                 : BOOL;
    xMovingZ                 : BOOL;
    xProductAtOutfeed        : BOOL;
    xProductTransferAck      : BOOL;
    xReset                   : BOOL;
    xRun                     : BOOL;
END_VAR

VAR_OUTPUT
    diProductCount              : DINT;
    eState                      : E_AssemblerState :=
        E_AssemblerState.Stopped;
    uiFaultCode                 : UINT;

    xBaseClampCmd               : BOOL;
    xBasesConveyorCmd           : BOOL;
    xBasesPositionerRaiseCmd    : BOOL;
    xBusy                       : BOOL;
    xFaulted                    : BOOL;
    xGrabCmd                    : BOOL;
    xLidClampCmd                : BOOL;
    xLidsConveyorCmd            : BOOL;
    xMoveXCmd                   : BOOL;
    xMoveZCmd                   : BOOL;
    xPairAck                    : BOOL;
    xPairReady                  : BOOL;
    xProductReq                 : BOOL;
    xReady                      : BOOL;
END_VAR

VAR
    fbAssemblerCell      : FB_AssemblerCell;
    xProductPending      : BOOL;
    xWaitForOutfeedClear : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">e1011072-3fb4-4575-a602-339d3f080bcf_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">324</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">POUs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">a32b42f8-55ef-4b02-b6a1-3a2aa06a7f5a</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_BatchStorageUnit</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639225284394595697</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Tank batch production and discharge.
fbTank(
    rEmptySetpointPct := 5.0,
    rFillSetpointPct := 80.0,
    rLevelPct := rTankLevelV * 10.0,
    tDischargeTimeout := T#30M,
	tFillTimeout := T#30M,

    xDischargePermit :=
        xRun
        AND
        (eState = E_BatchStorageState.DischargingBatch),

    xEnable := xEnable,
    xLevelHighHigh := xTankLevelHighHigh,
    xReset := xReset,

    xStartBatchReq :=
        xRun
        AND (
            (eState = E_BatchStorageState.ReservingSlot)
            OR
            (eState = E_BatchStorageState.WaitingForBatch)
            OR
            (eState = E_BatchStorageState.DischargingBatch)
        )
);

eTankState := fbTank.eState;
xTankDischargeValveCmd := fbTank.xDischargeValveCmd;
xTankFillValveCmd := fbTank.xFillValveCmd;

// Rack inventory and reservation ownership.
fbRackManager(
    xCommitRequest :=
        eState = E_BatchStorageState.CommittingInventory,

    xEnable :=
        xEnable
        AND xRun,

    // Until the crane sequence provides a more precise deposit proof,
    // any reset after entering storage is handled conservatively.
    xReservationMayBeOccupied :=
        (eState = E_BatchStorageState.StoringProduct)
        OR
        (eState = E_BatchStorageState.CommittingInventory)
        OR
        (eState = E_BatchStorageState.WaitingForStorageComplete),

    xReserveRequest :=
        eState = E_BatchStorageState.ReservingSlot,

    xReset := xReset
);

// Automated rack-storage sequence.
fbStorage(
    tLiftTime := T#2S,
    tLowerTime := T#2S,
    tStepTimeout := T#2M,
    wHomePosition := wStorageHomePosition,
    wReservedPosition := fbRackManager.wReservedPosition,
    xCraneAtHome := xStorageCraneAtHome,
    xEnable := xEnable,
    xForkAtLeft := xStorageForkAtLeft,
    xForkAtMiddle := xStorageForkAtMiddle,
    xForkAtRight := xStorageForkAtRight,
    xMovingX := xStorageMovingX,
    xMovingZ := xStorageMovingZ,
    xProductAtLoad := xStorageProductAtLoad,
    xReservationValid := fbRackManager.xReservationValid,
    xReset := xReset,
    xRun := xRun,
    xStoreRequest :=
        eState = E_BatchStorageState.StoringProduct
);

// Publish storage status and requested commands.
eStorageState := fbStorage.eState;
uiStorageFaultCode := fbStorage.uiFaultCode;
wStorageTargetPositionCmd := fbStorage.wTargetPositionCmd;
xStorageBusy := fbStorage.xBusy;
xStorageDepositComplete := fbStorage.xDepositComplete;
xStorageEntryConveyorCmd := fbStorage.xEntryConveyorCmd;
xStorageFaulted := fbStorage.xFaulted;
xStorageForksLeftCmd := fbStorage.xForksLeftCmd;
xStorageForksRightCmd := fbStorage.xForksRightCmd;
xStorageLiftCmd := fbStorage.xLiftCmd;
xStorageLoadConveyorCmd := fbStorage.xLoadConveyorCmd;
xStorageReady := fbStorage.xReady;
xStorageStoreComplete := fbStorage.xStoreComplete;

// Publish the rack manager's authoritative values.
uiRackFreeCount := fbRackManager.uiFreeCount;
uiRackOccupiedCount := fbRackManager.uiOccupiedCount;
uiRackReservedCount := fbRackManager.uiReservedCount;
uiRackUnknownCount := fbRackManager.uiUnknownCount;
wRackReservedPosition := fbRackManager.wReservedPosition;
xRackCommitAck := fbRackManager.xCommitAck;
xRackFull := fbRackManager.xRackFull;
xRackReservationValid := fbRackManager.xReservationValid;

// Safe output defaults.
xTankTransferConveyorsCmd := FALSE;

IF xReset THEN
    eState := E_BatchStorageState.Stopped;
    uiFaultCode := 0;
    xBusy := FALSE;
    xCarrierAccepted := FALSE;
    xFaulted := FALSE;
    xProductTransferAck := FALSE;
    xProductTransferReady := FALSE;
    xReady := FALSE;
    xTransactionActive := FALSE;

ELSIF NOT xEnable THEN
    // Preserve the transaction and reservation while the zone is stopped.
    xBusy :=
        xTransactionActive
        OR (eState = E_BatchStorageState.DischargingBatch)
        OR (eState = E_BatchStorageState.StoringProduct)
        OR (eState = E_BatchStorageState.CommittingInventory);

    xFaulted := eState = E_BatchStorageState.Faulted;
    xProductTransferAck := xCarrierAccepted;
    xProductTransferReady := FALSE;
    xReady := FALSE;

ELSE
    CASE eState OF

        E_BatchStorageState.Stopped:
            xBusy := FALSE;
            xFaulted := FALSE;
            xProductTransferAck := FALSE;
            xProductTransferReady := FALSE;
            xReady := FALSE;

            eState := E_BatchStorageState.ReservingSlot;


        E_BatchStorageState.ReservingSlot:
			xBusy := FALSE;
			xProductTransferAck := FALSE;
			xProductTransferReady := FALSE;
			xReady := FALSE;
		
			IF fbRackManager.xReserveAck THEN
				IF fbRackManager.xReservationValid THEN
					xReady := TRUE;
					eState := E_BatchStorageState.WaitingForBatch;
		
				ELSIF fbRackManager.xRackFull THEN
					uiFaultCode := 620;
					xFaulted := TRUE;
					eState := E_BatchStorageState.Faulted;
				END_IF;
			END_IF


        E_BatchStorageState.WaitingForBatch:
            xBusy := xTransactionActive;
            xReady := TRUE;

            // P9 accepts only one loaded carrier at a time.
            xProductTransferReady :=
				fbTank.xBatchReady
				AND xRun
				AND NOT xTransactionActive
				AND NOT xTankCarrierAtFill;

            IF xProductTransferReq
                AND xProductTransferReady
                AND xPackoutPalletAtLoad
                AND xPackoutProductLoaded
            THEN
                xTransactionActive := TRUE;
                xBusy := TRUE;
            END_IF
			
			// Move the accepted loaded carrier from Packout to the tank.
			xTankTransferConveyorsCmd :=
				xRun
				AND xTransactionActive
				AND NOT xTankCarrierAtFill;

            // Physical arrival at the tank station acknowledges transfer.
            IF xRun
				AND xTransactionActive
				AND xTankCarrierAtFill
			THEN
				xCarrierAccepted := TRUE;
				xProductTransferAck := TRUE;
			END_IF

            // Hold acknowledgement until the upstream request clears.
            IF xRun
				AND xCarrierAccepted
				AND NOT xProductTransferReq
			THEN
				xProductTransferAck := FALSE;
				xCarrierAccepted := FALSE;
				eState := E_BatchStorageState.DischargingBatch;
			END_IF


        E_BatchStorageState.DischargingBatch:
            xBusy := TRUE;
            xProductTransferReady := FALSE;
            xReady := FALSE;

            // Temporary proof that the tank has received material.
            // Real filling/discharge thresholds will come from FB_Tank.
            IF xRun AND fbTank.xDischargeComplete THEN
				eState := E_BatchStorageState.StoringProduct;
			END_IF


        E_BatchStorageState.StoringProduct:
            xBusy := TRUE;
            xProductTransferReady := FALSE;
            xReady := FALSE;

           // Move the discharged carrier from the tank to the
			// single storage-entry staging position.
			xTankTransferConveyorsCmd :=
				xRun
				AND NOT xStorageAtEntry;
			
			// Inventory is committed only after the storage module
            // has deposited the carrier and returned home.
            IF xRun AND fbStorage.xStoreComplete THEN
                eState :=
                    E_BatchStorageState.CommittingInventory;
            END_IF


        E_BatchStorageState.CommittingInventory:
			xBusy := TRUE;
			xProductTransferReady := FALSE;
			xReady := FALSE;
		
			IF xRun AND fbRackManager.xCommitAck THEN
				eState :=
					E_BatchStorageState.WaitingForStorageComplete;
			END_IF

        E_BatchStorageState.WaitingForStorageComplete:
			xBusy := FALSE;
			xProductTransferReady := FALSE;
			xReady := FALSE;
		
			IF xRun THEN
				// Begin reservation for the next single plant transaction.
				xTransactionActive := FALSE;
				eState := E_BatchStorageState.ReservingSlot;
			END_IF


        E_BatchStorageState.Faulted:
            xBusy := FALSE;
            xFaulted := TRUE;
            xProductTransferAck := FALSE;
            xProductTransferReady := FALSE;
            xReady := FALSE;


    ELSE
        uiFaultCode := 699;
        xFaulted := TRUE;
        eState := E_BatchStorageState.Faulted;

    END_CASE
END_IF

IF fbRackManager.xFaulted THEN
    uiFaultCode := 621;
    xFaulted := TRUE;
    eState := E_BatchStorageState.Faulted;
END_IF;

IF fbTank.xFaulted THEN
    uiFaultCode := 610;
    xFaulted := TRUE;
    eState := E_BatchStorageState.Faulted;
END_IF

IF fbStorage.xFaulted THEN
    uiFaultCode := 630;
    xFaulted := TRUE;
    eState := E_BatchStorageState.Faulted;
END_IF

IF xFaulted THEN
    xBusy := FALSE;
    xProductTransferAck := FALSE;
    xProductTransferReady := FALSE;
    xReady := FALSE;
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">a32b42f8-55ef-4b02-b6a1-3a2aa06a7f5a_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_BatchStorageUnit
VAR_INPUT
    rTankLevelV             : REAL;
	wStorageHomePosition    : WORD := 55;
    xStorageCraneAtHome     : BOOL;
    xStorageForkAtLeft      : BOOL;
    xStorageForkAtMiddle    : BOOL;
    xStorageForkAtRight     : BOOL;
    xStorageMovingX         : BOOL;
    xStorageMovingZ         : BOOL;
    xStorageProductAtLoad   : BOOL;
    xEnable                 : BOOL;
    xPackoutPalletAtLoad    : BOOL;
    xPackoutProductLoaded   : BOOL;
    xProductTransferReq     : BOOL;
    xReset                  : BOOL;
    xRun                    : BOOL;
    xStorageAtEntry         : BOOL;
    xTankCarrierAtFill      : BOOL;
    xTankLevelHighHigh      : BOOL;
END_VAR

VAR_OUTPUT
    eState                    : E_BatchStorageState :=
                                    E_BatchStorageState.Stopped;
	eStorageState             : E_StorageState :=
                                        E_StorageState.Stopped;
    eTankState                : E_TankState :=
                                    E_TankState.Stopped;
    uiFaultCode               : UINT;
    uiRackFreeCount           : UINT;
    uiRackOccupiedCount       : UINT;
    uiRackReservedCount       : UINT;
    uiRackUnknownCount        : UINT;
	uiStorageFaultCode        : UINT;
    wRackReservedPosition     : WORD;
	wStorageTargetPositionCmd : WORD := 55;
    xBusy                     : BOOL;
    xFaulted                  : BOOL;
    xProductTransferAck       : BOOL;
    xProductTransferReady     : BOOL;
    xRackCommitAck            : BOOL;
    xRackFull                 : BOOL;
    xRackReservationValid     : BOOL;
    xReady                    : BOOL;
	xStorageBusy 			  : BOOL;
	xStorageDepositComplete   : BOOL;
	xStorageEntryConveyorCmd  : BOOL; 
	xStorageFaulted           : BOOL; 
	xStorageForksLeftCmd      : BOOL;
	xStorageForksRightCmd     : BOOL;
	xStorageLiftCmd           : BOOL; 
	xStorageLoadConveyorCmd   : BOOL;
	xStorageReady             : BOOL;
    xStorageStoreComplete     : BOOL;
    xTankDischargeValveCmd    : BOOL;
    xTankFillValveCmd         : BOOL;
    xTankTransferConveyorsCmd : BOOL;
END_VAR

VAR
    fbRackManager      : FB_RackManager;
	fbStorage          : FB_Storage;
    fbTank             : FB_Tank;
    xCarrierAccepted   : BOOL;
    xTransactionActive : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">a32b42f8-55ef-4b02-b6a1-3a2aa06a7f5a_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">571</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">POUs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">c650edd6-f1d5-4d01-a268-7b92e28b3b02</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_MachiningCell</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224431312039348</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// TIMERS
// Controlled Stops pause every timeout.
// =============================================================

fbEmitterPulse(
    IN :=
        xEnable
        AND xRun
        AND NOT xEmitterIssued
        AND
        (eState = E_MachiningCellState.FeedingRaw)
        AND NOT xAtEntry,
    PT := tEmitterPulse
);

fbFeedTimeout(
    IN :=
        xEnable
        AND xRun
        AND
        (eState = E_MachiningCellState.FeedingRaw)
        AND NOT xAtEntry,
    PT := tFeedTimeout
);

fbPickupTimeout(
    IN :=
        xEnable
        AND xRun
        AND
        (eState = E_MachiningCellState.WaitingForPickup)
        AND NOT xCenterBusy,
    PT := tPickupTimeout
);

fbProcessTimeout(
    IN :=
        xEnable
        AND xRun
        AND
        (eState = E_MachiningCellState.Processing)
        AND NOT xAtExit,
    PT := tProcessTimeout
);


// =============================================================
// SAFE OUTPUT DEFAULTS
// =============================================================

xCenterProduceCmd := xEnable AND xProduceLids;
xCenterResetCmd := xReset;
xCenterStartCmd := FALSE;
xCenterStopCmd :=
    (NOT xEnable OR NOT xRun OR xFaulted)
    AND NOT xReset;

xDone := FALSE;
xEmitterCmd := FALSE;
xExitConveyor1Cmd := FALSE;
xExitConveyor2Cmd := FALSE;
xRawConveyorCmd := FALSE;
xReady := FALSE;


// =============================================================
// ONE-PART EMITTER MEMORY
// =============================================================

IF fbEmitterPulse.Q THEN
    xEmitterIssued := TRUE;
END_IF

// Entry detection proves that the emitted blank arrived.
IF xAtEntry THEN
    xEmitterIssued := FALSE;
END_IF


// =============================================================
// RESET, FAULT AND RUN PRIORITIES
// =============================================================

IF xReset THEN
    diCount := 0;
    eState := E_MachiningCellState.Stopped;
    uiFaultCode := 0;
    xEmitterIssued := FALSE;
    xFaulted := FALSE;

ELSIF xCenterHasError THEN
    uiFaultCode := 100;
    xFaulted := TRUE;
    eState := E_MachiningCellState.Faulted;

ELSIF xFaulted THEN
    eState := E_MachiningCellState.Faulted;

// A controlled Stop preserves eState and xEmitterIssued.
ELSIF xEnable AND xRun THEN

    // Carry the finished item towards its exit staging sensor.
	// Stop there so the pair diverter owns the downstream release.
	xExitConveyor1Cmd :=
		(eState = E_MachiningCellState.Processing)
		AND NOT xAtExit;
	
	xExitConveyor2Cmd :=
		(eState = E_MachiningCellState.Processing)
		AND NOT xAtExit;

    CASE eState OF

        E_MachiningCellState.Stopped:
            eState := E_MachiningCellState.Ready;


        E_MachiningCellState.Ready:
            xReady :=
                xCenterOpened
                AND NOT xAtExit
                AND NOT xCenterBusy;

            IF xRequest AND xReady THEN
                eState := E_MachiningCellState.FeedingRaw;
            END_IF


        E_MachiningCellState.FeedingRaw:
            xEmitterCmd := fbEmitterPulse.Q;
            xRawConveyorCmd := TRUE;

            IF xAtEntry THEN
                eState :=
                    E_MachiningCellState.WaitingForPickup;

            ELSIF fbFeedTimeout.Q THEN
                uiFaultCode := 101;
                xFaulted := TRUE;
                eState := E_MachiningCellState.Faulted;
            END_IF


        E_MachiningCellState.WaitingForPickup:
            xCenterStartCmd := TRUE;
            xRawConveyorCmd := TRUE;

            IF xCenterBusy THEN
                eState := E_MachiningCellState.Processing;

            ELSIF fbPickupTimeout.Q THEN
                uiFaultCode := 102;
                xFaulted := TRUE;
                eState := E_MachiningCellState.Faulted;
            END_IF


        E_MachiningCellState.Processing:
            IF xAtExit THEN
                diCount := diCount + 1;
                eState := E_MachiningCellState.Complete;

            ELSIF fbProcessTimeout.Q THEN
                uiFaultCode := 103;
                xFaulted := TRUE;
                eState := E_MachiningCellState.Faulted;
            END_IF


        E_MachiningCellState.Complete:
            // Hold completion until the unit removes its request
            // and the finished product physically leaves staging.
            xDone := TRUE;

            IF NOT xRequest AND NOT xAtExit THEN
                eState := E_MachiningCellState.Ready;
            END_IF


        E_MachiningCellState.Faulted:
            xFaulted := TRUE;


    ELSE
        uiFaultCode := 199;
        xFaulted := TRUE;
        eState := E_MachiningCellState.Faulted;

    END_CASE
END_IF


// =============================================================
// FINAL COMMAND INTERLOCKS
// =============================================================

IF xFaulted THEN
    xCenterStartCmd := FALSE;
    xCenterStopCmd := NOT xReset;
    xEmitterCmd := FALSE;
    xExitConveyor1Cmd := FALSE;
    xExitConveyor2Cmd := FALSE;
    xRawConveyorCmd := FALSE;
END_IF

// Reset must never compete with Start or Stop.
IF xReset THEN
    xCenterResetCmd := TRUE;
    xCenterStartCmd := FALSE;
    xCenterStopCmd := FALSE;
END_IF

// State-derived status remains valid during a controlled Stop.
xBusy :=
    (eState = E_MachiningCellState.FeedingRaw)
    OR
    (eState = E_MachiningCellState.WaitingForPickup)
    OR
    (eState = E_MachiningCellState.Processing)
    OR
    (eState = E_MachiningCellState.Complete);</Single>
            <Single Name="LineInfoPersistence" Type="string">c650edd6-f1d5-4d01-a268-7b92e28b3b02_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_MachiningCell
VAR_INPUT
    tEmitterPulse   : TIME := T#500MS;
    tFeedTimeout    : TIME := T#20S;
    tPickupTimeout  : TIME := T#20S;
    tProcessTimeout : TIME := T#60S;
    xAtEntry        : BOOL;
    xAtExit         : BOOL;
    xCenterBusy     : BOOL;
    xCenterHasError : BOOL;
    xCenterOpened   : BOOL;
    xEnable         : BOOL;
    xProduceLids    : BOOL;
    xRequest        : BOOL;
    xReset          : BOOL;
    xRun            : BOOL;
END_VAR

VAR_OUTPUT
    diCount                : DINT;
    eState                 : E_MachiningCellState :=
                                 E_MachiningCellState.Stopped;
    uiFaultCode            : UINT;
	xBusy 				   : BOOL;
    xCenterProduceCmd      : BOOL;
    xCenterResetCmd        : BOOL;
    xCenterStartCmd        : BOOL;
    xCenterStopCmd         : BOOL;
    xDone                  : BOOL;
    xEmitterCmd            : BOOL;
    xExitConveyor1Cmd      : BOOL;
    xExitConveyor2Cmd      : BOOL;
    xFaulted               : BOOL;
    xRawConveyorCmd        : BOOL;
    xReady                 : BOOL;
END_VAR

VAR
    fbEmitterPulse  : TP;
    fbFeedTimeout   : TON;
    fbPickupTimeout : TON;
    fbProcessTimeout : TON;
    xEmitterIssued  : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">c650edd6-f1d5-4d01-a268-7b92e28b3b02_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">276</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">POUs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">a0c27071-5313-4e08-a6e2-4988e7a7a715</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_MasterOperatorControl</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224325655954045</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Convert the MASTER push buttons into one-scan events.
fbResetEdge(CLK := xResetPB);
fbStartEdge(CLK := xStartPB);

// Exactly one MASTER operating mode must be selected.
xModeValid :=
    xAutoModeSelected XOR xManualModeSelected;

xAutoModeActive :=
    xAutoModeSelected
    AND NOT xManualModeSelected;

xManualModeActive :=
    xManualModeSelected
    AND NOT xAutoModeSelected;

// MASTER safety availability.
// The ordinary Stop circuit is handled separately so Auto mode
// can finish its current transaction under controlled-stop logic.
xSafetyHealthy :=
    xEmergencyStopHealthy
    AND xFactoryIORunning
    AND xModeValid;

// One-scan default.
xResetPulse := FALSE;

// Immediate safety loss cancels all MASTER authority.
IF NOT xSafetyHealthy THEN
    xResetRequired := TRUE;
    xRunLatched := FALSE;
    xStopPending := FALSE;

// Reset has priority over a latched plant fault so that the
// coordinator can actually receive the reset pulse.
ELSIF fbResetEdge.Q AND xStopCircuitHealthy THEN
    xResetPulse := TRUE;
    xResetRequired := FALSE;
    xRunLatched := FALSE;
    xStopPending := FALSE;

// A plant fault removes the run latch and requires acknowledgement.
ELSIF xPlantFaulted THEN
    xResetRequired := TRUE;
    xRunLatched := FALSE;
    xStopPending := FALSE;

// MASTER Stop requests controlled completion in Auto mode.
ELSIF NOT xStopCircuitHealthy THEN
    IF xRunLatched THEN
        xStopPending := TRUE;
    END_IF

    xRunLatched := FALSE;

// Selecting Manual removes automatic authority.
// Local unit panels will receive authority in a later step.
ELSIF xManualModeActive THEN
    IF xRunLatched THEN
        xStopPending := TRUE;
    END_IF

    xRunLatched := FALSE;

// MASTER Start is accepted only in Auto after a valid reset.
ELSIF fbStartEdge.Q
    AND xAutoModeActive
    AND NOT xResetRequired
THEN
    xRunLatched := TRUE;
    xStopPending := FALSE;
END_IF

xAutoRun :=
    xAutoModeActive
    AND xRunLatched;

// Manual mode requires a healthy MASTER Stop circuit.
// Auto mode retains enable during a controlled-stop request.
xEnable :=
    xSafetyHealthy
    AND NOT xPlantFaulted
    AND NOT xResetRequired
    AND (
        xAutoModeActive
        OR xStopCircuitHealthy
    );</Single>
            <Single Name="LineInfoPersistence" Type="string">a0c27071-5313-4e08-a6e2-4988e7a7a715_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_MasterOperatorControl
VAR_INPUT
    xAutoModeSelected     : BOOL;
    xEmergencyStopHealthy : BOOL;
    xFactoryIORunning     : BOOL;
    xManualModeSelected   : BOOL;
    xPlantFaulted         : BOOL;
    xResetPB              : BOOL;
    xStartPB              : BOOL;
    xStopCircuitHealthy   : BOOL;
END_VAR
VAR_OUTPUT
    xAutoModeActive   : BOOL;
    xAutoRun          : BOOL;
    xEnable           : BOOL;
    xManualModeActive : BOOL;
    xResetPulse       : BOOL;
    xResetRequired    : BOOL := TRUE;
    xRunLatched       : BOOL;
    xStopPending      : BOOL;
END_VAR
VAR
    fbResetEdge    : R_TRIG;
    fbStartEdge    : R_TRIG;
    xModeValid     : BOOL;
    xSafetyHealthy : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">a0c27071-5313-4e08-a6e2-4988e7a7a715_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">228</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">POUs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">8784c449-c26f-4ca9-a8a5-5809e5c6048d</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_PackoutCarrierStation</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224349507717367</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Detect state transitions.
xStateChanged := eState &lt;&gt; ePreviousState;

fbCarrierEmitPulse(
    IN :=
        xEnable
        AND xRun
        AND NOT xCarrierEmitIssued
        AND
        (eState = E_PackoutCarrierState.FeedingCarrier)
        AND NOT xPalletAtLoad,
    PT := T#500MS
);

// Remember that this carrier has already been emitted.
// Preserve this latch across a controlled Stop.
IF fbCarrierEmitPulse.Q THEN
    xCarrierEmitIssued := TRUE;
END_IF

// Arrival proves that another carrier may be emitted later.
IF xPalletAtLoad THEN
    xCarrierEmitIssued := FALSE;
END_IF

xTimedState :=
    (eState = E_PackoutCarrierState.FeedingCarrier)
    OR
    (eState = E_PackoutCarrierState.TransferringCarrier)
    OR
    (eState =
        E_PackoutCarrierState.WaitingForDownstreamAckClear);

fbStepTimeout(
    IN :=
        xEnable
        AND xRun
        AND xTimedState
        AND NOT xStateChanged,
    PT := tStepTimeout
);

ePreviousState := eState;

// Safe physical-output defaults.
xCarrierConveyorCmd := FALSE;
xCarrierEmitterCmd := FALSE;
xCarrierInfeedConveyorCmd := FALSE;

IF xReset THEN
    eState := E_PackoutCarrierState.Stopped;
    ePreviousState := E_PackoutCarrierState.Stopped;
    uiFaultCode := 0;

ELSIF xEnable AND xRun THEN
    CASE eState OF

        E_PackoutCarrierState.Stopped:
            uiFaultCode := 0;
            eState :=
                E_PackoutCarrierState.WaitingForCarrierRequest;


        E_PackoutCarrierState.WaitingForCarrierRequest:
            IF xPalletAtLoad THEN
                eState :=
                    E_PackoutCarrierState.HoldingCarrierAtLoad;

            ELSIF xCarrierReq THEN
                eState :=
                    E_PackoutCarrierState.FeedingCarrier;
            END_IF


        E_PackoutCarrierState.FeedingCarrier:
            xCarrierConveyorCmd := TRUE;
            xCarrierEmitterCmd := fbCarrierEmitPulse.Q;
            xCarrierInfeedConveyorCmd := TRUE;

            IF xPalletAtLoad THEN
                eState :=
                    E_PackoutCarrierState.HoldingCarrierAtLoad;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 601;
                eState := E_PackoutCarrierState.Faulted;
            END_IF


        E_PackoutCarrierState.HoldingCarrierAtLoad:
            IF NOT xPalletAtLoad THEN
                IF xCarrierReq THEN
                    eState :=
                        E_PackoutCarrierState.FeedingCarrier;
                ELSE
                    eState :=
                        E_PackoutCarrierState
                            .WaitingForCarrierRequest;
                END_IF

            ELSIF xLoadComplete AND xProductLoaded THEN
                eState :=
                    E_PackoutCarrierState
                        .RequestingPlantStorage;
            END_IF


        E_PackoutCarrierState.RequestingPlantStorage:
            // Do not move until the loader has cleared its
            // LoadComplete request and Plant Storage is ready.
            IF NOT xLoadComplete AND xDownstreamReady THEN
                eState :=
                    E_PackoutCarrierState.TransferringCarrier;
            END_IF


        E_PackoutCarrierState.TransferringCarrier:
            xCarrierConveyorCmd := TRUE;

            IF xDownstreamAck THEN
                eState :=
                    E_PackoutCarrierState
                        .WaitingForDownstreamAckClear;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 602;
                eState := E_PackoutCarrierState.Faulted;
            END_IF


        E_PackoutCarrierState.WaitingForDownstreamAckClear:
            IF NOT xDownstreamAck THEN
                eState :=
                    E_PackoutCarrierState
                        .WaitingForCarrierRequest;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 603;
                eState := E_PackoutCarrierState.Faulted;
            END_IF


        E_PackoutCarrierState.Faulted:
            // Physical outputs remain at their safe defaults.


    ELSE
        uiFaultCode := 698;
        eState := E_PackoutCarrierState.Faulted;

    END_CASE
END_IF

// State-derived status and nonphysical handshakes.
xBusy :=
    (eState = E_PackoutCarrierState.FeedingCarrier)
    OR
    (eState = E_PackoutCarrierState.RequestingPlantStorage)
    OR
    (eState = E_PackoutCarrierState.TransferringCarrier)
    OR
    (eState =
        E_PackoutCarrierState.WaitingForDownstreamAckClear);

xCarrierReady :=
    xPalletAtLoad
    AND
    (eState = E_PackoutCarrierState.HoldingCarrierAtLoad);

xFaulted :=
    eState = E_PackoutCarrierState.Faulted;

xLoadAccepted :=
    xLoadComplete
    AND
    (eState =
        E_PackoutCarrierState.RequestingPlantStorage);

xLoadedCarrierReq :=
    NOT xLoadComplete
    AND
    (
        (eState =
            E_PackoutCarrierState.RequestingPlantStorage)
        OR
        (eState =
            E_PackoutCarrierState.TransferringCarrier)
    );

xReady :=
    xEnable
    AND xRun
	AND
    (
        (eState =
            E_PackoutCarrierState.WaitingForCarrierRequest)
        OR
        (eState =
            E_PackoutCarrierState.HoldingCarrierAtLoad)
    );

// Faults always remove physical commands.
IF xFaulted THEN
    xCarrierConveyorCmd := FALSE;
    xCarrierEmitterCmd := FALSE;
    xCarrierInfeedConveyorCmd := FALSE;
    xCarrierReady := FALSE;
    xReady := FALSE;
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">8784c449-c26f-4ca9-a8a5-5809e5c6048d_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_PackoutCarrierStation
VAR_INPUT
    tStepTimeout      : TIME := T#30S;
    xCarrierReq       : BOOL;
    xDownstreamAck    : BOOL;
    xDownstreamReady  : BOOL;
    xEnable           : BOOL;
    xLoadComplete     : BOOL;
    xPalletAtLoad     : BOOL;
    xProductLoaded    : BOOL;
    xReset            : BOOL;
	xRun 			  : BOOL;
END_VAR
VAR_OUTPUT
    eState                    : E_PackoutCarrierState :=
                                    E_PackoutCarrierState.Stopped;
    uiFaultCode               : UINT;
    xBusy                     : BOOL;
    xCarrierConveyorCmd       : BOOL;
    xCarrierEmitterCmd        : BOOL;
    xCarrierInfeedConveyorCmd : BOOL;
    xCarrierReady             : BOOL;
    xFaulted                  : BOOL;
    xLoadAccepted             : BOOL;
    xLoadedCarrierReq         : BOOL;
    xReady                    : BOOL;
END_VAR
VAR
    ePreviousState 	   : E_PackoutCarrierState :=
                         E_PackoutCarrierState.Stopped;
	fbCarrierEmitPulse : TP;
    fbStepTimeout 	   : TON;
	xCarrierEmitIssued : BOOL;
    xStateChanged  	   : BOOL;
    xTimedState    	   : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">8784c449-c26f-4ca9-a8a5-5809e5c6048d_Decl_LineIds</Single>
