          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639229148492713932</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// 1. INPUT IMAGE AND POLARITY NORMALISATION
// =============================================================
rTankLevelPct := FIO.rTankLevelV * 10.0;

xPackoutPalletAtLoad := NOT FIO.xPackoutPalletAtLoadBeamClear;
xPackoutProductAtPick := NOT FIO.xPackoutProductAtPickBeamClear;
xPairSorterCountDetected := NOT FIO.xPairSorterCountBeamClear;
xPairSorterPartAtPusher := NOT FIO.xPairSorterPusherBeamClear;

xStorageAtEntry := NOT FIO.xStorageAtEntryBeamClear;
xStorageAtExit := NOT FIO.xStorageAtExitBeamClear;
xStorageAtUnload := NOT FIO.xStorageAtUnloadBeamClear;
xStorageCraneAtHome :=
    (FIO.wStorageTargetPositionCmd =
        PlantConstants.wStorageHomePosition)
    AND FIO.xStorageForkAtMiddle
    AND NOT FIO.xStorageMovingX
    AND NOT FIO.xStorageMovingZ;
xStorageProductAtLoad := NOT FIO.xStorageLoadBeamClear;

xTwinCellBasesEntryDetected := NOT FIO.xTwinCellBasesEntryBeamClear;
xTwinCellBasesExitDetected := NOT FIO.xTwinCellBasesExitBeamClear;
xTwinCellLidsEntryDetected := NOT FIO.xTwinCellLidsEntryBeamClear;
xTwinCellLidsExitDetected := NOT FIO.xTwinCellLidsExitBeamClear;

// =============================================================
// 2. SAFETY AND COMMISSIONING CONDITIONS
// =============================================================
xAllEmergencyStopsHealthy :=
    FIO.xMasterEmergencyStopHealthy
	AND FIO.xPlantEmergencyStopHealthy
    AND FIO.xTwinCellEmergencyStopHealthy;

// Global commissioned outputs are permitted.
// Uncommissioned zones remain protected by their individual permits.
xOutputPermit := TRUE;

// =============================================================
// 3. OPERATOR CONTROL
// =============================================================
fbMasterOperatorControl(
    xAutoModeSelected :=
		FIO.xMasterAutoModeSelected
		OR SCADA.xIgnitionAutoModeReq,
    xEmergencyStopHealthy := xAllEmergencyStopsHealthy,
    xFactoryIORunning := FIO.xFactoryIORunning,
    xManualModeSelected := FIO.xMasterManualModeSelected,
    xPlantFaulted := fbPlantCoordinator.xFaulted,
    xResetPB := FIO.xMasterResetPB OR SCADA.xResetReq,
    xStartPB := FIO.xMasterStartPB OR SCADA.xStartReq,
    xStopCircuitHealthy :=
        FIO.xMasterStopCircuitHealthy
        AND NOT SCADA.xStopReq
);

xBatchStorageTransferActive :=
    fbBatchStorageUnit.xBusy
    OR fbPackoutCarrierStation.xBusy
    OR fbPackoutCarrierStation.xLoadedCarrierReq
    OR fbPackoutLoader.xBusy
    OR fbPackoutLoader.xLoadComplete;

fbBatchStorageOperatorControl(
    xEmergencyStopHealthy := xAllEmergencyStopsHealthy,
    xLocalModeSelected := FIO.xPlantManualModeSelected,
    xLocalResetPB := FIO.xPlantResetPB,
    xLocalStartPB := FIO.xPlantStartPB,
    xLocalStopHealthy := FIO.xPlantStopCircuitHealthy,
    xMasterAutoModeActive :=
        fbMasterOperatorControl.xAutoModeActive,
    xMasterEnable := fbMasterOperatorControl.xEnable,
    xMasterManualModeActive :=
        fbMasterOperatorControl.xManualModeActive,
    xMasterModeSelected := FIO.xPlantAutoModeSelected,
    xMasterResetPulse := fbMasterOperatorControl.xResetPulse,
    xMasterRun := fbPlantCoordinator.xRunning,
    xTransferActive := xBatchStorageTransferActive
);

xPairTransferActive :=
    fbPairTransfer.eState &lt;&gt; E_TransferState.Idle;

xProductTransferActive :=
    (fbProductTransfer.eState &lt;&gt; E_TransferState.Idle)
    OR fbPackoutLoader.xBusy
    OR fbPackoutLoader.xLoadComplete;

fbTwinCellOperatorControl(
    xEmergencyStopHealthy := xAllEmergencyStopsHealthy,
    xLocalModeSelected := FIO.xTwinCellLocalModeSelected,
    xLocalResetPB := FIO.xTwinCellResetPB,
    xLocalStartPB := FIO.xTwinCellStartPB,
    xLocalStopHealthy := FIO.xTwinCellStopCircuitHealthy,
	xMasterAutoModeActive :=
    	fbMasterOperatorControl.xAutoModeActive,
    xMasterEnable := fbMasterOperatorControl.xEnable,
	xMasterManualModeActive :=
    	fbMasterOperatorControl.xManualModeActive,
    xMasterModeSelected := FIO.xTwinCellPlantModeSelected,
    xMasterResetPulse := fbMasterOperatorControl.xResetPulse,
    xMasterRun := fbPlantCoordinator.xRunning,
    xTransferActive :=
        xPairTransferActive OR xProductTransferActive
);

// =============================================================
// 4. UNIT BOUNDARIES
// =============================================================
fbTwinCellUnit(
    xEnable := fbTwinCellOperatorControl.xEnable,
    xPairAccepted := fbAssemblyUnit.xPairAck,
	xProductionRequest :=
		fbMasterOperatorControl.xAutoRun
		AND fbPlantCoordinator.xAllowNewPair,
    xReset := fbTwinCellOperatorControl.xResetPulse,
    xRun :=
		fbTwinCellOperatorControl.xRun
		AND xTwinCellOutputPermit,
    xTwinCellBasesCenterBusy :=
        FIO.xTwinCellBasesCenterBusy,
    xTwinCellBasesCenterHasError :=
        FIO.xTwinCellBasesCenterHasError,
    xTwinCellBasesCenterOpened :=
        FIO.xTwinCellBasesCenterOpened,
    xTwinCellBasesEntryDetected :=
        xTwinCellBasesEntryDetected,
    xTwinCellBasesExitDetected :=
        xTwinCellBasesExitDetected,
    xTwinCellLidsCenterBusy :=
        FIO.xTwinCellLidsCenterBusy,
    xTwinCellLidsCenterHasError :=
        FIO.xTwinCellLidsCenterHasError,
    xTwinCellLidsCenterOpened :=
        FIO.xTwinCellLidsCenterOpened,
    xTwinCellLidsEntryDetected :=
        xTwinCellLidsEntryDetected,
    xTwinCellLidsExitDetected :=
        xTwinCellLidsExitDetected
);

fbAssemblyUnit(
    xBaseAtPlace :=
        FIO.xAssemblyBaseAtPlace,

    xBaseClamped :=
        FIO.xAssemblyBaseClamped,

    xBasesPositionerAtLimit :=
        FIO.xAssemblyBasesPositionerAtLimit,

    xEnable :=
        fbTwinCellOperatorControl.xEnable
        AND FIO.xFactoryIORunning
        AND xOutputPermit,

    xItemDetected :=
        FIO.xAssemblyItemDetected,

    xLidAtPlace :=
        FIO.xAssemblyLidAtPlace,

    xLidClamped :=
        FIO.xAssemblyLidClamped,

    xMovingX :=
        FIO.xAssemblyMovingX,

    xMovingZ :=
        FIO.xAssemblyMovingZ,

    xProductAtOutfeed :=
        FIO.xAssemblyProductAtOutfeed,

    xProductTransferAck :=
        fbPackoutLoader.xProductTransferAck,

    xReset :=
        fbTwinCellOperatorControl.xResetPulse,

    xRun :=
        fbTwinCellOperatorControl.xRun
);

// =============================================================
// 5. P10-TO-P11 TRANSFER
// =============================================================
fbPairTransfer(
    tTransferTimeout := PlantConstants.tPairTransferTimeout,
    xAck := fbAssemblyUnit.xPairAck,
    xEnable :=
		fbPlantCoordinator.xPairTransferEnable
		AND xPairSorterOutputPermit,
    xReady := fbAssemblyUnit.xPairReady,
    xReq := fbTwinCellUnit.xPairReq,
    xReset := fbMasterOperatorControl.xResetPulse,
	xRun := fbTwinCellOperatorControl.xRun
);

fbPairDiverter(
	tLidPositionTime := T#700MS,
    tStepTimeout := T#45S,
    xAssemblyBaseAtPlace := FIO.xAssemblyBaseAtPlace,
    xAssemblyLidAtPlace := FIO.xAssemblyLidAtPlace,
    xCountDetected := xPairSorterCountDetected,
    xEnable :=
		xAllEmergencyStopsHealthy
		AND FIO.xFactoryIORunning
		AND xOutputPermit
		AND xPairSorterOutputPermit,
		xPartAtPusher := xPairSorterPartAtPusher,
    xPusherAtBack := FIO.xPairSorterPusherAtBack,
    xPusherAtFront := FIO.xPairSorterPusherAtFront,
    xReset := fbMasterOperatorControl.xResetPulse,
	xRun := fbTwinCellOperatorControl.xRun,
	xTransferPermit := fbPairTransfer.xPermit
);

// =============================================================
// 6. P11-TO-PACKOUT LOADER TRANSFER
// =============================================================
fbProductTransfer(
    tTransferTimeout := PlantConstants.tProductTransferTimeout,
    xAck := fbPackoutLoader.xProductTransferAck,
    xEnable := fbPlantCoordinator.xProductTransferEnable,
    xReady := fbPackoutLoader.xProductTransferReady,
    xReq := fbAssemblyUnit.xProductReq,
    xReset := fbMasterOperatorControl.xResetPulse,
	xRun := fbTwinCellOperatorControl.xRun	
);

fbPackoutLoader(
    tStepTimeout := T#20S,
    xCarrierReady := fbPackoutCarrierStation.xCarrierReady,
    xEnable :=
        xAllEmergencyStopsHealthy
		AND FIO.xFactoryIORunning
		AND xOutputPermit,
    xItemDetected := FIO.xPackoutItemDetected,
    xLoadAccepted := fbPackoutCarrierStation.xLoadAccepted,
    xMovingX := FIO.xPackoutMovingX,
    xMovingZ := FIO.xPackoutMovingZ,
    xProductAtPick := xPackoutProductAtPick,
    xProductLoaded := FIO.xPackoutProductLoaded,
    xProductTransferPermit := fbProductTransfer.xPermit,
    xReset := fbTwinCellOperatorControl.xResetPulse,
	xRun :=
		fbTwinCellOperatorControl.xRun
		AND fbPlantCoordinator.xRunning
);

fbPackoutCarrierStation(
    tStepTimeout := T#30S,
    xCarrierReq := fbPackoutLoader.xCarrierReq,
    xDownstreamAck := fbBatchStorageUnit.xProductTransferAck,
    xDownstreamReady := fbBatchStorageUnit.xProductTransferReady,
    xEnable :=
        fbBatchStorageOperatorControl.xEnable
        AND FIO.xFactoryIORunning
        AND xOutputPermit,
    xLoadComplete := fbPackoutLoader.xLoadComplete,
    xPalletAtLoad := xPackoutPalletAtLoad,
    xProductLoaded := FIO.xPackoutProductLoaded,
    xReset := fbBatchStorageOperatorControl.xResetPulse,
    xRun :=
        fbBatchStorageOperatorControl.xRun
        AND fbPlantCoordinator.xRunning
);

// =============================================================
// 7. PACKOUT-TO-PLANT STORAGE BOUNDARY
// =============================================================
fbBatchStorageUnit(
    rTankLevelV := FIO.rTankLevelV,
	wStorageHomePosition :=
        PlantConstants.wStorageHomePosition,
    xEnable := fbBatchStorageOperatorControl.xEnable,
    xPackoutPalletAtLoad := xPackoutPalletAtLoad,
    xPackoutProductLoaded := FIO.xPackoutProductLoaded,
    xProductTransferReq :=
        fbPackoutCarrierStation.xLoadedCarrierReq,
    xReset := fbBatchStorageOperatorControl.xResetPulse,
    xRun := fbBatchStorageOperatorControl.xRun,
    xStorageAtEntry := xStorageAtEntry,
	 xStorageCraneAtHome := xStorageCraneAtHome,
    xStorageForkAtLeft := FIO.xStorageForkAtLeft,
    xStorageForkAtMiddle := FIO.xStorageForkAtMiddle,
    xStorageForkAtRight := FIO.xStorageForkAtRight,
    xStorageMovingX := FIO.xStorageMovingX,
    xStorageMovingZ := FIO.xStorageMovingZ,
    xStorageProductAtLoad := xStorageProductAtLoad,
    xTankCarrierAtFill := FIO.xTankCarrierAtFill,
    xTankLevelHighHigh := FIO.xTankLevelHighHigh
);

// =============================================================
// 8. PLANT COORDINATION
// =============================================================
xAnyFault :=
    fbAssemblyUnit.xFaulted
    OR fbBatchStorageUnit.xFaulted
    OR fbPackoutCarrierStation.xFaulted
    OR fbPackoutLoader.xFaulted
    OR fbPairDiverter.xFaulted
    OR fbPairTransfer.xFaulted
    OR fbProductTransfer.xFaulted
    OR fbTwinCellUnit.xFaulted;

fbPlantCoordinator(
    xAnyFault := xAnyFault,
    xAutoRun := fbMasterOperatorControl.xAutoRun,
    xBatchStorageReady := fbBatchStorageUnit.xReady,
    xEnable := fbMasterOperatorControl.xEnable,
    xPairTransferComplete := fbPairTransfer.xComplete,
    xProductTransferComplete := fbProductTransfer.xComplete,
    xRackCommitAck := fbBatchStorageUnit.xRackCommitAck,
    xRackReservationValid := fbBatchStorageUnit.xRackReservationValid,
    xReset := fbMasterOperatorControl.xResetPulse
);

// Consume momentary SCADA requests after the FBs have sampled them.
SCADA.xResetReq := FALSE;
SCADA.xStartReq := FALSE;
SCADA.xStopReq := FALSE;

// =============================================================
// 9. SCADA STATUS PUBLICATION
// =============================================================

// Plant
SCADA.diPlantCompletedLoadCount :=
    UINT_TO_DINT(fbBatchStorageUnit.uiRackOccupiedCount);

SCADA.ePlantState :=
    fbPlantCoordinator.eState;

SCADA.eProductionPhase :=
    fbPlantCoordinator.eProductionPhase;

SCADA.uiPlantFaultCode :=
    fbPlantCoordinator.uiFaultCode;

SCADA.xAllEmergencyStopsHealthy :=
    xAllEmergencyStopsHealthy;

SCADA.xAutoModeActive :=
    fbMasterOperatorControl.xAutoModeActive;

SCADA.xFactoryIORunning :=
    FIO.xFactoryIORunning;

SCADA.xManualModeActive :=
    fbMasterOperatorControl.xManualModeActive;

SCADA.xPlantFaulted :=
    fbPlantCoordinator.xFaulted;

SCADA.xPlantRecoveryRequired :=
    fbPlantCoordinator.xRecoveryRequired;

SCADA.xPlantRunning :=
    fbPlantCoordinator.xRunning;

SCADA.xPlantStopPending :=
    fbPlantCoordinator.xStopPending;


// Twin Cell
SCADA.diTwinCellPairCount :=
    fbTwinCellUnit.diPairCount;

SCADA.uiTwinCellFaultCode :=
    fbTwinCellUnit.uiFaultCode;

SCADA.xTwinCellBusy :=
    fbTwinCellUnit.xBusy;

SCADA.xTwinCellFaulted :=
    fbTwinCellUnit.xFaulted;

SCADA.xTwinCellReady :=
    fbTwinCellUnit.xReady;


// Pair transfer
SCADA.ePairTransferState :=
    fbPairTransfer.eState;

SCADA.uiPairTransferFaultCode :=
    fbPairTransfer.uiFaultCode;

SCADA.xPairTransferAck :=
    fbAssemblyUnit.xPairAck;

SCADA.xPairTransferFaulted :=
    fbPairTransfer.xFaulted;

SCADA.xPairTransferPermit :=
    fbPairTransfer.xPermit;

SCADA.xPairTransferReady :=
    fbAssemblyUnit.xPairReady;

SCADA.xPairTransferReq :=
    fbTwinCellUnit.xPairReq;


// Pair sorter
SCADA.diPairSorterDetectionCount :=
    fbPairDiverter.diDetectionCount;

SCADA.ePairDiverterState :=
    fbPairDiverter.eState;

SCADA.uiPairSorterFaultCode :=
    fbPairDiverter.uiFaultCode;

SCADA.xPairSorterFaulted :=
    fbPairDiverter.xFaulted;

SCADA.xPairSorterPartAtPusher :=
    xPairSorterPartAtPusher;


// Assembly
SCADA.diAssemblyProductCount :=
    fbAssemblyUnit.diProductCount;

SCADA.eAssemblyState :=
    fbAssemblyUnit.eState;

SCADA.uiAssemblyFaultCode :=
    fbAssemblyUnit.uiFaultCode;

SCADA.xAssemblyBusy :=
    fbAssemblyUnit.xBusy;

SCADA.xAssemblyFaulted :=
    fbAssemblyUnit.xFaulted;

SCADA.xAssemblyReady :=
    fbAssemblyUnit.xReady;


// Product transfer
SCADA.eProductTransferState :=
    fbProductTransfer.eState;

SCADA.uiProductTransferFaultCode :=
    fbProductTransfer.uiFaultCode;

SCADA.xProductTransferAck :=
    fbPackoutLoader.xProductTransferAck;

SCADA.xProductTransferFaulted :=
    fbProductTransfer.xFaulted;

SCADA.xProductTransferPermit :=
    fbProductTransfer.xPermit;

SCADA.xProductTransferReady :=
    fbPackoutLoader.xProductTransferReady;

SCADA.xProductTransferReq :=
    fbAssemblyUnit.xProductReq;


// Packout
SCADA.diPackoutProductCount :=
    fbPackoutLoader.diProductCount;

SCADA.ePackoutCarrierState :=
    fbPackoutCarrierStation.eState;

SCADA.ePackoutLoaderState :=
    fbPackoutLoader.eState;

SCADA.uiPackoutCarrierFaultCode :=
    fbPackoutCarrierStation.uiFaultCode;

SCADA.uiPackoutLoaderFaultCode :=
    fbPackoutLoader.uiFaultCode;

SCADA.xPackoutBusy :=
    fbPackoutCarrierStation.xBusy
    OR fbPackoutLoader.xBusy;

SCADA.xPackoutCarrierBusy :=
    fbPackoutCarrierStation.xBusy;

SCADA.xPackoutCarrierFaulted :=
    fbPackoutCarrierStation.xFaulted;

SCADA.xPackoutCarrierReady :=
    fbPackoutCarrierStation.xReady;

SCADA.xPackoutFaulted :=
    fbPackoutCarrierStation.xFaulted
    OR fbPackoutLoader.xFaulted;

SCADA.xPackoutLoaderBusy :=
    fbPackoutLoader.xBusy;

SCADA.xPackoutLoaderFaulted :=
    fbPackoutLoader.xFaulted;

SCADA.xPackoutLoaderReady :=
    fbPackoutLoader.xReady;

SCADA.xPackoutReady :=
    fbPackoutCarrierStation.xReady
    AND fbPackoutLoader.xReady;


// Plant Storage
SCADA.eBatchStorageState :=
    fbBatchStorageUnit.eState;

SCADA.eStorageState :=
    fbBatchStorageUnit.eStorageState;

SCADA.eTankState :=
    fbBatchStorageUnit.eTankState;

SCADA.rTankLevelPct :=
    rTankLevelPct;

SCADA.uiRackFreeCount :=
    fbBatchStorageUnit.uiRackFreeCount;

SCADA.uiRackOccupiedCount :=
    fbBatchStorageUnit.uiRackOccupiedCount;

SCADA.uiRackReservedCount :=
    fbBatchStorageUnit.uiRackReservedCount;

SCADA.uiRackUnknownCount :=
    fbBatchStorageUnit.uiRackUnknownCount;

SCADA.uiStorageFaultCode :=
    fbBatchStorageUnit.uiStorageFaultCode;

SCADA.wStorageReservedPosition :=
    fbBatchStorageUnit.wRackReservedPosition;

SCADA.xPackoutPalletAtLoad :=
    xPackoutPalletAtLoad;

SCADA.xPackoutProductAtPick :=
    xPackoutProductAtPick;

SCADA.xPackoutProductLoaded :=
    FIO.xPackoutProductLoaded;

SCADA.xRackFull :=
    fbBatchStorageUnit.xRackFull;

SCADA.xStorageBusy :=
    fbBatchStorageUnit.xStorageBusy;

SCADA.xStorageFaulted :=
    fbBatchStorageUnit.xStorageFaulted;

SCADA.xStorageReady :=
    fbBatchStorageUnit.xStorageReady;
	
// =============================================================
// 10. SAFE FIO OUTPUT BOUNDARY — PART 1
// =============================================================

// Factory I/O lifecycle
FIO.diFactoryIOCameraPositionCmd := 0;
FIO.xFactoryIOPauseCmd := FALSE;
FIO.xFactoryIOResetCmd := FALSE;
FIO.xFactoryIORunCmd := FALSE;

// Twin Cell production-count displays
FIO.diTwinCellBasesCellCounterDisplay :=
    fbTwinCellUnit.diBasesCount;

FIO.diTwinCellBasesPanelCounterDisplay :=
    fbTwinCellUnit.diBasesCount;

FIO.diTwinCellLidsCellCounterDisplay :=
    fbTwinCellUnit.diLidsCount;

FIO.diTwinCellLidsPanelCounterDisplay :=
    fbTwinCellUnit.diLidsCount;

// MASTER operator-panel indication
FIO.xMasterResetLightCmd :=
    fbMasterOperatorControl.xResetRequired;

FIO.xMasterStackGreenCmd :=
    xAllEmergencyStopsHealthy
    AND NOT fbPlantCoordinator.xFaulted
    AND fbMasterOperatorControl.xAutoRun;

FIO.xMasterStackRedCmd :=
    NOT xAllEmergencyStopsHealthy
    OR fbPlantCoordinator.xFaulted;

FIO.xMasterStackYellowCmd :=
    xAllEmergencyStopsHealthy
    AND NOT fbPlantCoordinator.xFaulted
    AND NOT fbMasterOperatorControl.xAutoRun;

FIO.xMasterStartLightCmd :=
    fbMasterOperatorControl.xAutoRun;

FIO.xMasterStopLightCmd :=
    NOT fbMasterOperatorControl.xAutoRun;

// Twin Cell panel indication
FIO.xTwinCellResetLightCmd := FALSE;
FIO.xTwinCellStartLightCmd := FALSE;
FIO.xTwinCellStopLightCmd := TRUE;

// Twin Cell — bases
FIO.xTwinCellBasesCenterProduceCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xBasesCenterProduceCmd;

FIO.xTwinCellBasesCenterResetCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xBasesCenterResetCmd;

FIO.xTwinCellBasesCenterStartCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xBasesCenterStartCmd;

FIO.xTwinCellBasesCenterStopCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xBasesCenterStopCmd;

FIO.xTwinCellBasesEmitterCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xBasesEmitterCmd;

FIO.xTwinCellBasesExitConveyor1Cmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND (
        fbTwinCellUnit.xBasesExitConveyor1Cmd
        OR (
            xPairSorterOutputPermit
            AND fbPairDiverter.xBasesOutfeedCmd
        )
    );

FIO.xTwinCellBasesExitConveyor2Cmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND (
        fbTwinCellUnit.xBasesExitConveyor2Cmd
        OR (
            xPairSorterOutputPermit
            AND fbPairDiverter.xBasesOutfeedCmd
        )
    );

FIO.xTwinCellBasesRawConveyorCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xBasesRawConveyorCmd;

// Twin Cell — lids
FIO.xTwinCellLidsCenterProduceCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xLidsCenterProduceCmd;

FIO.xTwinCellLidsCenterResetCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xLidsCenterResetCmd;

FIO.xTwinCellLidsCenterStartCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xLidsCenterStartCmd;

FIO.xTwinCellLidsCenterStopCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xLidsCenterStopCmd;

FIO.xTwinCellLidsEmitterCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xLidsEmitterCmd;

FIO.xTwinCellLidsExitConveyor1Cmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND (
        fbTwinCellUnit.xLidsExitConveyor1Cmd
        OR (
            xPairSorterOutputPermit
            AND fbPairDiverter.xLidsOutfeedCmd
        )
    );

FIO.xTwinCellLidsExitConveyor2Cmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND (
        fbTwinCellUnit.xLidsExitConveyor2Cmd
        OR (
            xPairSorterOutputPermit
            AND fbPairDiverter.xLidsOutfeedCmd
        )
    );

FIO.xTwinCellLidsRawConveyorCmd :=
    xOutputPermit
    AND xTwinCellOutputPermit
    AND fbTwinCellUnit.xLidsRawConveyorCmd;

// Pair sorter
FIO.diPairSorterDetectionCountDisplay :=
    fbPairDiverter.diDetectionCount;

FIO.xPairSorterBaseCurveConveyorCmd :=
    xOutputPermit
    AND xPairSorterOutputPermit
    AND fbPairDiverter.xBaseCurveConveyorCmd;

FIO.xPairSorterInfeedConveyorCmd :=
    xOutputPermit
    AND xPairSorterOutputPermit
    AND fbPairDiverter.xInfeedConveyorCmd;

FIO.xPairSorterPusherCmd :=
    xOutputPermit
    AND xPairSorterOutputPermit
    AND fbPairDiverter.xPusherCmd;

FIO.xPairSorterPusherZoneConveyorCmd :=
    xOutputPermit
    AND xPairSorterOutputPermit
    AND fbPairDiverter.xPusherZoneConveyorCmd;

// Assembly
FIO.xAssemblyBaseClampCmd :=
    xOutputPermit
    AND fbTwinCellOperatorControl.xRun
    AND fbAssemblyUnit.xBaseClampCmd;

FIO.xAssemblyBasesConveyorCmd :=
    xOutputPermit
    AND fbTwinCellOperatorControl.xRun
    AND (
        fbAssemblyUnit.xBasesConveyorCmd
        OR (
            xPairSorterOutputPermit
            AND fbPairDiverter.xBasesOutfeedCmd
        )
    );

FIO.xAssemblyBasesPositionerRaiseCmd :=
    xOutputPermit
    AND fbTwinCellOperatorControl.xRun
    AND fbAssemblyUnit.xBasesPositionerRaiseCmd;

FIO.xAssemblyGrabCmd :=
    xOutputPermit
    AND fbTwinCellOperatorControl.xRun
    AND fbAssemblyUnit.xGrabCmd;

FIO.xAssemblyLidClampCmd :=
    xOutputPermit
    AND fbTwinCellOperatorControl.xRun
    AND fbAssemblyUnit.xLidClampCmd;

FIO.xAssemblyLidsConveyorCmd :=
    xOutputPermit
    AND fbTwinCellOperatorControl.xRun
    AND (
        fbAssemblyUnit.xLidsConveyorCmd
        OR (
            xPairSorterOutputPermit
            AND fbPairDiverter.xPusherZoneConveyorCmd
        )
    );

FIO.xAssemblyLidsPositionerRaiseCmd :=
    FALSE;

FIO.xAssemblyMoveXCmd :=
    xOutputPermit
    AND fbTwinCellOperatorControl.xRun
    AND fbAssemblyUnit.xMoveXCmd;

FIO.xAssemblyMoveZCmd :=
    xOutputPermit
    AND fbTwinCellOperatorControl.xRun
    AND fbAssemblyUnit.xMoveZCmd;

// =============================================================
// 11. SAFE FIO OUTPUT BOUNDARY — PART 2
// =============================================================

// Packout
FIO.xPackoutBufferConveyor1Cmd :=
    xOutputPermit
    AND fbPackoutLoader.xBufferConveyor1Cmd;

FIO.xPackoutBufferConveyor2Cmd :=
    xOutputPermit
    AND fbPackoutLoader.xBufferConveyor2Cmd;

FIO.xPackoutBufferConveyor3Cmd :=
    xOutputPermit
    AND fbPackoutLoader.xBufferConveyor3Cmd;
FIO.xPackoutCarrierConveyorCmd :=
    xOutputPermit
    AND fbPackoutCarrierStation.xCarrierConveyorCmd;

FIO.xPackoutCarrierEmitterCmd :=
    xOutputPermit
    AND fbPackoutCarrierStation.xCarrierEmitterCmd;

FIO.xPackoutCarrierInfeedConveyorCmd :=
    xOutputPermit
    AND fbPackoutCarrierStation.xCarrierInfeedConveyorCmd;
FIO.xPackoutGrabCmd :=
    xOutputPermit
    AND fbPackoutLoader.xGrabCmd;
FIO.xPackoutMoveXCmd :=
    xOutputPermit
    AND fbPackoutLoader.xMoveXCmd;
FIO.xPackoutMoveZCmd :=
    xOutputPermit
    AND fbPackoutLoader.xMoveZCmd;
FIO.xPackoutPickConveyorCmd :=
    xOutputPermit
    AND fbPackoutLoader.xPickConveyorCmd;

// Tank and transfer
IF xOutputPermit
    AND fbBatchStorageUnit.xTankDischargeValveCmd
THEN
    FIO.rTankDischargeValveCmdV := 10.0;
ELSE
    FIO.rTankDischargeValveCmdV := 0.0;
END_IF

IF xOutputPermit
    AND fbBatchStorageUnit.xTankFillValveCmd
THEN
    FIO.rTankFillValveCmdV := 10.0;
ELSE
    FIO.rTankFillValveCmdV := 0.0;
END_IF
FIO.xTankTransferConveyor1Cmd :=
    xOutputPermit
    AND fbBatchStorageUnit.xTankTransferConveyorsCmd;

FIO.xTankTransferConveyor2Cmd :=
    xOutputPermit
    AND fbBatchStorageUnit.xTankTransferConveyorsCmd;

FIO.xTankTransferConveyor3Cmd :=
    xOutputPermit
    AND fbBatchStorageUnit.xTankTransferConveyorsCmd;

FIO.xTankTransferConveyor4Cmd :=
    xOutputPermit
    AND fbBatchStorageUnit.xTankTransferConveyorsCmd;

// Permit for Storage and racking
xStorageOutputPermit :=
    FIO.xFactoryIORunning
    AND fbBatchStorageOperatorControl.xRun
    AND fbPlantCoordinator.xRunning
    AND NOT fbBatchStorageUnit.xStorageFaulted
    AND xOutputPermit;
	
// Storage and rack
// Storage and rack
IF xStorageOutputPermit THEN
    FIO.wStorageTargetPositionCmd :=
        fbBatchStorageUnit.wStorageTargetPositionCmd;
ELSE
    // Factory I/O target zero stops the numerical crane
    // at its current position.
    FIO.wStorageTargetPositionCmd := 0;
END_IF

FIO.xStorageEntryConveyorCmd :=
    xStorageOutputPermit
    AND fbBatchStorageUnit.xStorageEntryConveyorCmd;

FIO.xStorageExitConveyorCmd := FALSE;
FIO.xStorageExitRemoverCmd := FALSE;

FIO.xStorageForksLeftCmd :=
    xStorageOutputPermit
    AND fbBatchStorageUnit.xStorageForksLeftCmd;

FIO.xStorageForksRightCmd :=
    xStorageOutputPermit
    AND fbBatchStorageUnit.xStorageForksRightCmd;

FIO.xStorageLiftCmd :=
    xStorageOutputPermit
    AND fbBatchStorageUnit.xStorageLiftCmd;

FIO.xStorageLoadConveyorCmd :=
    xStorageOutputPermit
    AND fbBatchStorageUnit.xStorageLoadConveyorCmd;

FIO.xStorageUnloadConveyorCmd := FALSE;

// Packout stack light
FIO.xPackoutStackGreenCmd  := FIO.xMasterStackGreenCmd;
FIO.xPackoutStackRedCmd    := FIO.xMasterStackRedCmd;
FIO.xPackoutStackYellowCmd := FIO.xMasterStackYellowCmd;

// Plant stack light
FIO.xPlantStackGreenCmd  := FIO.xMasterStackGreenCmd;
FIO.xPlantStackRedCmd    := FIO.xMasterStackRedCmd;
FIO.xPlantStackYellowCmd := FIO.xMasterStackYellowCmd;

// Storage stack light
FIO.xStorageStackGreenCmd  := FIO.xMasterStackGreenCmd;
FIO.xStorageStackRedCmd    := FIO.xMasterStackRedCmd;
FIO.xStorageStackYellowCmd := FIO.xMasterStackYellowCmd;

// Tank stack light
FIO.xTankStackGreenCmd  := FIO.xMasterStackGreenCmd;
FIO.xTankStackRedCmd    := FIO.xMasterStackRedCmd;
FIO.xTankStackYellowCmd := FIO.xMasterStackYellowCmd;</Single>
