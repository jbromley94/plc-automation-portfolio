                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224918426459756</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Detect state transitions.
xStateChanged := eState &lt;&gt; ePreviousState;

IF xStateChanged THEN
    xSawXMotion := FALSE;
    xSawZMotion := FALSE;
END_IF

IF xMovingX THEN
    xSawXMotion := TRUE;
END_IF

IF xMovingZ THEN
    xSawZMotion := TRUE;
END_IF

fbHomeStable(
    IN :=
        xEnable
        AND xRun
        AND (eState = E_PackoutLoaderState.Homing)
        AND NOT xMovingX
        AND NOT xMovingZ,
    PT := T#500MS
);

xTimedState :=
    (eState &lt;&gt; E_PackoutLoaderState.Stopped)
    AND (eState &lt;&gt; E_PackoutLoaderState.WaitingForCarrier)
    AND (eState &lt;&gt; E_PackoutLoaderState.WaitingForProduct)
    AND
    (eState &lt;&gt;
        E_PackoutLoaderState.WaitingForLoadAcceptance)
    AND (eState &lt;&gt; E_PackoutLoaderState.Complete)
    AND (eState &lt;&gt; E_PackoutLoaderState.Faulted);

fbStepTimeout(
    IN :=
        xEnable
        AND xRun
        AND xTimedState
        AND NOT xStateChanged,
    PT := tStepTimeout
);

fbGrabSettle(
    IN :=
        xEnable
        AND xRun
        AND
        (eState = E_PackoutLoaderState.GrippingProduct),
    PT := T#500MS
);

fbReleaseSettle(
    IN :=
        xEnable
        AND xRun
        AND
        (eState = E_PackoutLoaderState.ReleasingProduct),
    PT := T#500MS
);

ePreviousState := eState;

// Safe defaults.
xBufferConveyor1Cmd := FALSE;
xBufferConveyor2Cmd := FALSE;
xBufferConveyor3Cmd := FALSE;
xBusy := FALSE;
xCarrierReq := FALSE;
xGrabCmd := FALSE;
xLoadComplete := FALSE;
xMoveXCmd := FALSE;
xMoveZCmd := FALSE;
xPickConveyorCmd := FALSE;
xProductTransferAck := FALSE;
xProductTransferReady := FALSE;
xReady := FALSE;

IF xReset THEN
    diProductCount := 0;
    eState := E_PackoutLoaderState.Stopped;
    ePreviousState := E_PackoutLoaderState.Stopped;
    uiFaultCode := 0;
    xFaulted := FALSE;
    xProductAccepted := FALSE;
    xSawXMotion := FALSE;
    xSawZMotion := FALSE;

ELSIF NOT xEnable THEN
    eState := E_PackoutLoaderState.Stopped;
    ePreviousState := E_PackoutLoaderState.Stopped;
    uiFaultCode := 0;
    xFaulted := FALSE;
    xProductAccepted := FALSE;
    xSawXMotion := FALSE;
    xSawZMotion := FALSE;

ELSIF xRun THEN
    CASE eState OF

        E_PackoutLoaderState.Stopped:
            xFaulted := FALSE;
            eState := E_PackoutLoaderState.Homing;


        E_PackoutLoaderState.Homing:
            // Both monostable axes return home with commands removed.
            IF fbHomeStable.Q THEN
                eState :=
                    E_PackoutLoaderState.WaitingForCarrier;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 501;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.WaitingForCarrier:
            xCarrierReq := TRUE;
            xReady := TRUE;

            IF xCarrierReady THEN
                eState :=
                    E_PackoutLoaderState.WaitingForProduct;
            END_IF


        E_PackoutLoaderState.WaitingForProduct:
            xReady := TRUE;

            IF NOT xCarrierReady THEN
                eState :=
                    E_PackoutLoaderState.WaitingForCarrier;

            ELSE
                // A product already staged at the pick sensor
                // must not withdraw the loader's readiness.
                xProductTransferReady := NOT xProductLoaded;

                IF xProductTransferPermit THEN
                    xBufferConveyor1Cmd := NOT xProductAtPick;
                    xBufferConveyor2Cmd := NOT xProductAtPick;
                    xBufferConveyor3Cmd := NOT xProductAtPick;
                    xPickConveyorCmd := NOT xProductAtPick;

                    IF xProductAtPick THEN
                        xProductAccepted := TRUE;
                        eState :=
                            E_PackoutLoaderState.MovingToProduct;
                    END_IF
                END_IF
            END_IF


        E_PackoutLoaderState.MovingToProduct:
            xBusy := TRUE;
            xMoveXCmd := TRUE;

            IF xSawXMotion AND NOT xMovingX THEN
                eState :=
                    E_PackoutLoaderState.LoweringToProduct;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 503;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.LoweringToProduct:
            xBusy := TRUE;
            xMoveXCmd := TRUE;
            xMoveZCmd := TRUE;

            IF xSawZMotion AND NOT xMovingZ THEN
                eState :=
                    E_PackoutLoaderState.GrippingProduct;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 504;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.GrippingProduct:
            xBusy := TRUE;
            xGrabCmd := TRUE;
            xMoveXCmd := TRUE;
            xMoveZCmd := TRUE;

            IF fbGrabSettle.Q AND xItemDetected THEN
                eState :=
                    E_PackoutLoaderState.RaisingProduct;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 505;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.RaisingProduct:
            xBusy := TRUE;
            xGrabCmd := TRUE;
            xMoveXCmd := TRUE;

            IF xSawZMotion AND NOT xMovingZ THEN
                eState :=
                    E_PackoutLoaderState.MovingToCarrier;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 506;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.MovingToCarrier:
            xBusy := TRUE;
            xGrabCmd := TRUE;

            // Removing the X command retracts the monostable
            // horizontal axis towards the carrier.
            IF xSawXMotion AND NOT xMovingX THEN
                eState :=
                    E_PackoutLoaderState.LoweringToCarrier;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 507;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.LoweringToCarrier:
            xBusy := TRUE;
            xGrabCmd := TRUE;
            xMoveZCmd := TRUE;

            IF xSawZMotion AND NOT xMovingZ THEN
                eState :=
                    E_PackoutLoaderState.ReleasingProduct;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 508;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.ReleasingProduct:
            xBusy := TRUE;
            xMoveZCmd := TRUE;

            IF fbReleaseSettle.Q AND NOT xItemDetected THEN
                eState :=
                    E_PackoutLoaderState.RaisingFromCarrier;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 509;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.RaisingFromCarrier:
            xBusy := TRUE;

            IF xSawZMotion AND NOT xMovingZ THEN
                eState :=
                    E_PackoutLoaderState.ReturningHome;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 510;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.ReturningHome:
            xBusy := TRUE;

            IF NOT xMovingX AND NOT xMovingZ THEN
                eState :=
                    E_PackoutLoaderState.VerifyingLoad;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 511;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.VerifyingLoad:
            xBusy := TRUE;

            IF xCarrierReady AND xProductLoaded THEN
                diProductCount := diProductCount + 1;
                eState :=
                    E_PackoutLoaderState
                        .WaitingForLoadAcceptance;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 512;
                xFaulted := TRUE;
                eState := E_PackoutLoaderState.Faulted;
            END_IF


        E_PackoutLoaderState.WaitingForLoadAcceptance:
            xBusy := TRUE;
            xLoadComplete := TRUE;

            IF xLoadAccepted THEN
                eState := E_PackoutLoaderState.Complete;
            END_IF


        E_PackoutLoaderState.Complete:
            // Wait for the carrier station to clear acknowledgement.
            IF NOT xLoadAccepted THEN
                eState :=
                    E_PackoutLoaderState.WaitingForCarrier;
            END_IF


        E_PackoutLoaderState.Faulted:
            xFaulted := TRUE;


    ELSE
        uiFaultCode := 599;
        xFaulted := TRUE;
        eState := E_PackoutLoaderState.Faulted;

    END_CASE
END_IF

// A controlled Stop preserves the current transaction.
// The monostable axes retain the command appropriate to the
// current sequence state.
IF xEnable AND NOT xRun AND NOT xFaulted THEN
    xBusy :=
        (eState = E_PackoutLoaderState.MovingToProduct)
        OR (eState = E_PackoutLoaderState.LoweringToProduct)
        OR (eState = E_PackoutLoaderState.GrippingProduct)
        OR (eState = E_PackoutLoaderState.RaisingProduct)
        OR (eState = E_PackoutLoaderState.MovingToCarrier)
        OR (eState = E_PackoutLoaderState.LoweringToCarrier)
        OR (eState = E_PackoutLoaderState.ReleasingProduct)
        OR (eState = E_PackoutLoaderState.RaisingFromCarrier)
        OR (eState = E_PackoutLoaderState.ReturningHome)
        OR (eState = E_PackoutLoaderState.VerifyingLoad)
        OR
        (eState =
            E_PackoutLoaderState.WaitingForLoadAcceptance);

    xGrabCmd :=
        (eState = E_PackoutLoaderState.GrippingProduct)
        OR (eState = E_PackoutLoaderState.RaisingProduct)
        OR (eState = E_PackoutLoaderState.MovingToCarrier)
        OR (eState = E_PackoutLoaderState.LoweringToCarrier);

    xLoadComplete :=
        eState =
            E_PackoutLoaderState.WaitingForLoadAcceptance;

    xMoveXCmd :=
        (eState = E_PackoutLoaderState.MovingToProduct)
        OR (eState = E_PackoutLoaderState.LoweringToProduct)
        OR (eState = E_PackoutLoaderState.GrippingProduct)
        OR (eState = E_PackoutLoaderState.RaisingProduct);

    xMoveZCmd :=
        (eState = E_PackoutLoaderState.LoweringToProduct)
        OR (eState = E_PackoutLoaderState.GrippingProduct)
        OR (eState = E_PackoutLoaderState.LoweringToCarrier)
        OR (eState = E_PackoutLoaderState.ReleasingProduct);
END_IF

// Hold acknowledgement until the coordinator removes its permit.
xProductTransferAck := xProductAccepted;

IF xProductAccepted
    AND xRun
    AND NOT xProductTransferPermit
THEN
    xProductAccepted := FALSE;
    xProductTransferAck := FALSE;
END_IF

// Faults remove every command and handshake.
IF xFaulted THEN
    xBufferConveyor1Cmd := FALSE;
    xBufferConveyor2Cmd := FALSE;
    xBufferConveyor3Cmd := FALSE;
    xCarrierReq := FALSE;
    xGrabCmd := FALSE;
    xLoadComplete := FALSE;
    xMoveXCmd := FALSE;
    xMoveZCmd := FALSE;
    xPickConveyorCmd := FALSE;
    xProductAccepted := FALSE;
    xProductTransferAck := FALSE;
    xProductTransferReady := FALSE;
    xReady := FALSE;
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">5bdb6c0f-0aec-4fc5-acea-6717ad46b9e3_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_PackoutLoader
VAR_INPUT
    tStepTimeout            : TIME := T#20S;
    xCarrierReady           : BOOL;
    xEnable                 : BOOL;
    xItemDetected           : BOOL;
    xLoadAccepted           : BOOL;
    xMovingX                : BOOL;
    xMovingZ                : BOOL;
    xProductAtPick          : BOOL;
    xProductLoaded          : BOOL;
    xProductTransferPermit  : BOOL;
    xReset                  : BOOL;
	xRun                    : BOOL;
END_VAR
VAR_OUTPUT
    diProductCount          : DINT;
    eState                  : E_PackoutLoaderState :=
                                  E_PackoutLoaderState.Stopped;
    uiFaultCode             : UINT;
    xBufferConveyor1Cmd     : BOOL;
    xBufferConveyor2Cmd     : BOOL;
    xBufferConveyor3Cmd     : BOOL;
    xBusy                   : BOOL;
    xCarrierReq             : BOOL;
    xFaulted                : BOOL;
    xGrabCmd                : BOOL;
    xLoadComplete           : BOOL;
    xMoveXCmd               : BOOL;
    xMoveZCmd               : BOOL;
    xPickConveyorCmd        : BOOL;
    xProductTransferAck     : BOOL;
    xProductTransferReady   : BOOL;
    xReady                  : BOOL;
END_VAR
VAR
    ePreviousState  : E_PackoutLoaderState :=
                          E_PackoutLoaderState.Stopped;
    fbGrabSettle     : TON;
	fbHomeStable     : TON;
    fbReleaseSettle  : TON;
    fbStepTimeout    : TON;
	xProductAccepted : BOOL;
    xSawXMotion      : BOOL;
    xSawZMotion      : BOOL;
    xStateChanged    : BOOL;
    xTimedState      : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">5bdb6c0f-0aec-4fc5-acea-6717ad46b9e3_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">1828</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">POUs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">fecb39fd-6f68-4bfb-a787-20c3178cecf6</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_PairDiverter</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224822545810499</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Count products crossing the dedicated total-count sensor.
fbCountEdge(CLK := xCountDetected);

// Release the lid two seconds after releasing the base.
fbLidReleaseDelay(
    IN :=
        xRun
        AND (eState = E_PairDiverterState.ReleasingBase),
    PT := T#2S
);

// Move the detected lid from the approach sensor to the
// centreline of the pusher before extending the pusher.
fbLidPositionDelay(
    IN :=
        xRun
        AND
        (eState = E_PairDiverterState.PositioningLid),
    PT := tLidPositionTime
);

// Reset the step timeout whenever the state changes.
xStateChanged := eState &lt;&gt; ePreviousState;

xTimeoutActive :=
    (eState &lt;&gt; E_PairDiverterState.Idle)
    AND (eState &lt;&gt; E_PairDiverterState.Complete)
    AND (eState &lt;&gt; E_PairDiverterState.Faulted)
    AND NOT xStateChanged;

fbStepTimeout(
    IN := xRun AND xTimeoutActive,
    PT := tStepTimeout
);

ePreviousState := eState;

// Default every command and pulse off.
xBaseCurveConveyorCmd := FALSE;
xBasesOutfeedCmd := FALSE;
xComplete := FALSE;
xInfeedConveyorCmd := FALSE;
xLidsOutfeedCmd := FALSE;
xPusherCmd := FALSE;
xPusherZoneConveyorCmd := FALSE;

IF xReset THEN
    diDetectionCount := 0;
    eState := E_PairDiverterState.Idle;
    ePreviousState := E_PairDiverterState.Idle;
    uiFaultCode := 0;
    xFaulted := FALSE;

ELSIF NOT xEnable THEN
    eState := E_PairDiverterState.Idle;
    ePreviousState := E_PairDiverterState.Idle;
    uiFaultCode := 0;
    xFaulted := FALSE;

ELSIF xRun THEN
    IF fbCountEdge.Q THEN
        diDetectionCount := diDetectionCount + 1;
    END_IF

    CASE eState OF

        E_PairDiverterState.Idle:
            xFaulted := FALSE;

            IF xTransferPermit
                AND NOT xAssemblyBaseAtPlace
                AND NOT xAssemblyLidAtPlace
                AND NOT xPartAtPusher
                AND xPusherAtBack
            THEN
                eState := E_PairDiverterState.ReleasingBase;
            END_IF


        E_PairDiverterState.ReleasingBase:
            // Start the base route first.
            xBaseCurveConveyorCmd := TRUE;
            xBasesOutfeedCmd := TRUE;
            xInfeedConveyorCmd := TRUE;
            xPusherZoneConveyorCmd := TRUE;

            IF fbLidReleaseDelay.Q THEN
                eState := E_PairDiverterState.ReleasingLid;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 301;
                xFaulted := TRUE;
                eState := E_PairDiverterState.Faulted;
            END_IF


        E_PairDiverterState.ReleasingLid:
            // Keep the base moving and start the lid two seconds behind.
            xBaseCurveConveyorCmd := NOT xAssemblyBaseAtPlace;
            xBasesOutfeedCmd := NOT xAssemblyBaseAtPlace;
            xInfeedConveyorCmd := TRUE;
            xLidsOutfeedCmd := TRUE;
            xPusherZoneConveyorCmd := TRUE;

            // The first item reaching the pusher is the base.
            // It must pass without a pusher command.
            IF xPartAtPusher THEN
                eState := E_PairDiverterState.PassingBase;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 302;
                xFaulted := TRUE;
                eState := E_PairDiverterState.Faulted;
            END_IF


        E_PairDiverterState.PassingBase:
            xBaseCurveConveyorCmd := NOT xAssemblyBaseAtPlace;
            xBasesOutfeedCmd := NOT xAssemblyBaseAtPlace;
            xInfeedConveyorCmd := TRUE;
            xLidsOutfeedCmd := TRUE;
            xPusherZoneConveyorCmd := TRUE;

            // The base has passed once it clears the pusher sensor.
            IF NOT xPartAtPusher THEN
                eState := E_PairDiverterState.WaitingForLidAtPusher;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 303;
                xFaulted := TRUE;
                eState := E_PairDiverterState.Faulted;
            END_IF


        E_PairDiverterState.WaitingForLidAtPusher:
            xBaseCurveConveyorCmd := NOT xAssemblyBaseAtPlace;
            xBasesOutfeedCmd := NOT xAssemblyBaseAtPlace;
            xInfeedConveyorCmd := TRUE;
            xLidsOutfeedCmd := TRUE;
            xPusherZoneConveyorCmd := TRUE;

            IF xPartAtPusher THEN
                // The lid must be the second/even detected product.
                IF (diDetectionCount &gt; 0)
                    AND ((diDetectionCount MOD 2) = 0)
                THEN
                    eState := E_PairDiverterState.PositioningLid;
                ELSE
                    uiFaultCode := 312;
                    xFaulted := TRUE;
                    eState := E_PairDiverterState.Faulted;
                END_IF

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 304;
                xFaulted := TRUE;
                eState := E_PairDiverterState.Faulted;
            END_IF


        E_PairDiverterState.PositioningLid:
		// The approach sensor has already latched the lid's arrival.
		// Index it forwards briefly until centred on the pusher.
		xBaseCurveConveyorCmd := NOT xAssemblyBaseAtPlace;
		xBasesOutfeedCmd := NOT xAssemblyBaseAtPlace;
		xInfeedConveyorCmd := NOT fbLidPositionDelay.Q;
		xPusherZoneConveyorCmd := NOT fbLidPositionDelay.Q;
	
		IF fbLidPositionDelay.Q AND xPusherAtBack THEN
			eState := E_PairDiverterState.PushingLid;
	
		ELSIF fbStepTimeout.Q THEN
			uiFaultCode := 305;
			xFaulted := TRUE;
			eState := E_PairDiverterState.Faulted;
    	END_IF


        E_PairDiverterState.PushingLid:
            xBaseCurveConveyorCmd := NOT xAssemblyBaseAtPlace;
            xBasesOutfeedCmd := NOT xAssemblyBaseAtPlace;
            xPusherCmd := TRUE;

            IF xPusherAtFront THEN
                eState := E_PairDiverterState.WaitingForPartsAtPlace;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 306;
                xFaulted := TRUE;
                eState := E_PairDiverterState.Faulted;
            END_IF


        E_PairDiverterState.WaitingForPartsAtPlace:
            // Removing the command retracts the monostable pusher.
            xBaseCurveConveyorCmd := NOT xAssemblyBaseAtPlace;
            xBasesOutfeedCmd := NOT xAssemblyBaseAtPlace;
            xPusherZoneConveyorCmd := NOT xAssemblyLidAtPlace;

            IF xAssemblyBaseAtPlace
                AND xAssemblyLidAtPlace
                AND xPusherAtBack
            THEN
                eState := E_PairDiverterState.Complete;

            ELSIF fbStepTimeout.Q THEN
                uiFaultCode := 307;
                xFaulted := TRUE;
                eState := E_PairDiverterState.Faulted;
            END_IF


        E_PairDiverterState.Complete:
            xComplete := TRUE;

            IF NOT xTransferPermit THEN
                eState := E_PairDiverterState.Idle;
            END_IF


        E_PairDiverterState.Faulted:
            xFaulted := TRUE;


    ELSE
        uiFaultCode := 399;
        xFaulted := TRUE;
        eState := E_PairDiverterState.Faulted;

    END_CASE
END_IF

// A fault removes all physical commands.
IF xFaulted THEN
    xBaseCurveConveyorCmd := FALSE;
    xBasesOutfeedCmd := FALSE;
    xInfeedConveyorCmd := FALSE;
    xLidsOutfeedCmd := FALSE;
    xPusherCmd := FALSE;
    xPusherZoneConveyorCmd := FALSE;
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">fecb39fd-6f68-4bfb-a787-20c3178cecf6_Impl_LineIds</Single>
          </Single>
        </Single>
