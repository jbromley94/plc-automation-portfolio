            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224689375430866</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Twin Cell owns both machining-cell instances.
fbBasesMachiningCell(
	tProcessTimeout := T#90S,
    xAtEntry := xTwinCellBasesEntryDetected,
    xAtExit := xTwinCellBasesExitDetected,
    xCenterBusy := xTwinCellBasesCenterBusy,
    xCenterHasError := xTwinCellBasesCenterHasError,
    xCenterOpened := xTwinCellBasesCenterOpened,
    xEnable := xEnable,
    xProduceLids := FALSE,
	xRequest := xProductionRequest,
    xReset := xReset,
    xRun := xRun
);

fbLidsMachiningCell(
	tProcessTimeout := T#90S,
    xAtEntry := xTwinCellLidsEntryDetected,
    xAtExit := xTwinCellLidsExitDetected,
    xCenterBusy := xTwinCellLidsCenterBusy,
    xCenterHasError := xTwinCellLidsCenterHasError,
    xCenterOpened := xTwinCellLidsCenterOpened,
    xEnable := xEnable,
    xProduceLids := TRUE,
	xRequest := xProductionRequest,
    xReset := xReset,
    xRun := xRun
);

// Publish both machining-cell boundaries.
diBasesCount := fbBasesMachiningCell.diCount;
diLidsCount := fbLidsMachiningCell.diCount;

uiBasesFaultCode := fbBasesMachiningCell.uiFaultCode;
uiLidsFaultCode := fbLidsMachiningCell.uiFaultCode;

xBasesBusy := fbBasesMachiningCell.xBusy;
xBasesCenterProduceCmd :=
    fbBasesMachiningCell.xCenterProduceCmd;
xBasesCenterResetCmd :=
    fbBasesMachiningCell.xCenterResetCmd;
xBasesCenterStartCmd :=
    fbBasesMachiningCell.xCenterStartCmd;
xBasesCenterStopCmd :=
    fbBasesMachiningCell.xCenterStopCmd;
xBasesEmitterCmd := fbBasesMachiningCell.xEmitterCmd;
xBasesExitConveyor1Cmd :=
    fbBasesMachiningCell.xExitConveyor1Cmd;
xBasesExitConveyor2Cmd :=
    fbBasesMachiningCell.xExitConveyor2Cmd;
xBasesFaulted := fbBasesMachiningCell.xFaulted;
xBasesRawConveyorCmd :=
    fbBasesMachiningCell.xRawConveyorCmd;
xBasesReady := fbBasesMachiningCell.xReady;

xLidsBusy := fbLidsMachiningCell.xBusy;
xLidsCenterProduceCmd :=
    fbLidsMachiningCell.xCenterProduceCmd;
xLidsCenterResetCmd :=
    fbLidsMachiningCell.xCenterResetCmd;
xLidsCenterStartCmd :=
    fbLidsMachiningCell.xCenterStartCmd;
xLidsCenterStopCmd :=
    fbLidsMachiningCell.xCenterStopCmd;
xLidsEmitterCmd := fbLidsMachiningCell.xEmitterCmd;
xLidsExitConveyor1Cmd :=
    fbLidsMachiningCell.xExitConveyor1Cmd;
xLidsExitConveyor2Cmd :=
    fbLidsMachiningCell.xExitConveyor2Cmd;
xLidsFaulted := fbLidsMachiningCell.xFaulted;
xLidsRawConveyorCmd :=
    fbLidsMachiningCell.xRawConveyorCmd;
xLidsReady := fbLidsMachiningCell.xReady;

// =============================================================
// UNIT STATUS DEFAULTS
// =============================================================

xFaulted := xBasesFaulted OR xLidsFaulted;

xBusy :=
    xBasesBusy
    OR xLidsBusy
    OR xPairPending
    OR xWaitForExitClear;

xPairReq := FALSE;
xReady := FALSE;

// Prefix the child fault code so its source remains identifiable.
IF xBasesFaulted THEN
    uiFaultCode := UINT#1000 + uiBasesFaultCode;

ELSIF xLidsFaulted THEN
    uiFaultCode := UINT#2000 + uiLidsFaultCode;

ELSE
    uiFaultCode := 0;
END_IF

// =============================================================
// RESET, FAULT AND RUN PRIORITIES
// =============================================================

// Reset clears both child faults, the pending transaction
// and the completed-pair count.
IF xReset THEN
    diPairCount := 0;
    uiFaultCode := 0;
    xFaulted := FALSE;
    xPairPending := FALSE;
    xWaitForExitClear := FALSE;

// A child-cell fault abandons any untransferred pair.
ELSIF xFaulted THEN
    xPairPending := FALSE;
    xWaitForExitClear := FALSE;

// Disabling the unit abandons any untransferred request,
// but retains the production counts.
ELSIF NOT xEnable THEN
    xPairPending := FALSE;
    xWaitForExitClear := FALSE;

// A controlled Stop freezes transaction memory.
ELSIF xRun THEN

    // After a pair is accepted, require both P10 exit sensors
    // to clear before recognising another completed pair.
    IF xWaitForExitClear THEN
		IF NOT fbBasesMachiningCell.xDone
			AND NOT fbLidsMachiningCell.xDone
		THEN
			xWaitForExitClear := FALSE;
		END_IF
	
	ELSIF NOT xPairPending
		AND fbBasesMachiningCell.xDone
		AND fbLidsMachiningCell.xDone
	THEN
		xPairPending := TRUE;
	END_IF

    // Acceptance means the P10-to-P11 transfer completed.
    IF xPairPending AND xPairAccepted THEN
        diPairCount := diPairCount + 1;
        xPairPending := FALSE;
        xWaitForExitClear := TRUE;
    END_IF

    xPairReq := xPairPending;

    xBusy :=
        xBasesBusy
        OR xLidsBusy
        OR xPairPending
        OR xWaitForExitClear;

    xReady :=
        xBasesReady
        AND xLidsReady
        AND NOT xPairPending
        AND NOT xWaitForExitClear;
END_IF

// A fault removes every externally advertised transaction signal.
IF xFaulted THEN
    xBusy := FALSE;
    xPairReq := FALSE;
    xReady := FALSE;
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">bebb3004-1b86-44c9-85e1-7ac5a0bc9594_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_TwinCellUnit
VAR_INPUT
    xEnable                         : BOOL;
    xPairAccepted                   : BOOL;
	xProductionRequest 				: BOOL;
    xReset                          : BOOL;
    xRun                            : BOOL;
    xTwinCellBasesCenterBusy        : BOOL;
    xTwinCellBasesCenterHasError    : BOOL;
    xTwinCellBasesCenterOpened      : BOOL;
    xTwinCellBasesEntryDetected     : BOOL;
    xTwinCellBasesExitDetected      : BOOL;
    xTwinCellLidsCenterBusy         : BOOL;
    xTwinCellLidsCenterHasError     : BOOL;
    xTwinCellLidsCenterOpened       : BOOL;
    xTwinCellLidsEntryDetected      : BOOL;
    xTwinCellLidsExitDetected       : BOOL;
END_VAR
VAR_OUTPUT
    diBasesCount               : DINT;
    diLidsCount                : DINT;
    diPairCount                : DINT;
    uiBasesFaultCode           : UINT;
    uiFaultCode                : UINT;
    uiLidsFaultCode            : UINT;
    xBasesBusy                 : BOOL;
    xBasesCenterProduceCmd     : BOOL;
    xBasesCenterResetCmd       : BOOL;
    xBasesCenterStartCmd       : BOOL;
    xBasesCenterStopCmd        : BOOL;
    xBasesEmitterCmd           : BOOL;
    xBasesExitConveyor1Cmd     : BOOL;
    xBasesExitConveyor2Cmd     : BOOL;
    xBasesFaulted              : BOOL;
    xBasesRawConveyorCmd       : BOOL;
    xBasesReady                : BOOL;
    xBusy                      : BOOL;
    xFaulted                   : BOOL;
    xLidsBusy                  : BOOL;
    xLidsCenterProduceCmd      : BOOL;
    xLidsCenterResetCmd        : BOOL;
    xLidsCenterStartCmd        : BOOL;
    xLidsCenterStopCmd         : BOOL;
    xLidsEmitterCmd            : BOOL;
    xLidsExitConveyor1Cmd      : BOOL;
    xLidsExitConveyor2Cmd      : BOOL;
    xLidsFaulted               : BOOL;
    xLidsRawConveyorCmd        : BOOL;
    xLidsReady                 : BOOL;
    xPairReq                   : BOOL;
    xReady                     : BOOL;
END_VAR
VAR
    fbBasesMachiningCell : FB_MachiningCell;
    fbLidsMachiningCell  : FB_MachiningCell;
    xPairPending         : BOOL;
    xWaitForExitClear    : BOOL;
END_VAR</Single>
