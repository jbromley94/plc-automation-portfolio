      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">3160de3d-5d5c-440b-a679-9771b598c046</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_TransferCoordinator</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224326655375200</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Default pulse outputs.
xComplete := FALSE;

// A controlled zone Stop removes permission while preserving state.
xPermit := FALSE;

// The timeout runs during every active handshake stage.
xTimeoutEnable :=
    (eState = E_TransferState.WaitingForReady)
    OR (eState = E_TransferState.Transferring)
    OR (eState = E_TransferState.WaitingForRequestClear);

fbTransferTimeout(
    IN := xRun AND xTimeoutEnable,
    PT := tTransferTimeout
);

// Reset has priority over every state.
IF xReset THEN
    eState := E_TransferState.Idle;
    uiFaultCode := 0;
    xFaulted := FALSE;
    xPermit := FALSE;

ELSIF NOT xEnable THEN
    eState := E_TransferState.Idle;
    uiFaultCode := 0;
    xFaulted := FALSE;
    xPermit := FALSE;

ELSIF xRun THEN
    CASE eState OF

        E_TransferState.Idle:
            xPermit := FALSE;

            IF xReq THEN
                eState := E_TransferState.WaitingForReady;
            END_IF


        E_TransferState.WaitingForReady:
            xPermit := FALSE;

            IF xReady THEN
                xPermit := TRUE;
                eState := E_TransferState.Transferring;

            ELSIF fbTransferTimeout.Q THEN
                uiFaultCode := 201;
                xFaulted := TRUE;
                eState := E_TransferState.Faulted;
            END_IF


        E_TransferState.Transferring:
            xPermit := TRUE;

            IF xAck THEN
                xPermit := FALSE;
                eState := E_TransferState.WaitingForRequestClear;

            ELSIF fbTransferTimeout.Q THEN
                uiFaultCode := 202;
                xFaulted := TRUE;
                xPermit := FALSE;
                eState := E_TransferState.Faulted;
            END_IF


        E_TransferState.WaitingForRequestClear:
            xPermit := FALSE;

            IF NOT xReq THEN
                xComplete := TRUE;
                eState := E_TransferState.Idle;

            ELSIF fbTransferTimeout.Q THEN
                uiFaultCode := 203;
                xFaulted := TRUE;
                eState := E_TransferState.Faulted;
            END_IF


        E_TransferState.Faulted:
            xPermit := FALSE;
            xFaulted := TRUE;


    ELSE
        uiFaultCode := 299;
        xFaulted := TRUE;
        xPermit := FALSE;
        eState := E_TransferState.Faulted;

    END_CASE
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">3160de3d-5d5c-440b-a679-9771b598c046_Impl_LineIds</Single>
          </Single>
