          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_PairDiverter
VAR_INPUT
	tLidPositionTime 		   : TIME := T#300MS;
    tStepTimeout               : TIME := T#15S;
    xAssemblyBaseAtPlace       : BOOL;
    xAssemblyLidAtPlace        : BOOL;
    xCountDetected             : BOOL;
    xEnable                    : BOOL;
    xPartAtPusher              : BOOL;
    xPusherAtBack              : BOOL;
    xPusherAtFront             : BOOL;
    xReset                     : BOOL;
	xRun					   : BOOL;
    xTransferPermit            : BOOL;
END_VAR
VAR_OUTPUT
    diDetectionCount       : DINT;
    eState                 : E_PairDiverterState := E_PairDiverterState.Idle;
    uiFaultCode            : UINT;
    xBaseCurveConveyorCmd  : BOOL;
    xBasesOutfeedCmd       : BOOL;
    xComplete              : BOOL;
    xFaulted               : BOOL;
    xInfeedConveyorCmd     : BOOL;
    xLidsOutfeedCmd        : BOOL;
    xPusherCmd             : BOOL;
    xPusherZoneConveyorCmd : BOOL;
END_VAR
VAR
    ePreviousState     : E_PairDiverterState := E_PairDiverterState.Idle;
    fbCountEdge        : R_TRIG;
	fbLidPositionDelay : TON;
    fbLidReleaseDelay  : TON;
    fbStepTimeout      : TON;
    xStateChanged      : BOOL;
    xTimeoutActive     : BOOL;
END_VAR</Single>
