    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">80e554fa-741a-42dd-acd6-04bb6798ff59</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_PlantCoordinator</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639222254967653969</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Safe defaults recalculated on every scan.
xAllowNewPair := FALSE;
xFaulted := FALSE;
xPairTransferEnable := FALSE;
xProductTransferEnable := FALSE;
xRecoveryRequired := FALSE;
xRunning := FALSE;

// Reset always returns the plant coordinator to a known state.
IF xReset THEN
    eProductionPhase := E_ProductionPhase.Idle;
    eState := E_PlantState.Stopped;
    uiFaultCode := 0;
    xStopPending := FALSE;

ELSIF xAnyFault THEN
    uiFaultCode := 401;
    xFaulted := TRUE;
    xStopPending := FALSE;
    eState := E_PlantState.Faulted;

ELSE
    CASE eState OF

        E_PlantState.Stopped:
            eProductionPhase := E_ProductionPhase.Idle;
            uiFaultCode := 0;
            xStopPending := FALSE;

            IF xEnable AND xAutoRun THEN
                eState := E_PlantState.Starting;
            END_IF


        E_PlantState.Starting:
            xRunning := TRUE;
            eProductionPhase := E_ProductionPhase.ReservingStorage;

            // Do not begin production without both downstream
            // availability and a reserved rack destination.
            IF xRackReservationValid AND xBatchStorageReady THEN
                eProductionPhase := E_ProductionPhase.ProducingPair;
                eState := E_PlantState.Running;

            ELSIF NOT xEnable THEN
                eState := E_PlantState.Stopped;
            END_IF


        E_PlantState.Running:
            xRunning := TRUE;

            // Releasing Auto Run requests a controlled stop.
            // The current transaction is allowed to finish.
            IF NOT xAutoRun THEN
                xStopPending := TRUE;
            END_IF

            CASE eProductionPhase OF

                E_ProductionPhase.Idle:
                    // No active product exists, so a requested stop
                    // can complete immediately.
                    IF xStopPending THEN
                        eState := E_PlantState.Stopping;

                    ELSIF xRackReservationValid
                        AND xBatchStorageReady
                    THEN
                        eProductionPhase :=
                            E_ProductionPhase.ProducingPair;
                    END_IF


                E_ProductionPhase.ReservingStorage:
                    IF xRackReservationValid
                        AND xBatchStorageReady
                    THEN
                        eProductionPhase :=
                            E_ProductionPhase.ProducingPair;
                    END_IF


                E_ProductionPhase.ProducingPair:
                    xAllowNewPair := NOT xStopPending;
                    xPairTransferEnable := TRUE;

                    IF xPairTransferComplete THEN
                        eProductionPhase :=
                            E_ProductionPhase.Assembling;
                    END_IF


                E_ProductionPhase.Assembling:
                    xProductTransferEnable := TRUE;

                    IF xProductTransferComplete THEN
                        eProductionPhase :=
                            E_ProductionPhase.WaitingForPackout;
                    END_IF


                E_ProductionPhase.WaitingForPackout:
                    // Packout/P9 detail is added when those equipment
                    // FBs are integrated. For now, downstream becoming
                    // busy proves that the loaded carrier was accepted.
                    IF NOT xBatchStorageReady THEN
                        eProductionPhase :=
                            E_ProductionPhase.Batching;
                    END_IF


                E_ProductionPhase.Batching:
                    // The rack commit confirms that the tank/storage
                    // transaction ultimately completed.
                    IF xRackCommitAck THEN
                        eProductionPhase :=
                            E_ProductionPhase.Complete;
                    END_IF


                E_ProductionPhase.Storing:
                    IF xRackCommitAck THEN
                        eProductionPhase :=
                            E_ProductionPhase.Complete;
                    END_IF


                E_ProductionPhase.Complete:
                    IF xStopPending THEN
                        eState := E_PlantState.Stopping;
                    ELSE
                        eProductionPhase :=
                            E_ProductionPhase.ReservingStorage;
                        eState := E_PlantState.Starting;
                    END_IF


            ELSE
                uiFaultCode := 402;
                eState := E_PlantState.Faulted;

            END_CASE


        E_PlantState.Stopping:
            // This state is reached only after the active load has
            // completed or when no load was active.
            eProductionPhase := E_ProductionPhase.Idle;
            xStopPending := FALSE;
            eState := E_PlantState.Stopped;


        E_PlantState.Faulted:
            xFaulted := TRUE;


        E_PlantState.RecoveryRequired:
            xRecoveryRequired := TRUE;


    ELSE
        uiFaultCode := 499;
        eState := E_PlantState.Faulted;

    END_CASE
END_IF

// Loss of the overall enable removes all permissions immediately.
IF NOT xEnable THEN
    xAllowNewPair := FALSE;
    xPairTransferEnable := FALSE;
    xProductTransferEnable := FALSE;
    xRunning := FALSE;

    IF eState &lt;&gt; E_PlantState.Faulted THEN
        eProductionPhase := E_ProductionPhase.Idle;
        eState := E_PlantState.Stopped;
        xStopPending := FALSE;
    END_IF
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">80e554fa-741a-42dd-acd6-04bb6798ff59_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_PlantCoordinator
VAR_INPUT
    xAnyFault                : BOOL;
    xAutoRun                 : BOOL;
    xBatchStorageReady       : BOOL;
    xEnable                  : BOOL;
    xPairTransferComplete    : BOOL;
    xProductTransferComplete : BOOL;
    xRackCommitAck           : BOOL;
    xRackReservationValid    : BOOL;
    xReset                   : BOOL;
END_VAR
VAR_OUTPUT
    eProductionPhase       : E_ProductionPhase := E_ProductionPhase.Idle;
    eState                 : E_PlantState := E_PlantState.Stopped;
    uiFaultCode            : UINT;
    xAllowNewPair          : BOOL;
    xFaulted               : BOOL;
    xPairTransferEnable    : BOOL;
    xProductTransferEnable : BOOL;
    xRecoveryRequired      : BOOL;
    xRunning               : BOOL;
    xStopPending           : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">80e554fa-741a-42dd-acd6-04bb6798ff59_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">222</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">POUs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">2463b2c5-bc87-434a-89b4-c707f84ffd72</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_RackManager</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639225209388909375</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Acknowledgements remain active until their requests return low.
IF NOT xCommitRequest THEN
    xCommitAck := FALSE;
END_IF;

IF NOT xReserveRequest THEN
    xReserveAck := FALSE;
END_IF;

// Reset clears control faults without deleting occupied inventory.
IF xReset
    AND NOT xCommitRequest
    AND NOT xReserveRequest
THEN
    xInvalidOperationFault := FALSE;

    IF xReservationValid THEN
        IF (wReservedPosition &gt;= 1)
            AND (wReservedPosition &lt;= 54)
            AND (
                aSlotState[WORD_TO_INT(wReservedPosition)]
                = E_RackSlotState.Reserved
            )
        THEN
            // If material may already have been deposited, quarantine
            // the slot instead of incorrectly marking it free.
            IF xReservationMayBeOccupied THEN
                aSlotState[WORD_TO_INT(wReservedPosition)] :=
                    E_RackSlotState.Unknown;
            ELSE
                aSlotState[WORD_TO_INT(wReservedPosition)] :=
                    E_RackSlotState.Free;
            END_IF;

            wReservedPosition := 0;
            xReservationValid := FALSE;
        ELSE
            xInvalidOperationFault := TRUE;
        END_IF;
    END_IF;
END_IF;

// Reserve and commit must never be requested simultaneously.
IF xCommitRequest AND xReserveRequest THEN
    xInvalidOperationFault := TRUE;
END_IF;

xFaulted := xInvalidOperationFault;

IF xEnable AND NOT xFaulted THEN
    // Commit the current reservation only after physical deposit.
    IF xCommitRequest AND NOT xCommitAck THEN
        IF xReservationValid
            AND (wReservedPosition &gt;= 1)
            AND (wReservedPosition &lt;= 54)
            AND (
                aSlotState[WORD_TO_INT(wReservedPosition)]
                = E_RackSlotState.Reserved
            )
        THEN
            aSlotState[WORD_TO_INT(wReservedPosition)] :=
                E_RackSlotState.Occupied;

            wReservedPosition := 0;
            xCommitAck := TRUE;
            xReservationValid := FALSE;
        ELSE
            xInvalidOperationFault := TRUE;
        END_IF;

    // Select the first available rack position.
    ELSIF xReserveRequest AND NOT xReserveAck THEN
        IF xReservationValid THEN
            xInvalidOperationFault := TRUE;
        ELSE
            wCandidatePosition := 0;
            wReservedPosition := 0;

            FOR iSlot := 1 TO 54 DO
                IF (wCandidatePosition = 0)
                    AND (
                        aSlotState[iSlot]
                        = E_RackSlotState.Free
                    )
                THEN
                    wCandidatePosition := INT_TO_WORD(iSlot);
                END_IF;
            END_FOR;

            IF wCandidatePosition &lt;&gt; 0 THEN
                aSlotState[WORD_TO_INT(wCandidatePosition)] :=
                    E_RackSlotState.Reserved;

                wReservedPosition := wCandidatePosition;
                xReservationValid := TRUE;
            END_IF;

            // Acknowledge even when full; ReservationValid reports
            // whether a position was successfully obtained.
            xReserveAck := TRUE;
        END_IF;
    END_IF;
END_IF;

// Recalculate rack inventory every scan.
uiFreeCount := 0;
uiOccupiedCount := 0;
uiReservedCount := 0;
uiUnknownCount := 0;

FOR iSlot := 1 TO 54 DO
    CASE aSlotState[iSlot] OF
        E_RackSlotState.Free:
            uiFreeCount := uiFreeCount + 1;

        E_RackSlotState.Occupied:
            uiOccupiedCount := uiOccupiedCount + 1;

        E_RackSlotState.Reserved:
            uiReservedCount := uiReservedCount + 1;

        E_RackSlotState.Unknown:
            uiUnknownCount := uiUnknownCount + 1;
    END_CASE;
END_FOR;

xFaulted := xInvalidOperationFault;
xRackFull := uiFreeCount = 0;</Single>
            <Single Name="LineInfoPersistence" Type="string">2463b2c5-bc87-434a-89b4-c707f84ffd72_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_RackManager
VAR_INPUT
    xCommitRequest            : BOOL;
    xEnable                   : BOOL;
    xReservationMayBeOccupied : BOOL;
    xReserveRequest           : BOOL;
    xReset                    : BOOL;
END_VAR

VAR_OUTPUT
    aSlotState       : ARRAY[1..54] OF E_RackSlotState;
    uiFreeCount      : UINT;
    uiOccupiedCount  : UINT;
    uiReservedCount  : UINT;
    uiUnknownCount   : UINT;
    wReservedPosition : WORD;
    xCommitAck       : BOOL;
    xFaulted         : BOOL;
    xRackFull        : BOOL;
    xReservationValid : BOOL;
    xReserveAck      : BOOL;
END_VAR

VAR
    iSlot                 : INT;
    wCandidatePosition    : WORD;
    xInvalidOperationFault : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">2463b2c5-bc87-434a-89b4-c707f84ffd72_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">170</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">POUs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">a84311e9-163d-4239-947a-c5760fa37f37</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_Storage</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639225246864017964</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Vertical movements do not provide dedicated raised/lowered
// feedback, so their travel is deliberately timed.
fbLiftTimer(
    IN :=
        xEnable
        AND xRun
        AND (eState = E_StorageState.LiftingProduct),
    PT := tLiftTime
);

fbLowerTimer(
    IN :=
        xEnable
        AND xRun
        AND (eState = E_StorageState.LoweringProduct),
    PT := tLowerTime
);

// Safe Boolean defaults.
xEntryConveyorCmd := FALSE;
xForksLeftCmd := FALSE;
xForksRightCmd := FALSE;
xLiftCmd := FALSE;
xLoadConveyorCmd := FALSE;
xReady := FALSE;

// Reset returns the module to a known, non-moving baseline.
IF xReset THEN
    eState := E_StorageState.Stopped;
    uiFaultCode := 0;
    wActivePosition := 0;
    wTargetPositionCmd := wHomePosition;
    xCommandArmed := FALSE;
    xDepositComplete := FALSE;
    xMotionStarted := FALSE;
    xReservationFault := FALSE;
    xStepTimeoutFault := FALSE;
END_IF;

// A Store request must return low before another is accepted.
IF xReset OR xFaulted THEN
    xCommandArmed := FALSE;

ELSIF NOT xStoreRequest THEN
    xCommandArmed := TRUE;
END_IF;

xFaulted :=
    xReservationFault
    OR xStepTimeoutFault;

IF xFaulted THEN
    eState := E_StorageState.Faulted;
END_IF;

// Removing Run pauses the current state and removes all Boolean
// motion commands. The transaction itself remains preserved.
IF xEnable
    AND xRun
    AND NOT xReset
    AND NOT xFaulted
THEN
    CASE eState OF

        E_StorageState.Stopped:
            wTargetPositionCmd := wHomePosition;

            IF xCraneAtHome AND xForkAtMiddle THEN
                eState := E_StorageState.Idle;
            ELSE
                xMotionStarted := FALSE;
                eState := E_StorageState.ReturningHome;
            END_IF;


        E_StorageState.Idle:
            wTargetPositionCmd := wHomePosition;

            IF xStoreRequest AND xCommandArmed THEN
                IF xReservationValid
                    AND (wReservedPosition &gt;= 1)
                    AND (wReservedPosition &lt;= 54)
                THEN
                    wActivePosition := wReservedPosition;
                    xCommandArmed := FALSE;
                    xDepositComplete := FALSE;
                    eState := E_StorageState.ReceivingProduct;
                ELSE
                    uiFaultCode := 710;
                    xReservationFault := TRUE;
                END_IF;
            END_IF;


        E_StorageState.ReceivingProduct:
            IF xProductAtLoad THEN
                eState := E_StorageState.ExtendingToLoad;
            ELSE
                xEntryConveyorCmd := TRUE;
                xLoadConveyorCmd := TRUE;
            END_IF;


        E_StorageState.ExtendingToLoad:
            xForksLeftCmd := TRUE;

            IF xForkAtLeft THEN
                eState := E_StorageState.LiftingProduct;
            END_IF;


        E_StorageState.LiftingProduct:
            xForksLeftCmd := TRUE;
            xLiftCmd := TRUE;

            IF fbLiftTimer.Q THEN
                eState := E_StorageState.RetractingWithProduct;
            END_IF;


        E_StorageState.RetractingWithProduct:
            xLiftCmd := TRUE;

            IF xForkAtMiddle THEN
                xMotionStarted := FALSE;
                eState := E_StorageState.MovingToRack;
            END_IF;


        E_StorageState.MovingToRack:
            wTargetPositionCmd := wActivePosition;
            xLiftCmd := TRUE;

            IF xMovingX OR xMovingZ THEN
                xMotionStarted := TRUE;
            END_IF;

            IF xMotionStarted
                AND NOT xMovingX
                AND NOT xMovingZ
            THEN
                xMotionStarted := FALSE;
                eState := E_StorageState.ExtendingToRack;
            END_IF;


        E_StorageState.ExtendingToRack:
            wTargetPositionCmd := wActivePosition;
            xForksRightCmd := TRUE;
            xLiftCmd := TRUE;

            IF xForkAtRight THEN
                eState := E_StorageState.LoweringProduct;
            END_IF;


        E_StorageState.LoweringProduct:
            wTargetPositionCmd := wActivePosition;
            xForksRightCmd := TRUE;

            IF fbLowerTimer.Q THEN
                eState :=
                    E_StorageState.RetractingAfterDeposit;
            END_IF;


        E_StorageState.RetractingAfterDeposit:
            wTargetPositionCmd := wActivePosition;

            IF xForkAtMiddle THEN
                xDepositComplete := TRUE;
                xMotionStarted := FALSE;
                eState := E_StorageState.ReturningHome;
            END_IF;


        E_StorageState.ReturningHome:
            wTargetPositionCmd := wHomePosition;

            IF xMovingX OR xMovingZ THEN
                xMotionStarted := TRUE;
            END_IF;

            IF xForkAtMiddle
                AND (
                    xCraneAtHome
                    OR (
                        xMotionStarted
                        AND NOT xMovingX
                        AND NOT xMovingZ
                    )
                )
            THEN
                xMotionStarted := FALSE;

                IF xDepositComplete THEN
                    eState := E_StorageState.Complete;
                ELSE
                    eState := E_StorageState.Idle;
                END_IF;
            END_IF;


        E_StorageState.Complete:
            wTargetPositionCmd := wHomePosition;

            // Hold completion until Batch Storage removes its request.
            IF NOT xStoreRequest THEN
                wActivePosition := 0;
                xDepositComplete := FALSE;
                eState := E_StorageState.Idle;
            END_IF;


        E_StorageState.Faulted:
            // Boolean outputs remain at their safe defaults.


    ELSE
        uiFaultCode := 799;
        xReservationFault := TRUE;
        eState := E_StorageState.Faulted;

    END_CASE;
END_IF;

// Only active physical steps use the common progress timeout.
xTimedStep :=
    (eState = E_StorageState.ReceivingProduct)
    OR (eState = E_StorageState.ExtendingToLoad)
    OR (eState = E_StorageState.LiftingProduct)
    OR (eState = E_StorageState.RetractingWithProduct)
    OR (eState = E_StorageState.MovingToRack)
    OR (eState = E_StorageState.ExtendingToRack)
    OR (eState = E_StorageState.LoweringProduct)
    OR (eState = E_StorageState.RetractingAfterDeposit)
    OR (eState = E_StorageState.ReturningHome);

xStateChanged := eState &lt;&gt; ePreviousState;

fbStepTimeout(
    IN :=
        xEnable
        AND xRun
        AND xTimedStep
        AND NOT xStateChanged,
    PT := tStepTimeout
);

ePreviousState := eState;

IF fbStepTimeout.Q THEN
    uiFaultCode := 711;
    xStepTimeoutFault := TRUE;
END_IF;

xFaulted :=
    xReservationFault
    OR xStepTimeoutFault;

// Remove commands immediately when a fault is discovered.
IF xFaulted THEN
    eState := E_StorageState.Faulted;
    xCommandArmed := FALSE;
    xEntryConveyorCmd := FALSE;
    xForksLeftCmd := FALSE;
    xForksRightCmd := FALSE;
    xLiftCmd := FALSE;
    xLoadConveyorCmd := FALSE;
END_IF;

// Public status.
xBusy :=
    (eState &lt;&gt; E_StorageState.Stopped)
    AND (eState &lt;&gt; E_StorageState.Idle)
    AND (eState &lt;&gt; E_StorageState.Complete)
    AND (eState &lt;&gt; E_StorageState.Faulted);

xReady :=
    xEnable
    AND xRun
    AND NOT xFaulted
    AND (eState = E_StorageState.Idle);

xStoreComplete :=
    NOT xFaulted
    AND (eState = E_StorageState.Complete);</Single>
            <Single Name="LineInfoPersistence" Type="string">a84311e9-163d-4239-947a-c5760fa37f37_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Storage
VAR_INPUT
    tLiftTime         : TIME := T#2S;
    tLowerTime        : TIME := T#2S;
    tStepTimeout      : TIME := T#30S;
    wHomePosition     : WORD := 55;
    wReservedPosition : WORD;
    xCraneAtHome      : BOOL;
    xEnable           : BOOL;
    xForkAtLeft       : BOOL;
    xForkAtMiddle     : BOOL;
    xForkAtRight      : BOOL;
    xMovingX          : BOOL;
    xMovingZ          : BOOL;
    xProductAtLoad    : BOOL;
    xReservationValid : BOOL;
    xReset            : BOOL;
    xRun              : BOOL;
    xStoreRequest     : BOOL;
END_VAR

VAR_OUTPUT
    eState                 : E_StorageState :=
                                 E_StorageState.Stopped;
    uiFaultCode            : UINT;
    wTargetPositionCmd     : WORD := 55;
    xBusy                  : BOOL;
    xDepositComplete       : BOOL;
    xEntryConveyorCmd      : BOOL;
    xFaulted               : BOOL;
    xForksLeftCmd          : BOOL;
    xForksRightCmd         : BOOL;
    xLiftCmd               : BOOL;
    xLoadConveyorCmd       : BOOL;
    xReady                 : BOOL;
    xStepTimeoutFault      : BOOL;
    xStoreComplete         : BOOL;
END_VAR

VAR
    ePreviousState    : E_StorageState :=
                            E_StorageState.Stopped;
    fbLiftTimer       : TON;
    fbLowerTimer      : TON;
    fbStepTimeout     : TON;
    wActivePosition   : WORD;
    xCommandArmed     : BOOL;
    xMotionStarted    : BOOL;
    xReservationFault : BOOL;
    xStateChanged     : BOOL;
    xTimedStep        : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">a84311e9-163d-4239-947a-c5760fa37f37_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">346</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">POUs</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">5e798833-813e-48d2-bc69-3081efcc6c33</Single>
        <Single Name="ParentGuid" Type="System.Guid">5bc7cd75-18b4-41eb-bf2d-ad70572f7649</Single>
        <Single Name="Name" Type="string">FB_Tank</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc928eb1-94be-43f5-92ca-1afd60cc72d6</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224959457308739</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Timeouts only run while their corresponding operation is active.
fbDischargeTimeout(
    IN :=
        xEnable
        AND NOT xReset
        AND (eState = E_TankState.Discharging),
    PT := tDischargeTimeout
);

fbFillTimeout(
    IN :=
        xEnable
        AND NOT xReset
        AND (eState = E_TankState.Filling),
    PT := tFillTimeout
);

// Safe one-scan defaults.
xBatchReady := FALSE;
xDischargeComplete := FALSE;
xDischargeValveCmd := FALSE;
xFillValveCmd := FALSE;
xReady := FALSE;

IF xReset THEN
    eState := E_TankState.Stopped;

    xDischargeTimeoutFault := FALSE;
    xFillTimeoutFault := FALSE;
    xHighHighFault := xLevelHighHigh;

ELSE
    // High-high is latched until a healthy reset.
    IF xLevelHighHigh THEN
        xHighHighFault := TRUE;
    END_IF

    IF fbDischargeTimeout.Q THEN
        xDischargeTimeoutFault := TRUE;
    END_IF

    IF fbFillTimeout.Q THEN
        xFillTimeoutFault := TRUE;
    END_IF

    xFaulted :=
        xDischargeTimeoutFault
        OR xFillTimeoutFault
        OR xHighHighFault;

    IF xFaulted THEN
        eState := E_TankState.Faulted;

    ELSIF xEnable THEN
        CASE eState OF

            E_TankState.Stopped:
                IF rLevelPct &gt;= rFillSetpointPct THEN
                    eState := E_TankState.BatchReady;
                ELSE
                    eState := E_TankState.Idle;
                END_IF


            E_TankState.Idle:
                IF xStartBatchReq THEN
                    eState := E_TankState.Filling;
                END_IF


            E_TankState.Filling:
                IF rLevelPct &gt;= rFillSetpointPct THEN
                    eState := E_TankState.BatchReady;
                ELSE
                    xFillValveCmd := TRUE;
                END_IF


            E_TankState.BatchReady:
                IF xDischargePermit THEN
                    eState := E_TankState.Discharging;
                END_IF


            E_TankState.Discharging:
                IF rLevelPct &lt;= rEmptySetpointPct THEN
                    // Hold completion until the owner removes
                    // its discharge permit.
                    xDischargeComplete := TRUE;

                    IF NOT xDischargePermit THEN
                        eState := E_TankState.Idle;
                    END_IF

                ELSIF xDischargePermit THEN
                    xDischargeValveCmd := TRUE;
                END_IF


            E_TankState.Faulted:
                // Reset is required to leave this state.


        ELSE
            xHighHighFault := TRUE;
            eState := E_TankState.Faulted;

        END_CASE
    END_IF
END_IF

// Publish persistent status after all state processing.
xFaulted :=
    xDischargeTimeoutFault
    OR xFillTimeoutFault
    OR xHighHighFault;

IF xFaulted THEN
    eState := E_TankState.Faulted;
    xDischargeComplete := FALSE;
    xDischargeValveCmd := FALSE;
    xFillValveCmd := FALSE;
END_IF

xBatchReady :=
    xEnable
    AND NOT xFaulted
    AND (eState = E_TankState.BatchReady);

xReady :=
    xEnable
    AND NOT xFaulted
    AND (eState = E_TankState.Idle);</Single>
            <Single Name="LineInfoPersistence" Type="string">5e798833-813e-48d2-bc69-3081efcc6c33_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Tank
VAR_INPUT
    rEmptySetpointPct : REAL := 5.0;
    rFillSetpointPct  : REAL := 80.0;
    rLevelPct         : REAL;

    tDischargeTimeout : TIME := T#2M;
    tFillTimeout      : TIME := T#2M;

    xDischargePermit  : BOOL;
    xEnable           : BOOL;
    xLevelHighHigh    : BOOL;
    xReset            : BOOL;
    xStartBatchReq    : BOOL;
END_VAR

VAR_OUTPUT
    eState                   : E_TankState :=
        E_TankState.Stopped;

    xBatchReady              : BOOL;
    xDischargeComplete       : BOOL;
    xDischargeTimeoutFault   : BOOL;
    xDischargeValveCmd       : BOOL;
    xFaulted                 : BOOL;
    xFillTimeoutFault        : BOOL;
    xFillValveCmd            : BOOL;
    xHighHighFault           : BOOL;
    xReady                   : BOOL;
END_VAR

VAR
    fbDischargeTimeout : TON;
    fbFillTimeout      : TON;
END_VAR</Single>
