      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">2fcd67e0-7f0e-4211-a016-12bc45183f68</Single>
        <Single Name="ParentGuid" Type="System.Guid">24a34fed-a682-4674-b097-383cfa9e689f</Single>
        <Single Name="Name" Type="string">FB_PairCoordinator</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639221384539327664</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// The clearance timer begins only after both cells have dropped
// their Done handshakes, cleared their exit sensors and returned Ready.
fbMergeClearance(
    IN :=
        xEnable
        AND (eState = E_PairCoordinatorState.MergeClearance)
        AND xLidsReady
        AND xBasesReady,
    PT := tMergeClearance
);


// Reset returns the complete paired sequence to a known condition.
IF xReset THEN
    xFaulted := FALSE;
    diPairsCompleted := 0;

    eState := E_PairCoordinatorState.Stopped;


// Any equipment fault latches the coordinator into Faulted.
ELSIF xAnyFault THEN
    xFaulted := TRUE;

    eState := E_PairCoordinatorState.Faulted;


// Disabling the plant freezes the active coordinator state.
ELSIF xEnable THEN

    CASE eState OF

        // -----------------------------------------------------
        // First enabled scan following Reset.
        // -----------------------------------------------------
        E_PairCoordinatorState.Stopped:

            eState := E_PairCoordinatorState.Ready;


        // -----------------------------------------------------
        // A pair begins only when both cells can accept it.
        // -----------------------------------------------------
        E_PairCoordinatorState.Ready:

			IF xAllowNewPair
			AND xBasesReady
			AND xLidsReady THEN
		
				eState :=
					E_PairCoordinatorState.WaitPairComplete;
			END_IF;


        // -----------------------------------------------------
        // Requests remain held until both cells acknowledge Done.
        // The base will normally finish first and wait here.
        // -----------------------------------------------------
        E_PairCoordinatorState.WaitPairComplete:

            IF xLidsDone AND xBasesDone THEN
                diPairsCompleted :=
                    diPairsCompleted + 1;

                eState :=
                    E_PairCoordinatorState.MergeClearance;
            END_IF;


        // -----------------------------------------------------
        // Wait for both exits and the shared merge path to clear.
        // -----------------------------------------------------
        E_PairCoordinatorState.MergeClearance:

            IF fbMergeClearance.Q THEN
                eState := E_PairCoordinatorState.Ready;
            END_IF;


        // -----------------------------------------------------
        // Latched until Reset.
        // -----------------------------------------------------
        E_PairCoordinatorState.Faulted:

            xFaulted := TRUE;


    ELSE
        xFaulted := TRUE;

        eState := E_PairCoordinatorState.Faulted;
    END_CASE;

END_IF;


// Held request/acknowledge handshake.
//
// Both requests are asserted together and disappear only when
// the coordinator leaves WaitPairComplete.
xLidsRequest :=
    xEnable
    AND NOT xFaulted
    AND
    (eState =
        E_PairCoordinatorState.WaitPairComplete);

xBasesRequest := xLidsRequest;</Single>
            <Single Name="LineInfoPersistence" Type="string">2fcd67e0-7f0e-4211-a016-12bc45183f68_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_PairCoordinator
VAR_INPUT
	xAllowNewPair : BOOL;
    xEnable   : BOOL;
    xReset    : BOOL;
    xAnyFault : BOOL;

    xLidsReady  : BOOL;
    xBasesReady : BOOL;
    xLidsDone   : BOOL;
    xBasesDone  : BOOL;

    tMergeClearance : TIME := T#2S;
END_VAR

VAR_OUTPUT
    xLidsRequest  : BOOL;
    xBasesRequest : BOOL;
    xFaulted      : BOOL;

    diPairsCompleted : DINT;

    eState : E_PairCoordinatorState :=
        E_PairCoordinatorState.Stopped;
END_VAR

VAR
    fbMergeClearance : TON;
END_VAR
</Single>
