        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">b0a6cb4e-084c-4586-947a-abdf837bc6e1</Single>
        <Single Name="ParentGuid" Type="System.Guid">24a34fed-a682-4674-b097-383cfa9e689f</Single>
        <Single Name="Name" Type="string">FB_OperatorControl</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639221324603308281</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// EDGE DETECTION
// =============================================================

rtReset(CLK := xResetPB);
rtStart(CLK := xStartPB);
rtStop(CLK := xStopPB);

// =============================================================
// OPERATING-MODE VALIDATION
//
// Exactly one selector position must be active.
// =============================================================

xAutoModeValid :=
    xAutoModeSelected
    AND NOT xManualModeSelected;

// A 500 ms pulse survives the CODESYS-Kepware-OPC-Factory I/O path.
// Reset is blocked while the emergency stop is active.
fbResetPulse(
    IN :=
        rtReset.Q
        AND NOT xEmergencyStop,
    PT := T#500MS
);

xResetPulse :=
    fbResetPulse.Q
    AND NOT xEmergencyStop;

// =============================================================
// OPERATOR COMMAND PRIORITIES
// =============================================================

IF xEmergencyStop THEN

    // Emergency stop immediately disables both machining cells.
    xResetRequired := TRUE;
    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF rtReset.Q THEN

    // Reset clears latched faults but never starts production.
    xResetRequired := FALSE;
    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF xPlantFaulted THEN

    // A fault in either cell stops the complete paired process.
    xResetRequired := TRUE;
    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF NOT xAutoModeValid THEN

    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF rtStop.Q THEN

    // Stop completes the current pair before disabling production.
    IF xSafeToStop THEN
        xRunLatched := FALSE;
        xStopPending := FALSE;
    ELSE
        xStopPending := TRUE;
    END_IF;

ELSIF xStopPending AND xSafeToStop THEN

    // The completed pair has cleared the coordinated process.
    xRunLatched := FALSE;
    xStopPending := FALSE;

ELSIF rtStart.Q
AND xFactoryIORunning
AND NOT xFactoryIOPaused
AND NOT xResetRequired
AND NOT xStopPending THEN

    xRunLatched := TRUE;
    xStopPending := FALSE;

END_IF;

// =============================================================
// FINAL AUTOMATIC-SEQUENCE PERMISSION
// =============================================================

xEnablePlant :=
    xRunLatched
    AND xAutoModeValid
    AND xFactoryIORunning
    AND NOT xEmergencyStop
    AND NOT xFactoryIOPaused
    AND NOT xPlantFaulted
    AND NOT xResetRequired;</Single>
            <Single Name="LineInfoPersistence" Type="string">b0a6cb4e-084c-4586-947a-abdf837bc6e1_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_OperatorControl
VAR_INPUT
    xAutoModeSelected   : BOOL;
    xEmergencyStop      : BOOL;
    xFactoryIOPaused    : BOOL;
    xFactoryIORunning   : BOOL;
    xManualModeSelected : BOOL;
    xPlantFaulted       : BOOL;
    xResetPB            : BOOL;
    xSafeToStop         : BOOL;
    xStartPB            : BOOL;
    xStopPB             : BOOL;
END_VAR

VAR_OUTPUT
    xEnablePlant   : BOOL;
    xResetPulse    : BOOL;
    xResetRequired : BOOL := TRUE;
    xRunLatched    : BOOL;
    xStopPending   : BOOL;
END_VAR

VAR
    fbResetPulse  : TP;
    rtReset       : R_TRIG;
    rtStart       : R_TRIG;
    rtStop        : R_TRIG;
    xAutoModeValid : BOOL;
END_VAR</Single>
