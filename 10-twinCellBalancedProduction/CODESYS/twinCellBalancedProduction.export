    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">ee2843b1-6055-4b7c-9c07-1cf7568486a9</Single>
        <Single Name="ParentGuid" Type="System.Guid">24a34fed-a682-4674-b097-383cfa9e689f</Single>
        <Single Name="Name" Type="string">FB_MachiningCell</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639220398901826451</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// STATE TIMER EXECUTION
// Timers are called every scan and enabled only in their state.
// =============================================================

fbFeedTimeout(
    IN :=
        xEnable
        AND (eState = E_MachiningCellState.FeedingRaw)
        AND NOT xAtEntry,
    PT := tFeedTimeout
);

fbPickupTimeout(
    IN :=
        xEnable
        AND (eState = E_MachiningCellState.WaitingForPickup)
        AND NOT xBusy,
    PT := tPickupTimeout
);

fbProcessTimeout(
    IN :=
        xEnable
        AND (eState = E_MachiningCellState.Processing)
        AND NOT xAtExit,
    PT := tProcessTimeout
);

fbExitClearTimeout(
    IN :=
        xEnable
        AND (eState = E_MachiningCellState.Complete)
        AND xAtExit,
    PT := tExitClearTimeout
);


// =============================================================
// DEFAULT OUTPUTS
// Every output receives a known value at the start of each scan.
// =============================================================

xReady := FALSE;
xDone := FALSE;
xRawConveyorCmd := FALSE;

xProduceLidsCmd := xProduceLids;

xStartCmd := FALSE;

xStopCmd :=
    (NOT xEnable OR xFaulted)
    AND NOT xReset;

xResetCmd := xReset;


// =============================================================
// RESET AND FAULT PRIORITIES
// =============================================================

// Reset clears the internal sequence and completed-product count.
IF xReset THEN
    xFaulted := FALSE;
    uiFaultCode := 0;
    diCount := 0;

    eState := E_MachiningCellState.Stopped;


// Factory I/O raises this for an incorrect item or station error.
ELSIF xHasError THEN
    xFaulted := TRUE;
    uiFaultCode := 1;

    eState := E_MachiningCellState.Faulted;


// A latched fault remains until Reset.
ELSIF xFaulted THEN
    eState := E_MachiningCellState.Faulted;


// Freeze the active sequence whenever the plant is disabled.
ELSIF xEnable THEN

    CASE eState OF

        // -----------------------------------------------------
        // Await the first plant enable after Reset.
        // -----------------------------------------------------
        E_MachiningCellState.Stopped:

            eState := E_MachiningCellState.Ready;


        // -----------------------------------------------------
        // Ready to accept one request from the coordinator.
        // Do not accept a new part while the exit is occupied.
        // -----------------------------------------------------
        E_MachiningCellState.Ready:

            xReady := NOT xAtExit;

            IF xRequest AND xReady THEN
                eState := E_MachiningCellState.FeedingRaw;
            END_IF;


        // -----------------------------------------------------
        // Move one staged raw item towards the entry bay.
        // -----------------------------------------------------
        E_MachiningCellState.FeedingRaw:

            xRawConveyorCmd := TRUE;

            IF xAtEntry THEN
                eState :=
                    E_MachiningCellState.WaitingForPickup;

            ELSIF fbFeedTimeout.Q THEN
                xFaulted := TRUE;
                uiFaultCode := 101; // No material at entry.

                eState := E_MachiningCellState.Faulted;
            END_IF;


        // -----------------------------------------------------
        // Wait for the robot to collect the detected material.
        //
        // Busy or the falling entry signal confirms pickup.
        // -----------------------------------------------------
       E_MachiningCellState.WaitingForPickup:

			// Continue carrying the blank beyond the external sensor
			// and into the machining centre's true pickup bay.
			xRawConveyorCmd := TRUE;
			xStartCmd := TRUE;
		
			IF xBusy THEN
				eState := E_MachiningCellState.Processing;
		
			ELSIF fbPickupTimeout.Q THEN
				xFaulted := TRUE;
				uiFaultCode := 102;
		
				eState := E_MachiningCellState.Faulted;
			END_IF;


        // -----------------------------------------------------
        // Wait until the finished product reaches the exit.
        // The state transition itself provides one-shot counting.
        // -----------------------------------------------------
        E_MachiningCellState.Processing:

            IF xAtExit THEN
                diCount := diCount + 1;

                eState := E_MachiningCellState.Complete;

            ELSIF fbProcessTimeout.Q THEN
                xFaulted := TRUE;
                uiFaultCode := 103; // Product never reached exit.

                eState := E_MachiningCellState.Faulted;
            END_IF;


        // -----------------------------------------------------
        // Hold Done until the coordinator removes Request.
        // This handshake cannot be missed between PLC scans.
        // -----------------------------------------------------
        E_MachiningCellState.Complete:

            xDone := TRUE;

            IF fbExitClearTimeout.Q THEN
                xFaulted := TRUE;
                uiFaultCode := 104; // Exit remained obstructed.

                eState := E_MachiningCellState.Faulted;

            ELSIF NOT xRequest AND NOT xAtExit THEN
                eState := E_MachiningCellState.Ready;
            END_IF;


        // -----------------------------------------------------
        // Latched safe state.
        // -----------------------------------------------------
        E_MachiningCellState.Faulted:

            xFaulted := TRUE;


    // Corrupted or unexpected enum value.
    ELSE
        xFaulted := TRUE;
        uiFaultCode := 999;

        eState := E_MachiningCellState.Faulted;
    END_CASE;

END_IF;


// =============================================================
// FINAL OUTPUT INTERLOCK
// No state can bypass this safety layer.
// =============================================================

IF NOT xEnable OR xFaulted THEN
    xRawConveyorCmd := FALSE;
    xStartCmd := FALSE;
    xStopCmd := NOT xReset;
END_IF;


// Reset must not compete with Start or Stop.
IF xReset THEN
    xStartCmd := FALSE;
    xStopCmd := FALSE;
    xResetCmd := TRUE;
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">ee2843b1-6055-4b7c-9c07-1cf7568486a9_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_MachiningCell
VAR_INPUT
    // Plant control
    xEnable      : BOOL;
    xReset       : BOOL;
    xRequest     : BOOL;
    xProduceLids : BOOL;

    // Factory I/O feedback
    xAtEntry   : BOOL;
    xAtExit    : BOOL;
    xBusy      : BOOL;
    xHasError  : BOOL;
    xOpened    : BOOL;
    diProgress : DINT;

    // Initial commissioning limits
    tFeedTimeout      : TIME := T#15S;
    tPickupTimeout    : TIME := T#15S;
    tProcessTimeout   : TIME := T#30S;
    tExitClearTimeout : TIME := T#10S;
END_VAR

VAR_OUTPUT
    // Handshake and diagnostics
    xReady      : BOOL;
    xDone       : BOOL;
    xFaulted    : BOOL;
    uiFaultCode : UINT;
    diCount     : DINT;

    eState : E_MachiningCellState :=
        E_MachiningCellState.Stopped;

    // Commands to Factory I/O
    xRawConveyorCmd : BOOL;
    xProduceLidsCmd : BOOL;
    xStartCmd       : BOOL;
    xStopCmd        : BOOL;
    xResetCmd       : BOOL;
END_VAR

VAR
    fbFeedTimeout      : TON;
    fbPickupTimeout    : TON;
    fbProcessTimeout   : TON;
    fbExitClearTimeout : TON;
END_VAR
</Single>
