      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">24a34fed-a682-4674-b097-383cfa9e689f</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">2a483e2b-25c3-4549-8be8-0c26b02f38a0</Single>
        <Single Name="ParentGuid" Type="System.Guid">24a34fed-a682-4674-b097-383cfa9e689f</Single>
        <Single Name="Name" Type="string">FB_ThroughputCounter</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639220473587329330</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Count only the rising edge of a detection.
// A part remaining over the sensor therefore counts once.
fbDetectedEdge(CLK := xDetected);

IF xReset THEN
    diTotalCount := 0;

ELSIF fbDetectedEdge.Q THEN
    diTotalCount := diTotalCount + 1;
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">2a483e2b-25c3-4549-8be8-0c26b02f38a0_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_ThroughputCounter

VAR_INPUT
    xDetected : BOOL;
    xReset    : BOOL;
END_VAR

VAR_OUTPUT
    diTotalCount : DINT;
END_VAR

VAR
    fbDetectedEdge : R_TRIG;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">2a483e2b-25c3-4549-8be8-0c26b02f38a0_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">31</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">24a34fed-a682-4674-b097-383cfa9e689f</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">020001ae-2301-4740-a275-adc4ae527fc9</Single>
        <Single Name="ParentGuid" Type="System.Guid">24a34fed-a682-4674-b097-383cfa9e689f</Single>
        <Single Name="Name" Type="string">PLC_PRG</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639221386099926003</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// =============================================================
// 1. PLANT FAULT STATUS FROM THE PREVIOUS PLC SCAN
// =============================================================

xPlantFaulted :=
    xBasesFaulted
    OR xCoordinatorFaulted
    OR xLidsFaulted;

// Preserve the pre-reset recovery requirement for the complete
// 500 ms reset pulse.
IF NOT xResetPulse THEN
    xRecoveryResetRequired :=
        xResetRequired;
END_IF;

// =============================================================
// 2. TWIN CELL OPERATOR CONTROL
// =============================================================
// The final counter sensor is positioned immediately before
// removal. Wait until both expected parts have passed it,
// the sensor has cleared, and the outfeed has run for another
// two seconds before completing a controlled stop.

fbStopOutfeedClearance(
    IN :=
        xStopPending
        AND (eCoordinatorState = E_PairCoordinatorState.Ready)
        AND (diTotalPartsCount &gt;= (diPairsCompleted * DINT#2))
        AND FIO.xTotalPartsAtRemoval,
    PT :=
        T#2S
);

fbOperator(
    xAutoModeSelected :=
        FIO.xTwinCellAutoModeSelected,

    xEmergencyStop :=
        NOT FIO.xTwinCellEmergencyStop,

    xFactoryIOPaused :=
        FIO.xFactoryIOPaused,

    xFactoryIORunning :=
        FIO.xFactoryIORunning,

    xManualModeSelected :=
        FIO.xTwinCellManualModeSelected,

    xPlantFaulted :=
        xPlantFaulted,

    xResetPB :=
        Commands.xResetPB
        OR FIO.xFactoryIOReset
        OR FIO.xTwinCellResetPB,

    xSafeToStop :=
    	fbStopOutfeedClearance.Q,

    xStartPB :=
        Commands.xStartPB
        OR FIO.xTwinCellStartPB,

    xStopPB :=
        Commands.xStopPB
        OR NOT FIO.xTwinCellStopPB,

    xEnablePlant =&gt;
        xEnablePlant,

    xResetPulse =&gt;
        xResetPulse,

    xResetRequired =&gt;
        xResetRequired,

    xRunLatched =&gt;
        xRunLatched,

    xStopPending =&gt;
        xStopPending
);

// =============================================================
// 3. PAIRED-PRODUCTION COORDINATOR
// =============================================================

fbCoordinator(
    xEnable :=
        xEnablePlant,

    xReset :=
        xResetPulse,

    xAnyFault :=
        xLidsFaulted
        OR xBasesFaulted,

    xLidsReady :=
        xLidsReady,

    xBasesReady :=
        xBasesReady,

    xLidsDone :=
        xLidsDone,

    xBasesDone :=
        xBasesDone,

    tMergeClearance :=
        T#2S,
		
	xAllowNewPair :=
    	NOT xStopPending,

    xLidsRequest =&gt;
        xLidsRequest,

    xBasesRequest =&gt;
        xBasesRequest,

    xFaulted =&gt;
        xCoordinatorFaulted,

    diPairsCompleted =&gt;
        diPairsCompleted,

    eState =&gt;
        eCoordinatorState
);


// =============================================================
// 4. LID MACHINING CELL
// =============================================================

fbLidsCell(
    xEnable :=
        xEnablePlant,

    xReset :=
        xResetPulse,

    xRequest :=
        xLidsRequest,

    xProduceLids :=
        TRUE,

    xAtEntry := NOT FIO.xLidsAtEntry,

    xAtExit := NOT FIO.xLidsAtExit,

    xBusy :=
        FIO.xLidsCenterBusy,

    xHasError :=
        FIO.xLidsCenterHasError,

    xOpened :=
        FIO.xLidsCenterOpened,

    diProgress :=
        FIO.diLidsCenterProgress,

    tFeedTimeout :=
        T#15S,

    tPickupTimeout :=
        T#15S,

    tProcessTimeout :=
        T#90S,

    tExitClearTimeout :=
        T#10S,

    xReady =&gt;
        xLidsReady,

    xDone =&gt;
        xLidsDone,

    xFaulted =&gt;
        xLidsFaulted,

    uiFaultCode =&gt;
        uiLidsFaultCode,

    diCount =&gt;
        diLidsCount,

    eState =&gt;
        eLidsState,

    xRawConveyorCmd =&gt;
        xLidsRawConveyorCmd,

    xProduceLidsCmd =&gt;
        xLidsProduceLidsCmd,

    xStartCmd =&gt;
        xLidsStartCmd,

    xStopCmd =&gt;
        xLidsStopCmd,

    xResetCmd =&gt;
        xLidsResetCmd
);


// =============================================================
// 5. BASE MACHINING CELL
// Same FB, but its product-selection input is FALSE.
// =============================================================

fbBasesCell(
    xEnable :=
        xEnablePlant,

    xReset :=
        xResetPulse,

    xRequest :=
        xBasesRequest,

    xProduceLids :=
        FALSE,

    xAtEntry := NOT FIO.xBasesAtEntry,

    xAtExit := NOT FIO.xBasesAtExit,

    xBusy :=
        FIO.xBasesCenterBusy,

    xHasError :=
        FIO.xBasesCenterHasError,

    xOpened :=
        FIO.xBasesCenterOpened,

    diProgress :=
        FIO.diBasesCenterProgress,

    tFeedTimeout :=
        T#15S,

    tPickupTimeout :=
        T#15S,

    tProcessTimeout :=
        T#90S,

    tExitClearTimeout :=
        T#10S,

    xReady =&gt;
        xBasesReady,

    xDone =&gt;
        xBasesDone,

    xFaulted =&gt;
        xBasesFaulted,

    uiFaultCode =&gt;
        uiBasesFaultCode,

    diCount =&gt;
        diBasesCount,

    eState =&gt;
        eBasesState,

    xRawConveyorCmd =&gt;
        xBasesRawConveyorCmd,

    xProduceLidsCmd =&gt;
        xBasesProduceLidsCmd,

    xStartCmd =&gt;
        xBasesStartCmd,

    xStopCmd =&gt;
        xBasesStopCmd,

    xResetCmd =&gt;
        xBasesResetCmd
);

// =============================================================
// 6. FINAL THROUGHPUT COUNTER
//
// Retroreflective sensors are TRUE while the beam is clear.
// Invert the raw signal so xDetected becomes TRUE when a part
// interrupts the beam.
// =============================================================

fbThroughputCounter(
    xDetected :=
        NOT FIO.xTotalPartsAtRemoval,

    xReset :=
        xResetPulse,

    diTotalCount =&gt;
        diTotalPartsCount
);


// Refresh the aggregate after this scan's equipment execution.
xPlantFaulted :=
    xLidsFaulted
    OR xBasesFaulted
    OR xCoordinatorFaulted;
	
// =============================================================
// 7. FACTORY I/O OUTPUT BOUNDARY
// Internal equipment commands are mapped to external OPC tags here.
// =============================================================


// -------------------------------------------------------------
// Lid machining centre
// -------------------------------------------------------------

FIO.xLidsCenterProduceLidsCmd :=
    xLidsProduceLidsCmd;

FIO.xLidsCenterStartCmd :=
    xLidsStartCmd;

FIO.xLidsCenterStopCmd :=
    xLidsStopCmd;

FIO.xLidsCenterResetCmd :=
    xLidsResetCmd;

FIO.xLidsRawConveyorCmd :=
    xLidsRawConveyorCmd;


// -------------------------------------------------------------
// Base machining centre
// -------------------------------------------------------------

FIO.xBasesCenterProduceLidsCmd :=
    xBasesProduceLidsCmd;

FIO.xBasesCenterStartCmd :=
    xBasesStartCmd;

FIO.xBasesCenterStopCmd :=
    xBasesStopCmd;

FIO.xBasesCenterResetCmd :=
    xBasesResetCmd;

FIO.xBasesRawConveyorCmd :=
    xBasesRawConveyorCmd;


// -------------------------------------------------------------
// Outfeed conveyors
//
// These run continuously while the plant is enabled. Pair
// coordination supplies the collision prevention at the merge.
// -------------------------------------------------------------

FIO.xLidsExitConveyor1Cmd :=
    xEnablePlant;

FIO.xLidsExitConveyor2Cmd :=
    xEnablePlant;

FIO.xBasesExitConveyor1Cmd :=
    xEnablePlant;

FIO.xBasesExitConveyor2Cmd :=
    xEnablePlant;

FIO.xExitConveyorCmd :=
    xEnablePlant;


// -------------------------------------------------------------
// Emitters and remover
//
// These are currently forced ON inside the supplied Factory I/O
// scene. The mappings are still complete for a later unforced V2.
// -------------------------------------------------------------

FIO.xLidsEmitterCmd :=
    xEnablePlant;

FIO.xBasesEmitterCmd :=
    xEnablePlant;

FIO.xRemoverCmd :=
    xEnablePlant;


// -------------------------------------------------------------
// Scene-mounted integer displays
// -------------------------------------------------------------

FIO.diLidsCounterDisplay :=
    diLidsCount;

FIO.diBasesCounterDisplay :=
    diBasesCount;
	
FIO.diTwinCellBasesCounterDisplay :=
    diBasesCount;

FIO.diTwinCellLidsCounterDisplay :=
    diLidsCount;
	
FIO.diTotalPartsCounterDisplay :=
    diTotalPartsCount;


// -------------------------------------------------------------
// Factory I/O simulation control
//
// Plant Reset resets PLC sequence and physical scene together.
// Run/Pause/Camera remain manually controlled for V1.
// -------------------------------------------------------------

FIO.xFactoryIOResetCmd :=
    xResetPulse
	AND xRecoveryResetRequired;

FIO.xFactoryIORunCmd :=
    FALSE;

FIO.xFactoryIOPauseCmd :=
    FALSE;

FIO.diFactoryIOCameraPositionCmd :=
    0;
	
	
FIO.xTwinCellResetLightCmd :=
    xResetRequired
    OR xPlantFaulted;

FIO.xTwinCellStartLightCmd :=
    xEnablePlant
    AND NOT xStopPending;

FIO.xTwinCellStopLightCmd :=
    NOT xRunLatched
    OR xStopPending;</Single>
            <Single Name="LineInfoPersistence" Type="string">020001ae-2301-4740-a275-adc4ae527fc9_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PLC_PRG
VAR
    // Function-block instances
    fbOperator    : FB_OperatorControl;
    fbCoordinator : FB_PairCoordinator;
    fbLidsCell    : FB_MachiningCell;
    fbBasesCell   : FB_MachiningCell;
	fbStopOutfeedClearance : TON;
	fbThroughputCounter : FB_ThroughputCounter;


    // Plant-level control
    xEnablePlant              : BOOL;
	xPlantFaulted             : BOOL;
	xRecoveryResetRequired    : BOOL;
	xResetPulse               : BOOL;
	xResetRequired            : BOOL;
	xRunLatched               : BOOL;
	xStopPending              : BOOL;


    // Coordinator handshakes
    xLidsRequest  : BOOL;
    xBasesRequest : BOOL;

    xLidsReady  : BOOL;
    xBasesReady : BOOL;

    xLidsDone  : BOOL;
    xBasesDone : BOOL;


    // Fault aggregation
    xLidsFaulted       : BOOL;
    xBasesFaulted      : BOOL;
    xCoordinatorFaulted : BOOL;

    uiLidsFaultCode  : UINT;
    uiBasesFaultCode : UINT;


    // Machining-centre commands
    xLidsProduceLidsCmd  : BOOL;
    xLidsStartCmd        : BOOL;
    xLidsStopCmd         : BOOL;
    xLidsResetCmd        : BOOL;
    xLidsRawConveyorCmd  : BOOL;

    xBasesProduceLidsCmd : BOOL;
    xBasesStartCmd       : BOOL;
    xBasesStopCmd        : BOOL;
    xBasesResetCmd       : BOOL;
    xBasesRawConveyorCmd : BOOL;


    // Production totals
    diLidsCount      : DINT;
    diBasesCount     : DINT;
    diPairsCompleted : DINT;
	diTotalPartsCount : DINT;


    // Online state diagnostics
    eLidsState :
        E_MachiningCellState;

    eBasesState :
        E_MachiningCellState;

    eCoordinatorState :
        E_PairCoordinatorState;
END_VAR</Single>
